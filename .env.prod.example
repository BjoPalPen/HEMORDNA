# Produktions-.env för docker-compose.prod.yml. Kopiera till .env på servern, fyll i
# riktiga värden, och committa ALDRIG den ifyllda filen (se .gitignore).

POSTGRES_DB=hemordna
POSTGRES_USER=hemordna
POSTGRES_PASSWORD=

# Minst 32 bytes (HMAC-SHA256), se JwtOptions.MinimumSigningKeyBytes. Generera t.ex. med:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Resend (api.resend.com) skickar "glömt lösenord"-mejl. Krävs i produktion.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@hemordna.se

# Betrott bowling-edge-nät. Kontrollera med docker network inspect bowling-edge.
REVERSE_PROXY_NETWORK=172.19.0.0/16

# VAPID-nyckelpar för Web Push (RFC 8292). Generera ETT nyckelpar och återanvänd det -
# genereras inte om vid varje deploy, annars slutar alla befintliga prenumerationer fungera.
# Den privata nyckeln är en hemlighet på samma nivå som JWT_SIGNING_KEY. Subject är en
# mailto:-adress som pushtjänsten kan kontakta vid missbruk, t.ex. mailto:kontakt@hemordna.se.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
