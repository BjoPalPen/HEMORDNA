# Produktions-.env för docker-compose.prod.yml. Kopiera till .env på servern, fyll i
# riktiga värden, och committa ALDRIG den ifyllda filen (se .gitignore).

POSTGRES_DB=hemordna
POSTGRES_USER=hemordna
POSTGRES_PASSWORD=

# Minst 32 bytes (HMAC-SHA256), se JwtOptions.MinimumSigningKeyBytes. Generera t.ex. med:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Resend (api.resend.com) skickar "glömt lösenord"-mejl. Kan lämnas tomt - mejlet loggas då
# bara till serverloggen i stället för att skickas (se LoggingEmailSender), vilket duger tills
# domänen är verifierad hos Resend.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@hemordna.se
