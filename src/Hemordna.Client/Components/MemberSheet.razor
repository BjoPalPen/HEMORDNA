@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject TimeProvider TimeProvider

<BottomSheet Title="@Member.DisplayName" IsOpen="IsOpen" IsOpenChanged="OnIsOpenChanged" Detent="SheetDetent.Half">
    @if (Session.CanManageHousehold)
    {
        <div class="field">
            <span>Vilken roll har personen i hushållet?</span>
            <div class="level-picker">
                @foreach (var preset in HouseholdRolePresets.All)
                {
                    <button type="button"
                            class="@(Member.Role == preset.Role.ToString() ? "btn btn-primary" : "btn btn-secondary")"
                            disabled="@_roleBusy"
                            @onclick="() => SetRoleAsync(preset.Role)">
                        @preset.Label
                    </button>
                }
            </div>
        </div>

        <details class="more-options">
            <summary>Anpassad tid i stället</summary>
            <div class="level-picker">
                @foreach (var level in TimeLevel.All)
                {
                    <button type="button" class="btn btn-secondary" disabled="@_roleBusy"
                            @onclick="() => SetCustomMinutesAsync(level.Minutes)">
                        <span>@level.Label</span>
                        @if (level.Minutes > 0)
                        {
                            <span class="muted small">@TimeLevel.MinutesLabel(level.Minutes)</span>
                        }
                    </button>
                }
            </div>
        </details>

        <details class="more-options">
            <summary>Anpassa tid per veckodag</summary>
            <p class="muted small">
                Sätt ett eget antal minuter för varje dag - till exempel mer tid på helgen, eller en
                ledig dag i veckan. Skriver över både rollval och "Anpassad tid" ovan.
            </p>

            @if (_weekdayForm is { } weekdayForm)
            {
                <label class="field">
                    <span>Måndag</span>
                    <input type="number" min="0" max="600" @bind="weekdayForm.Monday" />
                </label>
                <label class="field">
                    <span>Tisdag</span>
                    <input type="number" min="0" max="600" @bind="weekdayForm.Tuesday" />
                </label>
                <label class="field">
                    <span>Onsdag</span>
                    <input type="number" min="0" max="600" @bind="weekdayForm.Wednesday" />
                </label>
                <label class="field">
                    <span>Torsdag</span>
                    <input type="number" min="0" max="600" @bind="weekdayForm.Thursday" />
                </label>
                <label class="field">
                    <span>Fredag</span>
                    <input type="number" min="0" max="600" @bind="weekdayForm.Friday" />
                </label>
                <label class="field">
                    <span>Lördag</span>
                    <input type="number" min="0" max="600" @bind="weekdayForm.Saturday" />
                </label>
                <label class="field">
                    <span>Söndag</span>
                    <input type="number" min="0" max="600" @bind="weekdayForm.Sunday" />
                </label>
            }

            @if (_weekdayMessage is { } weekdayMessage)
            {
                <div class="notice notice-problem" role="alert">@weekdayMessage</div>
            }

            <button type="button" class="btn btn-secondary btn-block" disabled="@_weekdayBusy" @onclick="SaveWeekdayBudgetAsync">
                @(_weekdayBusy ? "Sparar..." : "Spara")
            </button>
        </details>

        @if (_roleMessage is { } roleMessage)
        {
            <div class="notice notice-problem" role="alert">@roleMessage</div>
        }

        @if (Member.HasAccount)
        {
            <label class="field-check">
                <input type="checkbox" checked="@Member.CanManageHousehold" disabled="@_canManageBusy"
                       @onchange="ToggleCanManageHouseholdAsync" />
                <span>Kan ändra rum, uppgifter och medlemmar</span>
            </label>

            @if (_canManageMessage is { } canManageMessage)
            {
                <div class="notice notice-problem" role="alert">@canManageMessage</div>
            }
        }

        <hr class="member-sheet-divider" />
    }

    @if (CanPauseThisMember)
    {
        <label class="field">
            <span>Pausa till och med</span>
            <input type="date" @bind="_pauseUntilInput" />
        </label>

        @if (Member.PausedUntil is { } pausedUntil)
        {
            <div class="notice" role="status">Pausad till och med @pausedUntil.ToString("d MMMM", SwedishCulture).</div>
        }

        @if (_pauseMessage is { } pauseMessage)
        {
            <div class="notice notice-problem" role="alert">@pauseMessage</div>
        }

        <button type="button" class="btn btn-secondary btn-block" disabled="@_pauseBusy" @onclick="SavePauseAsync">
            @(_pauseBusy ? "Sparar..." : "Pausa")
        </button>
        @if (Member.PausedUntil is not null)
        {
            <button type="button" class="btn btn-secondary btn-block" disabled="@_pauseBusy" @onclick="ResumeAsync">
                Återuppta nu
            </button>
        }
    }

    @if (Session.CanManageHousehold)
    {
        <hr class="member-sheet-divider" />

        @if (_removeMessage is { } removeMessage)
        {
            <div class="notice notice-problem" role="alert">@removeMessage</div>
        }

        <button type="button" class="btn btn-danger btn-block" disabled="@_removeBusy" @onclick="RemoveAsync">
            Ta bort medlem
        </button>
    }
</BottomSheet>

@code {
    [Parameter, EditorRequired]
    public Guid HouseholdId { get; set; }

    [Parameter, EditorRequired]
    public HouseholdMemberResponse Member { get; set; } = null!;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Raised after any successful change, so the parent (Hushall.razor) reloads.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnChanged { get; set; }

    private bool _roleBusy;
    private string? _roleMessage;

    /// <summary>A plain, mutable holder for the seven number inputs - WeeklyTimeBudgetContract
    /// itself is an immutable record, and each weekday needs its own two-way binding target.</summary>
    private sealed class WeekdayMinutesForm
    {
        public int Monday { get; set; }
        public int Tuesday { get; set; }
        public int Wednesday { get; set; }
        public int Thursday { get; set; }
        public int Friday { get; set; }
        public int Saturday { get; set; }
        public int Sunday { get; set; }
    }

    private WeekdayMinutesForm? _weekdayForm;
    private bool _weekdayBusy;
    private string? _weekdayMessage;

    private DateOnly? _pauseUntilInput;
    private bool _pauseBusy;
    private string? _pauseMessage;

    private bool _removeBusy;
    private string? _removeMessage;

    private bool _canManageBusy;
    private string? _canManageMessage;

    private static readonly System.Globalization.CultureInfo SwedishCulture = new("sv-SE");

    /// <summary>Your own, always - anyone else's only with the flag. Mirrors the server's own
    /// MemberSelfOrManageFilter, so the UI never offers a button the API would answer 403 to.</summary>
    private bool CanPauseThisMember
        => Member.Id == Session.Me?.MemberId || Session.CanManageHousehold;

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _roleMessage = null;
            _weekdayMessage = null;
            _pauseMessage = null;
            _removeMessage = null;
            _canManageMessage = null;
            return;
        }

        _pauseUntilInput ??= Member.PausedUntil ?? Today.AddDays(7);
        _weekdayForm ??= new WeekdayMinutesForm
        {
            Monday = Member.WeeklyTimeBudgetMinutes.Monday,
            Tuesday = Member.WeeklyTimeBudgetMinutes.Tuesday,
            Wednesday = Member.WeeklyTimeBudgetMinutes.Wednesday,
            Thursday = Member.WeeklyTimeBudgetMinutes.Thursday,
            Friday = Member.WeeklyTimeBudgetMinutes.Friday,
            Saturday = Member.WeeklyTimeBudgetMinutes.Saturday,
            Sunday = Member.WeeklyTimeBudgetMinutes.Sunday
        };
    }

    private async Task OnIsOpenChanged(bool isOpen)
    {
        IsOpen = isOpen;

        if (!isOpen)
        {
            _pauseUntilInput = null;
            _weekdayForm = null;
        }

        await IsOpenChanged.InvokeAsync(isOpen);
    }

    private async Task SetRoleAsync(HouseholdRole role)
    {
        _roleBusy = true;
        _roleMessage = null;

        try
        {
            // Both calls describe the same pick from the UI's point of view - the role itself,
            // and the budget the preset implies for it (still freely editable afterwards) - and
            // neither depends on the other, so they run concurrently rather than doubling the
            // round trip.
            var roleTask = Api.SetMemberRoleAsync(HouseholdId, Member.Id, role.ToString());
            var budgetTask = Api.SetWeeklyBudgetAsync(HouseholdId, Member.Id, HouseholdRolePresets.BudgetFor(role));
            await Task.WhenAll(roleTask, budgetTask);

            if (await budgetTask)
            {
                await OnChanged.InvokeAsync();
            }
            else
            {
                _roleMessage = "Det gick inte att spara. Försök igen.";
            }
        }
        catch (HttpRequestException)
        {
            _roleMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _roleBusy = false;
        }
    }

    private async Task SetCustomMinutesAsync(int minutes)
    {
        _roleBusy = true;
        _roleMessage = null;

        try
        {
            var budget = new WeeklyTimeBudgetContract(minutes, minutes, minutes, minutes, minutes, minutes, minutes);

            if (!await Api.SetWeeklyBudgetAsync(HouseholdId, Member.Id, budget))
            {
                _roleMessage = "Det gick inte att spara. Försök igen.";
                return;
            }

            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _roleMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _roleBusy = false;
        }
    }

    private async Task SaveWeekdayBudgetAsync()
    {
        if (_weekdayForm is not { } form)
        {
            return;
        }


        _weekdayBusy = true;
        _weekdayMessage = null;

        try
        {
            // Negative values are only reachable by typing past the field's own min="0" -
            // clamped here rather than sent on and left to fail the round trip on a mistake
            // that is trivial to just correct.
            var budget = new WeeklyTimeBudgetContract(
                Math.Max(0, form.Monday), Math.Max(0, form.Tuesday), Math.Max(0, form.Wednesday),
                Math.Max(0, form.Thursday), Math.Max(0, form.Friday), Math.Max(0, form.Saturday),
                Math.Max(0, form.Sunday));

            if (!await Api.SetWeeklyBudgetAsync(HouseholdId, Member.Id, budget))
            {
                _weekdayMessage = "Det gick inte att spara. Försök igen.";
                return;
            }

            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _weekdayMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _weekdayBusy = false;
        }
    }

    private async Task SavePauseAsync()
    {
        if (_pauseUntilInput is not { } until)
        {
            _pauseMessage = "Ange ett slutdatum för pausen.";
            return;
        }

        _pauseBusy = true;
        _pauseMessage = null;

        try
        {
            if (!await Api.PauseHouseholdMemberAsync(HouseholdId, Member.Id, until))
            {
                _pauseMessage = "Det gick inte att spara. Försök igen.";
                return;
            }

            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _pauseMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _pauseBusy = false;
        }
    }

    private async Task ResumeAsync()
    {
        _pauseBusy = true;
        _pauseMessage = null;

        try
        {
            await Api.PauseHouseholdMemberAsync(HouseholdId, Member.Id, until: null);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _pauseBusy = false;
        }
    }

    private async Task RemoveAsync()
    {
        _removeBusy = true;
        _removeMessage = null;

        try
        {
            await Api.DeactivateMemberAsync(HouseholdId, Member.Id);
            await OnIsOpenChanged(false);
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _removeMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _removeBusy = false;
        }
    }

    private async Task ToggleCanManageHouseholdAsync(ChangeEventArgs e)
    {
        var canManage = (bool)e.Value!;
        _canManageBusy = true;
        _canManageMessage = null;

        try
        {
            if (!await Api.SetMemberCanManageHouseholdAsync(HouseholdId, Member.Id, canManage))
            {
                // Most likely the "never leave the household with zero" invariant - see
                // docs/ARCHITECTURE.md "Beslut: Vem får ändra vad" - rejecting taking the
                // ability away from the last member who has it.
                _canManageMessage = "Det gick inte att spara. Hushållet måste ha minst en medlem som kan ändra det.";
                return;
            }

            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _canManageMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _canManageBusy = false;
        }
    }
}
