@* A sheet that rises from the bottom on mobile and renders as a centered dialog on desktop.
   Used by every form and choice menu from step 3 onward - see docs/DESIGN.md. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="sheet-scrim" @onclick="CloseAsync"></div>
    <div class="sheet-shell" role="dialog" aria-modal="true" aria-label="@Title" @ref="_shellRef" @onkeydown="OnKeyDownAsync">
        <div class="sheet-handle" aria-hidden="true"></div>
        <div class="sheet-header">
            <h2>@Title</h2>
            <button type="button" class="sheet-close" @onclick="CloseAsync">Stäng</button>
        </div>
        <div class="sheet-body">
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private ElementReference _shellRef;
    private bool _wasOpen;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/bottom-sheet.js");
            await _module.InvokeVoidAsync("focusIn", _shellRef);
        }

        _wasOpen = IsOpen;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;

        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(false);
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("focusBack");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone - nothing left to clean up client-side.
            }
        }
    }
}
