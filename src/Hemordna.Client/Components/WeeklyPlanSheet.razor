@inject HemordnaApiClient Api
@inject TimeProvider TimeProvider

<BottomSheet Title="Planera veckan" IsOpen="IsOpen" IsOpenChanged="OnIsOpenChanged" Detent="SheetDetent.Full">
    @if (_confirmed)
    {
        <div class="notice" role="status">
            Klart. Det gäller kommande veckor - det som redan ligger ute på någons dag är orört.
        </div>
        <button type="button" class="btn btn-primary btn-block" @onclick="CloseAsync">Stäng</button>
    }
    else if (_loading)
    {
        <p class="muted">Räknar ut ett förslag...</p>
    }
    else if (_plan is null)
    {
        <div class="notice notice-problem" role="alert">Det gick inte att hämta ett förslag. Försök igen.</div>
        <button type="button" class="btn btn-link" @onclick="CloseAsync">Stäng</button>
    }
    else
    {
        <p class="muted small">
            Ett förslag på hur veckans återkommande städning kan fördelas - efter hur mycket tid
            och ork hushållet har varje dag, inte bara turordning. Gäller framåt: det som redan
            ligger ute på någons dag rörs inte. Flytta ett besök till en annan dag om det passar
            bättre - det låser besöket dit, så nästa "Planera veckan" flyttar det inte tillbaka.
        </p>

        <ul class="list" aria-label="Förslag per veckodag">
            @foreach (var day in _plan.Days)
            {
                <li class="list-item">
                    <div class="weekly-plan-day">
                        <span class="list-name">@SwedishDayName(day.Day)</span>
                        @if (day.Visits.Count == 0)
                        {
                            <span class="muted small">Inga besök</span>
                        }
                        else
                        {
                            <ul class="weekly-plan-visits">
                                @foreach (var visit in day.Visits)
                                {
                                    <li class="weekly-plan-visit">
                                        <span class="muted small">
                                            @(visit.AreaName ?? "Övrigt") · @VisitKindLabel(visit.VisitKind) · @visit.Minutes min
                                            @if (visit.IsLocked)
                                            {
                                                <text> · alltid @SwedishDayName(day.Day).ToLowerInvariant()</text>
                                            }
                                        </span>
                                        <select
                                            aria-label="Flytta @(visit.AreaName ?? "Övrigt") · @VisitKindLabel(visit.VisitKind) till en annan dag"
                                            class="weekly-plan-move"
                                            disabled="@_movePending"
                                            value="@day.Day"
                                            @onchange="e => MoveAsync(visit.VisitKey, (string)e.Value!)">
                                            @foreach (var weekday in WeekdayOrder)
                                            {
                                                <option value="@weekday">@SwedishDayName(weekday)</option>
                                            }
                                        </select>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </li>
            }
        </ul>

        @foreach (var warningDay in _plan.EffortWarningDays)
        {
            <div class="notice" role="status">
                Ingen orkar tunga uppgifter på @SwedishDayName(warningDay).ToLowerInvariant().
            </div>
        }

        @if (_message is { } message)
        {
            <div class="notice notice-problem" role="alert">@message</div>
        }

        <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="ApplyAsync">
            @(_busy ? "Använder..." : "Använd")
        </button>
        <button type="button" class="btn btn-link" @onclick="CloseAsync">Avbryt</button>
    }
</BottomSheet>

@code {
    [Parameter, EditorRequired]
    public Guid HouseholdId { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Raised after "Använd" succeeds, so the parent (Rum.razor) reloads its task list.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnChanged { get; set; }

    private WeeklyPlanResponse? _plan;
    private bool _loading;
    private bool _movePending;
    private bool _busy;
    private bool _confirmed;
    private string? _message;

    /// <summary>The household member's own pending edits to the suggestion this open ("Planera
    /// veckan går att ändra") - visit key to chosen weekday. Recomputed server-side on every
    /// change (see MoveAsync); the client never re-derives a placement itself. Cleared whenever
    /// the sheet closes or a plan is applied.</summary>
    private readonly Dictionary<Guid, string> _moves = new();

    private static readonly Dictionary<string, string> DayLabels = new()
    {
        ["Monday"] = "Måndag",
        ["Tuesday"] = "Tisdag",
        ["Wednesday"] = "Onsdag",
        ["Thursday"] = "Torsdag",
        ["Friday"] = "Fredag",
        ["Saturday"] = "Lördag",
        ["Sunday"] = "Söndag"
    };

    /// <summary>Monday first, matching every other weekday picker in the app (MemberSheet,
    /// TaskOptionsSheet).</summary>
    private static readonly string[] WeekdayOrder =
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private static string SwedishDayName(string day) => DayLabels.GetValueOrDefault(day, day);

    private static string VisitKindLabel(string visitKind) => visitKind switch
    {
        "DeepClean" => "Storstäd",
        _ => "Städ"
    };

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            return;
        }

        if (_plan is null && !_loading && !_confirmed)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        // Only the very first load blanks the whole sheet - a move recomputes the same
        // suggestion in place (_movePending just disables the pickers while it does), so picking
        // a day for one visit doesn't make the rest of an already-visible list disappear.
        var isFirstLoad = _plan is null;
        _loading = isFirstLoad;
        _movePending = !isFirstLoad;
        _message = null;

        try
        {
            var result = await Api.GetWeeklyPlanAsync(HouseholdId, Today, ToMoveRequests());

            if (result is not null || isFirstLoad)
            {
                _plan = result;
            }
        }
        catch (HttpRequestException)
        {
            if (isFirstLoad)
            {
                _plan = null;
            }
        }
        finally
        {
            _loading = false;
            _movePending = false;
        }
    }

    /// <summary>"Flytta ett besök" (Björns krav) - the client stays thin: it only remembers WHICH
    /// day was picked and asks the server to recompute the whole suggestion around it, exactly
    /// like an existing "Alltid på" lock.</summary>
    private async Task MoveAsync(Guid visitKey, string weekday)
    {
        _moves[visitKey] = weekday;
        await LoadAsync();
    }

    private List<WeeklyPlanMoveRequest> ToMoveRequests()
        => [.. _moves.Select(move => new WeeklyPlanMoveRequest(move.Key, move.Value))];

    private async Task ApplyAsync()
    {
        _busy = true;
        _message = null;

        try
        {
            if (await Api.ApplyWeeklyPlanAsync(HouseholdId, Today, ToMoveRequests()) is null)
            {
                _message = "Det gick inte att spara. Försök igen.";
                return;
            }

            _confirmed = true;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseAsync()
    {
        _plan = null;
        _confirmed = false;
        _message = null;
        _moves.Clear();
        await OnIsOpenChanged(false);
    }

    private async Task OnIsOpenChanged(bool isOpen)
    {
        IsOpen = isOpen;

        if (!isOpen)
        {
            _plan = null;
            _confirmed = false;
            _message = null;
            _moves.Clear();
        }

        await IsOpenChanged.InvokeAsync(isOpen);
    }
}
