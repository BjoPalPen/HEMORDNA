@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject TimeProvider TimeProvider

@if (VisibleTasks.Count == 0)
{
    <p class="muted small">Inga uppgifter här ännu.</p>
}
else
{
    <ul class="list" aria-label="@($"Uppgifter i {Label}")">
        @foreach (var task in VisibleTasks)
        {
            <li class="list-item">
                <span class="list-name">
                    @task.Name
                    @if (task.Recurrence is { } recurrence)
                    {
                        <span class="muted small">@RecurrenceLabel(recurrence)</span>
                    }
                    @if (task.StaleAfterDays is not null)
                    {
                        <span class="muted small">vid behov</span>
                    }
                    @if (task.HasRotatingResponsibility)
                    {
                        <span class="muted small">roterar</span>
                    }
                    else if (task.DefaultResponsibleMemberId is { } ownerId)
                    {
                        <span class="muted small">@MemberNameFor(ownerId)</span>
                    }
                    @if (task.RequiresAdult)
                    {
                        <span class="muted small">endast vuxna</span>
                    }
                </span>
                <button type="button" class="btn btn-secondary" aria-label="@($"Ta bort {task.Name}")"
                        disabled="@(_removingTaskId == task.Id)"
                        @onclick="() => RemoveTaskAsync(task.Id)">
                    Ta bort
                </button>
            </li>
        }
    </ul>
}

@if (ShowSuggestions)
{
    <details class="more-options">
        <summary>Lägg till vanliga hushållssysslor</summary>
        <p class="muted small">Kryssa i det som stämmer för ert hushåll - inget är förvalt, eftersom det varierar mycket mellan hushåll.</p>

        @foreach (var task in GeneralTaskTemplates.All)
        {
            <label class="field-check">
                <input type="checkbox" @bind="_suggestedSelected[task.Name]" />
                <span>@task.Name</span>
            </label>
        }

        <div class="floor-submit">
            <button type="button" class="btn btn-primary" disabled="@_suggestionsBusy" @onclick="AddSuggestedTasksAsync">
                @(_suggestionsBusy ? "Lägger till..." : "Lägg till valda")
            </button>
        </div>
    </details>
}

<details class="more-options">
    <summary>Lägg till en uppgift i @Label</summary>

    <EditForm Model="_form" OnValidSubmit="AddTaskAsync">
        <label class="field">
            <span>Namn</span>
            <InputText @bind-Value="_form.Name" placeholder="T.ex. Dammsug" />
        </label>

        <div class="field">
            <span>Ungefär hur mycket tid tar det?</span>
            <div class="level-picker">
                @foreach (var level in TimeLevel.All)
                {
                    <button type="button"
                            class="@(_form.EstimatedMinutes == level.Minutes ? "btn btn-primary" : "btn btn-secondary")"
                            @onclick="() => _form.EstimatedMinutes = level.Minutes">
                        @level.Label
                    </button>
                }
            </div>
        </div>

        <label class="field">
            <span>Upprepning</span>
            <select @bind="_form.Recurrence">
                <option value="">Ingen - schemaläggs för hand</option>
                <option value="Daily">Varje dag</option>
                <option value="Weekly">Varje vecka</option>
                <option value="Monthly">Varje månad</option>
                <option value="AsNeeded">Vid behov</option>
            </select>
        </label>

        <label class="field-check">
            <input type="checkbox" @bind="_form.RequiresAdult" />
            <span>Bara vuxna ska tilldelas den här</span>
        </label>

        @if (_message is { } message)
        {
            <div class="notice notice-problem" role="alert">@message</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@_busy">
            @(_busy ? "Lägger till..." : "Lägg till uppgift")
        </button>
    </EditForm>
</details>

@code {
    /// <summary>Every task management surface lives here now - see Omraden.razor, one instance per room plus "Övrigt".</summary>
    [Parameter, EditorRequired]
    public Guid HouseholdId { get; set; }

    /// <summary>Null groups the tasks that belong to no particular room ("Övrigt").</summary>
    [Parameter]
    public Guid? AreaId { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<TaskDefinitionResponse> AllTasks { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<HouseholdMemberResponse> Members { get; set; } = [];

    /// <summary>Raised after adding or removing a task, so the parent can reload the shared list.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnChanged { get; set; }

    /// <summary>Whether to offer GeneralTaskTemplates' checklist - true only for "Övrigt" (no room to suggest tasks from instead).</summary>
    [Parameter]
    public bool ShowSuggestions { get; set; }

    private sealed class Form
    {
        public string Name { get; set; } = string.Empty;
        public int EstimatedMinutes { get; set; } = 30;
        public string Recurrence { get; set; } = string.Empty;
        public bool RequiresAdult { get; set; }
    }

    private readonly Form _form = new();
    private string? _message;
    private bool _busy;
    private Guid? _removingTaskId;

    private readonly Dictionary<string, bool> _suggestedSelected =
        GeneralTaskTemplates.All.ToDictionary(task => task.Name, _ => false);
    private bool _suggestionsBusy;

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    private List<TaskDefinitionResponse> VisibleTasks
        => AllTasks.Where(t => t.IsActive && t.AreaId == AreaId).ToList();

    private string MemberNameFor(Guid memberId)
        => Members.FirstOrDefault(m => m.Id == memberId)?.DisplayName ?? "okänd";

    private static string RecurrenceLabel(RecurrenceRuleContract recurrence) => recurrence switch
    {
        // A "twice weekly" template task travels as a Daily rule with an interval > 1 - see
        // RoomTemplateTask.ToScheduling. There is no calendar slot for "twice a week" as such.
        { Frequency: "Daily", Interval: > 1 } => $"ungefär var {recurrence.Interval}:e dag",
        { Frequency: "Daily" } => "varje dag",
        { Frequency: "Weekly" } => "varje vecka",
        { Frequency: "Monthly" } => "varje månad",
        _ => "återkommer"
    };

    private async Task AddTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _message = "Uppgiften behöver ett namn.";
            return;
        }

        if (_form.EstimatedMinutes <= 0)
        {
            _message = "Välj ungefär hur mycket tid uppgiften tar.";
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            var recurrence = _form.Recurrence switch
            {
                "Daily" => new RecurrenceRuleContract("Daily", 1, Today, null, null),
                "Weekly" => new RecurrenceRuleContract("Weekly", 1, Today, Today.DayOfWeek.ToString(), null),
                "Monthly" => new RecurrenceRuleContract("Monthly", 1, Today, null, null),
                _ => (RecurrenceRuleContract?)null
            };

            var staleAfterDays = _form.Recurrence == "AsNeeded" ? RoomTemplateTask.AsNeededDefaultDays : (int?)null;

            var request = new CreateTaskRequest(
                _form.Name.Trim(),
                _form.EstimatedMinutes,
                Description: null,
                AreaId: AreaId,
                Priority: "Normal",
                DefaultResponsibleMemberId: null,
                PreferredWeekday: null,
                CanBeDeferred: true,
                HasRotatingResponsibility: true,
                RequiresMultiplePeople: false,
                Recurrence: recurrence,
                StaleAfterDays: staleAfterDays,
                RequiresAdult: _form.RequiresAdult);

            if (await Api.CreateTaskAsync(HouseholdId, request) is null)
            {
                _message = "Det gick inte att skapa uppgiften. Försök igen.";
                return;
            }

            _form.Name = string.Empty;
            _form.EstimatedMinutes = 30;
            _form.Recurrence = string.Empty;
            _form.RequiresAdult = false;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddSuggestedTasksAsync()
    {
        var selected = GeneralTaskTemplates.All.Where(task => _suggestedSelected.GetValueOrDefault(task.Name)).ToList();

        if (selected.Count == 0)
        {
            return;
        }

        _suggestionsBusy = true;

        try
        {
            foreach (var task in selected)
            {
                var (recurrence, staleAfterDays) = task.ToScheduling(Today);

                await Api.CreateTaskAsync(HouseholdId, new CreateTaskRequest(
                    task.Name,
                    task.EstimatedMinutes,
                    Description: null,
                    AreaId: null,
                    Priority: "Normal",
                    DefaultResponsibleMemberId: null,
                    PreferredWeekday: null,
                    CanBeDeferred: true,
                    HasRotatingResponsibility: true,
                    RequiresMultiplePeople: false,
                    Recurrence: recurrence,
                    StaleAfterDays: staleAfterDays,
                    RequiresAdult: task.AdultsOnly));
            }

            foreach (var task in selected)
            {
                _suggestedSelected[task.Name] = false;
            }

            await OnChanged.InvokeAsync();
        }
        finally
        {
            _suggestionsBusy = false;
        }
    }

    private async Task RemoveTaskAsync(Guid taskId)
    {
        _removingTaskId = taskId;

        try
        {
            await Api.DeactivateTaskAsync(HouseholdId, taskId);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _removingTaskId = null;
        }
    }
}
