@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject TimeProvider TimeProvider

@if (VisibleTasks.Count == 0)
{
    <p class="muted small">Inga uppgifter här ännu.</p>
}
else
{
    <ul class="list" aria-label="@($"Uppgifter i {Label}")">
        @foreach (var task in VisibleTasks)
        {
            <li class="list-item">
                <span class="list-name">
                    @task.Name
                    @if (task.Recurrence is { } recurrence)
                    {
                        <span class="muted small">@RecurrenceLabel(recurrence)</span>
                    }
                    @if (task.StaleAfterDays is not null)
                    {
                        <span class="muted small">vid behov</span>
                    }
                    @if (task.HasRotatingResponsibility)
                    {
                        <span class="muted small">roterar</span>
                    }
                    else if (task.DefaultResponsibleMemberId is { } ownerId)
                    {
                        <span class="muted small">@MemberNameFor(ownerId)</span>
                    }
                    @if (task.RequiresAdult)
                    {
                        <span class="muted small">endast vuxna</span>
                    }
                </span>
                <div class="list-item-actions">
                    <button type="button" class="btn btn-secondary" aria-label="@($"Ändra frekvens för {task.Name}")"
                            @onclick="() => ToggleEditFrequency(task)">
                        Ändra frekvens
                    </button>
                    <button type="button" class="btn btn-secondary" aria-label="@($"Ta bort {task.Name}")"
                            disabled="@(_removingTaskId == task.Id)"
                            @onclick="() => RemoveTaskAsync(task.Id)">
                        Ta bort
                    </button>
                </div>
            </li>

            @if (_editingTaskId == task.Id)
            {
                <li class="list-item">
                    <label class="field">
                        <span>Ny upprepning för "@task.Name"</span>
                        <select @bind="_editRecurrence">
                            <option value="">Ingen - schemaläggs för hand</option>
                            <option value="Daily">Varje dag</option>
                            <option value="Weekly">Varje vecka</option>
                            <option value="Monthly">Varje månad</option>
                            <option value="AsNeeded">Vid behov</option>
                        </select>
                    </label>

                    @if (IntervalLabel(_editRecurrence) is { } editIntervalLabel)
                    {
                        <label class="field">
                            <span>@editIntervalLabel</span>
                            <input type="number" min="1" max="52" @bind="_editInterval" />
                        </label>
                    }

                    @if (_editMessage is { } editMessage)
                    {
                        <div class="notice notice-problem" role="alert">@editMessage</div>
                    }

                    <button type="button" class="btn btn-primary" disabled="@_editBusy"
                            @onclick="() => SaveFrequencyAsync(task)">
                        @(_editBusy ? "Sparar..." : "Spara")
                    </button>
                    <button type="button" class="btn btn-link" @onclick="() => _editingTaskId = null">
                        Avbryt
                    </button>
                </li>
            }
        }
    </ul>

    <details class="more-options">
        <summary>Ändra frekvens för hela @Label</summary>
        <p class="muted small">
            Sätter samma upprepning på alla @VisibleTasks.Count uppgifter i @Label på en gång -
            bra för ett rum som används mer sällan än andra, i stället för att ändra varje
            uppgift för sig.
        </p>

        <label class="field">
            <span>Ny upprepning för hela @Label</span>
            <select @bind="_bulkRecurrence">
                <option value="">Ingen - schemaläggs för hand</option>
                <option value="Daily">Varje dag</option>
                <option value="Weekly">Varje vecka</option>
                <option value="Monthly">Varje månad</option>
                <option value="AsNeeded">Vid behov</option>
            </select>
        </label>

        @if (IntervalLabel(_bulkRecurrence) is { } bulkIntervalLabel)
        {
            <label class="field">
                <span>@bulkIntervalLabel</span>
                <input type="number" min="1" max="52" @bind="_bulkInterval" />
            </label>
        }

        @if (_bulkMessage is { } bulkMessage)
        {
            <div class="notice" role="status">@bulkMessage</div>
        }

        <button type="button" class="btn btn-secondary" disabled="@_bulkBusy" @onclick="SaveBulkFrequencyAsync">
            @(_bulkBusy ? "Sparar..." : $"Spara för alla {VisibleTasks.Count} uppgifter")
        </button>
    </details>
}

@if (ShowSuggestions)
{
    <details class="more-options">
        <summary>Lägg till vanliga hushållssysslor</summary>
        <p class="muted small">Kryssa i det som stämmer för ert hushåll - inget är förvalt, eftersom det varierar mycket mellan hushåll.</p>

        @foreach (var task in GeneralTaskTemplates.All)
        {
            <label class="field-check">
                <input type="checkbox" @bind="_suggestedSelected[task.Name]" />
                <span>@task.Name</span>
            </label>
        }

        <div class="floor-submit">
            <button type="button" class="btn btn-primary" disabled="@_suggestionsBusy" @onclick="AddSuggestedTasksAsync">
                @(_suggestionsBusy ? "Lägger till..." : "Lägg till valda")
            </button>
        </div>
    </details>
}

<details class="more-options">
    <summary>Lägg till en uppgift i @Label</summary>

    <EditForm Model="_form" OnValidSubmit="AddTaskAsync">
        <label class="field">
            <span>Namn</span>
            <InputText @bind-Value="_form.Name" placeholder="T.ex. Dammsug" />
        </label>

        <div class="field">
            <span>Ungefär hur mycket tid tar det?</span>
            <div class="level-picker">
                @foreach (var level in TimeLevel.All)
                {
                    <button type="button"
                            class="@(_form.EstimatedMinutes == level.Minutes ? "btn btn-primary" : "btn btn-secondary")"
                            @onclick="() => _form.EstimatedMinutes = level.Minutes">
                        @level.Label
                    </button>
                }
            </div>
        </div>

        <label class="field">
            <span>Upprepning</span>
            <select @bind="_form.Recurrence">
                <option value="">Ingen - schemaläggs för hand</option>
                <option value="Daily">Varje dag</option>
                <option value="Weekly">Varje vecka</option>
                <option value="Monthly">Varje månad</option>
                <option value="AsNeeded">Vid behov</option>
            </select>
        </label>

        @if (IntervalLabel(_form.Recurrence) is { } formIntervalLabel)
        {
            <label class="field">
                <span>@formIntervalLabel</span>
                <input type="number" min="1" max="52" @bind="_form.Interval" />
            </label>
        }

        <label class="field-check">
            <input type="checkbox" @bind="_form.RequiresAdult" />
            <span>Bara vuxna ska tilldelas den här</span>
        </label>

        @if (_message is { } message)
        {
            <div class="notice notice-problem" role="alert">@message</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@_busy">
            @(_busy ? "Lägger till..." : "Lägg till uppgift")
        </button>
    </EditForm>
</details>

@code {
    /// <summary>Every task management surface lives here now - see Omraden.razor, one instance per room plus "Övrigt".</summary>
    [Parameter, EditorRequired]
    public Guid HouseholdId { get; set; }

    /// <summary>Null groups the tasks that belong to no particular room ("Övrigt").</summary>
    [Parameter]
    public Guid? AreaId { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<TaskDefinitionResponse> AllTasks { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<HouseholdMemberResponse> Members { get; set; } = [];

    /// <summary>Raised after adding or removing a task, so the parent can reload the shared list.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnChanged { get; set; }

    /// <summary>Whether to offer GeneralTaskTemplates' checklist - true only for "Övrigt" (no room to suggest tasks from instead).</summary>
    [Parameter]
    public bool ShowSuggestions { get; set; }

    private sealed class Form
    {
        public string Name { get; set; } = string.Empty;
        public int EstimatedMinutes { get; set; } = 30;
        public string Recurrence { get; set; } = string.Empty;
        public int Interval { get; set; } = 1;
        public bool RequiresAdult { get; set; }
    }

    private readonly Form _form = new();
    private string? _message;
    private bool _busy;
    private Guid? _removingTaskId;

    private Guid? _editingTaskId;
    private string _editRecurrence = string.Empty;
    private int _editInterval = 1;
    private string? _editMessage;
    private bool _editBusy;

    private string _bulkRecurrence = string.Empty;
    private int _bulkInterval = 1;
    private string? _bulkMessage;
    private bool _bulkBusy;

    private readonly Dictionary<string, bool> _suggestedSelected =
        GeneralTaskTemplates.All.ToDictionary(task => task.Name, _ => false);
    private bool _suggestionsBusy;

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    private List<TaskDefinitionResponse> VisibleTasks
        => AllTasks.Where(t => t.IsActive && t.AreaId == AreaId).ToList();

    private string MemberNameFor(Guid memberId)
        => Members.FirstOrDefault(m => m.Id == memberId)?.DisplayName ?? "okänd";

    private static string RecurrenceLabel(RecurrenceRuleContract recurrence) => recurrence switch
    {
        // A "twice weekly" template task travels as a Daily rule with an interval > 1 - see
        // RoomTemplateTask.ToScheduling. There is no calendar slot for "twice a week" as such.
        { Frequency: "Daily", Interval: > 1 } => $"ungefär var {recurrence.Interval}:e dag",
        { Frequency: "Daily" } => "varje dag",
        { Frequency: "Weekly", Interval: > 1 } => $"var {recurrence.Interval}:e vecka",
        { Frequency: "Weekly" } => "varje vecka",
        { Frequency: "Monthly", Interval: > 1 } => $"var {recurrence.Interval}:e månad",
        { Frequency: "Monthly" } => "varje månad",
        _ => "återkommer"
    };

    /// <summary>The label for the "how many X between each time" field this frequency choice
    /// needs, or <c>null</c> when it has no interval to set ("Ingen"/"Vid behov").</summary>
    private static string? IntervalLabel(string recurrenceOption) => recurrenceOption switch
    {
        "Daily" => "Hur många dagar mellan varje gång?",
        "Weekly" => "Hur många veckor mellan varje gång?",
        "Monthly" => "Hur många månader mellan varje gång?",
        _ => null
    };

    /// <summary>Shared by creation, per-task editing, and the whole-room bulk edit.</summary>
    private static RecurrenceRuleContract? BuildRecurrence(string recurrenceOption, DateOnly today, int interval)
    {
        var safeInterval = Math.Max(1, interval);

        return recurrenceOption switch
        {
            "Daily" => new RecurrenceRuleContract("Daily", safeInterval, today, null, null),
            "Weekly" => new RecurrenceRuleContract("Weekly", safeInterval, today, today.DayOfWeek.ToString(), null),
            "Monthly" => new RecurrenceRuleContract("Monthly", safeInterval, today, null, null),
            _ => null
        };
    }

    /// <summary>Which dropdown option matches this task's current frequency, so opening the
    /// edit form shows what is actually set rather than starting blank.</summary>
    private static string RecurrenceOptionFor(TaskDefinitionResponse task) => task switch
    {
        { StaleAfterDays: not null } => "AsNeeded",
        { Recurrence.Frequency: "Daily" } => "Daily",
        { Recurrence.Frequency: "Weekly" } => "Weekly",
        { Recurrence.Frequency: "Monthly" } => "Monthly",
        _ => string.Empty
    };

    private void ToggleEditFrequency(TaskDefinitionResponse task)
    {
        if (_editingTaskId == task.Id)
        {
            _editingTaskId = null;
            return;
        }

        _editingTaskId = task.Id;
        _editRecurrence = RecurrenceOptionFor(task);
        _editInterval = task.Recurrence?.Interval ?? 1;
        _editMessage = null;
    }

    private async Task SaveFrequencyAsync(TaskDefinitionResponse task)
    {
        _editBusy = true;
        _editMessage = null;

        try
        {
            var recurrence = BuildRecurrence(_editRecurrence, Today, _editInterval);
            var staleAfterDays = _editRecurrence == "AsNeeded" ? RoomTemplateTask.AsNeededDefaultDays : (int?)null;

            if (await Api.UpdateTaskFrequencyAsync(HouseholdId, task.Id, recurrence, staleAfterDays) is null)
            {
                _editMessage = "Det gick inte att spara. Försök igen.";
                return;
            }

            _editingTaskId = null;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _editMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _editBusy = false;
        }
    }

    private async Task AddTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _message = "Uppgiften behöver ett namn.";
            return;
        }

        if (_form.EstimatedMinutes <= 0)
        {
            _message = "Välj ungefär hur mycket tid uppgiften tar.";
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            var recurrence = BuildRecurrence(_form.Recurrence, Today, _form.Interval);
            var staleAfterDays = _form.Recurrence == "AsNeeded" ? RoomTemplateTask.AsNeededDefaultDays : (int?)null;

            var request = new CreateTaskRequest(
                _form.Name.Trim(),
                _form.EstimatedMinutes,
                Description: null,
                AreaId: AreaId,
                Priority: "Normal",
                DefaultResponsibleMemberId: null,
                PreferredWeekday: null,
                CanBeDeferred: true,
                HasRotatingResponsibility: true,
                RequiresMultiplePeople: false,
                Recurrence: recurrence,
                StaleAfterDays: staleAfterDays,
                RequiresAdult: _form.RequiresAdult);

            if (await Api.CreateTaskAsync(HouseholdId, request) is null)
            {
                _message = "Det gick inte att skapa uppgiften. Försök igen.";
                return;
            }

            _form.Name = string.Empty;
            _form.EstimatedMinutes = 30;
            _form.Recurrence = string.Empty;
            _form.Interval = 1;
            _form.RequiresAdult = false;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Applies one chosen frequency to every visible task in this room at once - for a room
    /// used much less than others, rather than editing each of its tasks one by one. Each
    /// task's own anchor date is staggered by its position in the room (same spreading idea as
    /// RoomTemplateTask.ToScheduling), so a whole room moving to e.g. "every 4 weeks" does not
    /// pile every one of its tasks onto the same day.
    /// </summary>
    private async Task SaveBulkFrequencyAsync()
    {
        _bulkBusy = true;
        _bulkMessage = null;

        try
        {
            var staleAfterDays = _bulkRecurrence == "AsNeeded" ? RoomTemplateTask.AsNeededDefaultDays : (int?)null;
            var tasks = VisibleTasks;
            var failedCount = 0;

            foreach (var (task, index) in tasks.Select((task, index) => (task, index)))
            {
                var recurrence = BuildRecurrence(_bulkRecurrence, Today.AddDays(index), _bulkInterval);

                if (await Api.UpdateTaskFrequencyAsync(HouseholdId, task.Id, recurrence, staleAfterDays) is null)
                {
                    failedCount++;
                }
            }

            _bulkMessage = failedCount == 0
                ? $"Uppdaterade {tasks.Count} uppgifter."
                : $"{tasks.Count - failedCount} av {tasks.Count} uppgifter uppdaterades - försök igen för resten.";

            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _bulkMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _bulkBusy = false;
        }
    }

    private async Task AddSuggestedTasksAsync()
    {
        var selected = GeneralTaskTemplates.All.Where(task => _suggestedSelected.GetValueOrDefault(task.Name)).ToList();

        if (selected.Count == 0)
        {
            return;
        }

        _suggestionsBusy = true;

        try
        {
            // Each one gets its own spread position: unlike a room's tasks (Omraden.razor),
            // these do not belong to a place worth visiting as one sitting, so there is no
            // reason to keep any two of them on the same day.
            foreach (var (task, index) in selected.Select((task, index) => (task, index)))
            {
                var (recurrence, staleAfterDays) = task.ToScheduling(Today, index);

                await Api.CreateTaskAsync(HouseholdId, new CreateTaskRequest(
                    task.Name,
                    task.EstimatedMinutes,
                    Description: null,
                    AreaId: null,
                    Priority: "Normal",
                    DefaultResponsibleMemberId: null,
                    PreferredWeekday: null,
                    CanBeDeferred: true,
                    HasRotatingResponsibility: true,
                    RequiresMultiplePeople: false,
                    Recurrence: recurrence,
                    StaleAfterDays: staleAfterDays,
                    RequiresAdult: task.AdultsOnly));
            }

            foreach (var task in selected)
            {
                _suggestedSelected[task.Name] = false;
            }

            await OnChanged.InvokeAsync();
        }
        finally
        {
            _suggestionsBusy = false;
        }
    }

    private async Task RemoveTaskAsync(Guid taskId)
    {
        _removingTaskId = taskId;

        try
        {
            await Api.DeactivateTaskAsync(HouseholdId, taskId);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _removingTaskId = null;
        }
    }
}
