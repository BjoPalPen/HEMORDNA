@using Hemordna.Client.Support
@implements IAsyncDisposable
@inject IJSRuntime JS

<li class="task" @ref="_rootRef">
    <button type="button" class="task-check"
            aria-label="@($"Markera {Item.Name} som klar")"
            disabled="@IsBusy"
            @onclick="CompleteAsync"></button>

    @if (ShowIcon)
    {
        <img class="task-icon" src="@IconSrc(Item.Name, Item.AreaName)" alt="" width="24" height="24" />
    }

    <span class="task-name">
        @Item.Name
        @if (ShowAreaChip && Item.AreaName is { } area)
        {
            <span class="chip">@area</span>
        }
        @if (ShowTimeLevel && Item.EstimatedMinutes > 0)
        {
            <span class="chip chip-time">@TimeLevel.MinutesLabel(Item.EstimatedMinutes)</span>
        }
        @if (IsStartHere)
        {
            <span class="chip chip-today">Börja här</span>
        }
        @if (IsBroughtForward)
        {
            <span class="chip chip-forward">I förväg</span>
        }
        @if (ShowOverdueNote && Item.IsOverdue)
        {
            <span class="task-note muted small">sedan tidigare</span>
        }
    </span>

    <button type="button" class="task-expand @(IsExpanded ? "task-expand-open" : null)"
            aria-label="@($"Mer om {Item.Name}")"
            aria-expanded="@(IsExpanded ? "true" : "false")"
            @onclick="() => OnToggleExpand.InvokeAsync(Item.OccurrenceId)">
        <Icon Name="chevron-right" Size="18" />
    </button>
</li>

@if (IsExpanded)
{
    <li class="task-details">
        @if (TaskSteps.Parse(Item.Description) is { } steps)
        {
            <ol class="task-steps muted small">
                @foreach (var step in steps)
                {
                    <li>@step</li>
                }
            </ol>
        }
        else if (!string.IsNullOrWhiteSpace(Item.Description))
        {
            <p class="muted small">@Item.Description</p>
        }

        @if (Item.CanBeDeferred)
        {
            <button type="button" class="btn btn-secondary"
                    disabled="@IsBusy"
                    @onclick="() => OnDefer.InvokeAsync(Item.OccurrenceId)">
                Skjut upp till imorgon
            </button>
        }
    </li>
}

@code {
    /// <summary>One planned task on "Idag" - the check button, name, room chip, expandable
    /// description and defer action, plus a swipe shortcut for both. Factored out so the list
    /// can be grouped (by room, or overdue-first) without duplicating this markup per group -
    /// see MinDag.razor.</summary>
    [Parameter, EditorRequired]
    public PlannedTaskResponse Item { get; set; } = null!;

    /// <summary>The day this row is being shown on - used only to tell a task brought forward
    /// from tomorrow (<see cref="IsBroughtForward"/>) apart from an ordinary one, never to
    /// re-derive anything the API already decided.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    [Parameter]
    public bool ShowIcon { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public bool IsExpanded { get; set; }

    /// <summary>False inside a group that already carries its own "overdue" heading, so the
    /// same fact is not stated twice.</summary>
    [Parameter]
    public bool ShowOverdueNote { get; set; } = true;

    /// <summary>False inside a group that already carries its own room heading (see
    /// MinDag.razor's RoomGroups), so the room is not named twice on the same row. Still true
    /// for "Sedan tidigare", the one place this row appears without any room OR floor heading
    /// above it - the chip there shows the full area name, "Våning – " prefix included, since
    /// it is the only thing distinguishing e.g. two different floors' own "Hall".</summary>
    [Parameter]
    public bool ShowAreaChip { get; set; } = true;

    /// <summary>
    /// A member's own choice (MemberPreference.ShowTimeLevel) - off by default, so someone who
    /// never turned it on sees no time at all on Idag (docs/DESIGN.md §6a). When on, the exact
    /// saved minutes (TimeLevel.MinutesLabel, e.g. "5 min") rather than the level word it was
    /// chosen from - level words are for CHOOSING among four options, not for reading back a
    /// number (docs/ARCHITECTURE.md "Beslut: Ångra och stabil lista" §B5, "Uppföljning").
    /// </summary>
    [Parameter]
    public bool ShowTimeLevel { get; set; }

    /// <summary>The planner's own first task (MinDag.razor's StartHereOccurrenceId) - a quiet
    /// pointer for someone who does not know where to start, never a second "next" concept next
    /// to the focus card's own. List view only, and only while nothing is already under way
    /// (see Support/StartedTask.cs, wired in from the caller so this component stays unaware of
    /// where that state lives).</summary>
    [Parameter]
    public bool IsStartHere { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnComplete { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnToggleExpand { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnDefer { get; set; }

    private ElementReference _rootRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<TaskListItem>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfRef = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/task-swipe.js");
        _handle = await _module.InvokeAsync<IJSObjectReference>("attach", _rootRef, _selfRef);
    }

    /// <summary>The tap-to-complete button's own path - the swipe gesture plays the same
    /// confirmation directly from task-swipe.js before calling <see cref="OnSwipeCompleteAsync"/>,
    /// so it does not come through here.</summary>
    private async Task CompleteAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("confirm", _rootRef);
        }

        await OnComplete.InvokeAsync(Item.OccurrenceId);
    }

    [JSInvokable]
    public async Task OnSwipeCompleteAsync()
    {
        if (!IsBusy)
        {
            await OnComplete.InvokeAsync(Item.OccurrenceId);
        }
    }

    [JSInvokable]
    public async Task OnSwipeDeferAsync()
    {
        if (!IsBusy && Item.CanBeDeferred)
        {
            await OnDefer.InvokeAsync(Item.OccurrenceId);
        }
    }

    /// <summary>Mirrors TaskOccurrence.IsBroughtForwardOn: outstanding work due today only
    /// because it was deliberately pulled forward from a later date (see
    /// HemordnaApiClient.BringOccurrenceForwardAsync) - never true for a task that was simply
    /// scheduled for today all along.</summary>
    private bool IsBroughtForward => Item.OriginalScheduledDate > Today;

    private static string IconSrc(string taskName, string? areaName) => $"icons/tasks/{TaskIcons.For(taskName, areaName)}.svg";

    public async ValueTask DisposeAsync()
    {
        if (_handle is not null)
        {
            try
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone - nothing left to clean up client-side.
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
