@* Isolated in its own component: nesting this many dynamic loops directly inside the floor
   wizard's own EditForm caused its submit button to silently stop firing (see HANDOFF.md). *@
<div class="floor-room-owners">
    <p class="muted small">
        Vems rum är det? Den personen får då ensamt ansvar för det rummet - ingen rotation.
        Lämna som "Delat ansvar" annars.
    </p>
    @for (var i = 1; i <= Count; i++)
    {
        var instance = i;
        <div class="floor-owner-row">
            <span>@(Count > 1 ? $"{RoomLabel} {instance}" : RoomLabel)</span>
            <select value="@OwnerMemberId.GetValueOrDefault(instance, string.Empty)"
                    aria-label="@($"Vems {(Count > 1 ? $"{RoomLabel} {instance}" : LowerFirst(RoomLabel))}")"
                    @onchange="e => SetOwner(instance, (string)e.Value!)">
                <option value="">Delat ansvar</option>
                @foreach (var member in Members)
                {
                    <option value="@member.Id">@member.DisplayName</option>
                }
            </select>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public int Count { get; set; }

    [Parameter, EditorRequired]
    public Dictionary<int, string> OwnerMemberId { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<HouseholdMemberResponse> Members { get; set; } = [];

    /// <summary>The room template's own label (e.g. "Sovrum", "Kök") - this component was
    /// originally bedroom-only (hence its old name, BedroomOwnerPicker) but the same "one
    /// permanent owner instead of rotation" choice applies to every room type, so the label is
    /// now supplied by the caller instead of hardcoded.</summary>
    [Parameter, EditorRequired]
    public string RoomLabel { get; set; } = string.Empty;

    private void SetOwner(int instance, string memberId) => OwnerMemberId[instance] = memberId;

    private static string LowerFirst(string text)
        => text.Length == 0 ? text : char.ToLowerInvariant(text[0]) + text[1..];
}
