@using Hemordna.Client.Support
@inject HemordnaApiClient Api

<BottomSheet Title="@Task.Name" IsOpen="IsOpen" IsOpenChanged="OnIsOpenChanged" Detent="SheetDetent.Half">
    @switch (_view)
    {
        case View.Frequency:
            <label class="field">
                <span>Upprepning</span>
                <select @bind="_recurrenceOption">
                    <option value="">Ingen - schemaläggs för hand</option>
                    <option value="Daily">Varje dag</option>
                    <option value="Weekly">Varje vecka</option>
                    <option value="Monthly">Varje månad</option>
                    <option value="AsNeeded">Vid behov</option>
                </select>
            </label>

            @if (IntervalLabel(_recurrenceOption) is { } intervalLabel)
            {
                <label class="field">
                    <span>@intervalLabel</span>
                    <input type="number" min="1" max="52" @bind="_interval" />
                </label>
            }

            @if (_message is { } frequencyMessage)
            {
                <div class="notice notice-problem" role="alert">@frequencyMessage</div>
            }

            <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="SaveFrequencyAsync">
                @(_busy ? "Sparar..." : "Spara")
            </button>
            <button type="button" class="btn btn-link" @onclick="BackToOptions">Avbryt</button>
            break;

        case View.Assignment:
            <label class="field">
                <span>Vem gör det?</span>
                <select @bind="_assignmentMemberId">
                    <option value="">Roterar mellan alla</option>
                    @foreach (var member in Members)
                    {
                        <option value="@member.Id">@member.DisplayName</option>
                    }
                </select>
            </label>

            @if (_message is { } assignmentMessage)
            {
                <div class="notice notice-problem" role="alert">@assignmentMessage</div>
            }

            <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="SaveAssignmentAsync">
                @(_busy ? "Sparar..." : "Spara")
            </button>
            <button type="button" class="btn btn-link" @onclick="BackToOptions">Avbryt</button>
            break;

        case View.Time:
            <div class="field">
                <span>Ungefär hur lång tid tar det?</span>
                <div class="level-picker">
                    @foreach (var level in TimeLevel.All)
                    {
                        <button type="button"
                                class="@(_estimatedMinutes == level.Minutes ? "btn btn-primary" : "btn btn-secondary")"
                                @onclick="() => _estimatedMinutes = level.Minutes">
                            <span>@level.Label</span>
                            @if (level.Minutes > 0)
                            {
                                <span class="muted small">@TimeLevel.MinutesLabel(level.Minutes)</span>
                            }
                        </button>
                    }
                </div>
            </div>

            @if (_message is { } timeMessage)
            {
                <div class="notice notice-problem" role="alert">@timeMessage</div>
            }

            <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="SaveTimeAsync">
                @(_busy ? "Sparar..." : "Spara")
            </button>
            <button type="button" class="btn btn-link" @onclick="BackToOptions">Avbryt</button>
            break;

        case View.Room:
            <label class="field">
                <span>Rum</span>
                <select @bind="_roomAreaId">
                    <option value="">Övrigt</option>
                    @foreach (var area in Areas)
                    {
                        <option value="@area.Id">@area.Name</option>
                    }
                </select>
            </label>

            @if (_message is { } roomMessage)
            {
                <div class="notice notice-problem" role="alert">@roomMessage</div>
            }

            <button type="button" class="btn btn-primary btn-block" disabled="@_busy" @onclick="SaveRoomAsync">
                @(_busy ? "Sparar..." : "Spara")
            </button>
            <button type="button" class="btn btn-link" @onclick="BackToOptions">Avbryt</button>
            break;

        default:
            <ul class="list" aria-label="Alternativ för uppgiften">
                <li class="list-item list-item-flush">
                    <button type="button" class="task-options-row" @onclick="() => _view = View.Frequency">
                        <span>Upprepning</span>
                        <span class="task-options-value muted small">@RecurrenceSummary</span>
                        <Icon Name="chevron-right" Size="18" />
                    </button>
                </li>
                <li class="list-item list-item-flush">
                    <button type="button" class="task-options-row" @onclick="() => _view = View.Assignment">
                        <span>Vem gör det</span>
                        <span class="task-options-value muted small">@AssignmentSummary</span>
                        <Icon Name="chevron-right" Size="18" />
                    </button>
                </li>
                <li class="list-item list-item-flush">
                    <button type="button" class="task-options-row" @onclick="() => _view = View.Time">
                        <span>Tid</span>
                        <span class="task-options-value muted small">@TimeSummary</span>
                        <Icon Name="chevron-right" Size="18" />
                    </button>
                </li>
                <li class="list-item list-item-flush">
                    <button type="button" class="task-options-row" @onclick="() => _view = View.Room">
                        <span>Rum</span>
                        <span class="task-options-value muted small">@RoomSummary</span>
                        <Icon Name="chevron-right" Size="18" />
                    </button>
                </li>
                <li class="list-item">
                    <span class="list-name">Kräver vuxen</span>
                    <label class="field-check">
                        <input type="checkbox" checked="@Task.RequiresAdult" @onchange="ToggleRequiresAdultAsync" />
                        <span>Bara vuxna tilldelas den här</span>
                    </label>
                </li>
            </ul>

            @if (_message is { } deleteMessage)
            {
                <div class="notice notice-problem" role="alert">@deleteMessage</div>
            }

            <button type="button" class="btn btn-danger btn-block" disabled="@_busy" @onclick="DeleteAsync">
                Ta bort uppgiften
            </button>
            break;
    }
</BottomSheet>

@code {
    private enum View { Options, Frequency, Assignment, Time, Room }

    [Parameter, EditorRequired]
    public Guid HouseholdId { get; set; }

    [Parameter, EditorRequired]
    public TaskDefinitionResponse Task { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<AreaResponse> Areas { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<HouseholdMemberResponse> Members { get; set; } = [];

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Raised after any successful change (or delete), so the parent reloads its task list.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnChanged { get; set; }

    private View _view;
    private string _recurrenceOption = string.Empty;
    private int _interval = 1;
    private string _assignmentMemberId = string.Empty;
    private int _estimatedMinutes = TimeLevel.All[0].Minutes;
    private string _roomAreaId = string.Empty;
    private string? _message;
    private bool _busy;

    private string RecurrenceSummary => Task switch
    {
        { StaleAfterDays: not null } => "Vid behov",
        { Recurrence.Frequency: "Daily", Recurrence.Interval: > 1 } r => $"Var {r.Recurrence!.Interval}:e dag",
        { Recurrence.Frequency: "Daily" } => "Varje dag",
        { Recurrence.Frequency: "Weekly", Recurrence.Interval: > 1 } r => $"Var {r.Recurrence!.Interval}:e vecka",
        { Recurrence.Frequency: "Weekly" } => "Varje vecka",
        { Recurrence.Frequency: "Monthly", Recurrence.Interval: > 1 } r => $"Var {r.Recurrence!.Interval}:e månad",
        { Recurrence.Frequency: "Monthly" } => "Varje månad",
        _ => "Ingen"
    };

    private string AssignmentSummary => Task.HasRotatingResponsibility
        ? "Roterar mellan alla"
        : Members.FirstOrDefault(m => m.Id == Task.DefaultResponsibleMemberId)?.DisplayName ?? "Okänd";

    private string RoomSummary => Areas.FirstOrDefault(a => a.Id == Task.AreaId)?.Name ?? "Övrigt";

    private string TimeSummary
        => TimeLevel.All.First(level => level.Minutes == TimeLevel.ClosestMinutes(Task.EstimatedMinutes)).Label;

    protected override void OnParametersSet()
    {
        // Re-seed the edit fields whenever a different task is opened (the component instance
        // is reused across rows in RoomSheet), and whenever it re-closes and reopens for the
        // same task, so a cancelled edit never lingers into the next visit.
        _view = View.Options;
        _message = null;
        _recurrenceOption = RecurrenceOptionFor(Task);
        _interval = Task.Recurrence?.Interval ?? 1;
        _assignmentMemberId = Task.DefaultResponsibleMemberId?.ToString() ?? string.Empty;
        _estimatedMinutes = TimeLevel.ClosestMinutes(Task.EstimatedMinutes);
        _roomAreaId = Task.AreaId?.ToString() ?? string.Empty;
    }

    private void BackToOptions()
    {
        _view = View.Options;
        _message = null;
    }

    private async Task OnIsOpenChanged(bool isOpen)
    {
        IsOpen = isOpen;
        await IsOpenChanged.InvokeAsync(isOpen);
    }

    private static string? IntervalLabel(string recurrenceOption) => recurrenceOption switch
    {
        "Daily" => "Hur många dagar mellan varje gång?",
        "Weekly" => "Hur många veckor mellan varje gång?",
        "Monthly" => "Hur många månader mellan varje gång?",
        _ => null
    };

    private static string RecurrenceOptionFor(TaskDefinitionResponse task) => task switch
    {
        { StaleAfterDays: not null } => "AsNeeded",
        { Recurrence.Frequency: "Daily" } => "Daily",
        { Recurrence.Frequency: "Weekly" } => "Weekly",
        { Recurrence.Frequency: "Monthly" } => "Monthly",
        _ => string.Empty
    };

    private RecurrenceRuleContract? BuildRecurrence(string recurrenceOption, DateOnly today, int interval)
    {
        var safeInterval = Math.Max(1, interval);

        return recurrenceOption switch
        {
            "Daily" => new RecurrenceRuleContract("Daily", safeInterval, today, null, null),
            "Weekly" => new RecurrenceRuleContract("Weekly", safeInterval, today, today.DayOfWeek.ToString(), null),
            "Monthly" => new RecurrenceRuleContract("Monthly", safeInterval, today, null, null),
            _ => null
        };
    }

    private async Task SaveFrequencyAsync()
    {
        _busy = true;
        _message = null;

        try
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var recurrence = BuildRecurrence(_recurrenceOption, today, _interval);
            var staleAfterDays = _recurrenceOption == "AsNeeded" ? RoomTemplateTask.AsNeededDefaultDays : (int?)null;

            if (await Api.UpdateTaskFrequencyAsync(HouseholdId, Task.Id, recurrence, staleAfterDays) is null)
            {
                _message = "Det gick inte att spara. Försök igen.";
                return;
            }

            _view = View.Options;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAssignmentAsync()
    {
        _busy = true;
        _message = null;

        try
        {
            var memberId = string.IsNullOrEmpty(_assignmentMemberId) ? (Guid?)null : Guid.Parse(_assignmentMemberId);

            if (await Api.UpdateTaskAssignmentAsync(HouseholdId, Task.Id, memberId) is null)
            {
                _message = "Det gick inte att spara. Försök igen.";
                return;
            }

            _view = View.Options;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveTimeAsync()
    {
        _busy = true;
        _message = null;

        try
        {
            if (await Api.ChangeTaskEstimatedMinutesAsync(HouseholdId, Task.Id, _estimatedMinutes) is null)
            {
                _message = "Det gick inte att spara. Försök igen.";
                return;
            }

            _view = View.Options;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveRoomAsync()
    {
        _busy = true;
        _message = null;

        try
        {
            var areaId = string.IsNullOrEmpty(_roomAreaId) ? (Guid?)null : Guid.Parse(_roomAreaId);

            if (await Api.MoveTaskToAreaAsync(HouseholdId, Task.Id, areaId) is null)
            {
                _message = "Det gick inte att spara. Försök igen.";
                return;
            }

            _view = View.Options;
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleRequiresAdultAsync(ChangeEventArgs e)
    {
        var requiresAdult = (bool)e.Value!;
        _message = null;

        try
        {
            if (await Api.SetTaskRequiresAdultAsync(HouseholdId, Task.Id, requiresAdult) is null)
            {
                _message = "Det gick inte att spara. Försök igen.";
                return;
            }

            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        _message = null;

        try
        {
            await Api.DeactivateTaskAsync(HouseholdId, Task.Id);
            await OnIsOpenChanged(false);
            await OnChanged.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }
}
