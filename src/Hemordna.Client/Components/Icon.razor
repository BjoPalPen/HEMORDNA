<svg class="icon" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true">
    @GetPaths(Name)
</svg>

@code {
    /// <summary>One of: sun, grid, calendar, people, chevron-right, plus, check, more,
    /// battery-low, battery-medium, battery-full, play, speaker, speaker-off, arrow-right,
    /// skip.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 24;

    private static MarkupString GetPaths(string name) => new(name switch
    {
        "sun" => """<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>""",
        "grid" => """<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/>""",
        "calendar" => """<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>""",
        "people" => """<circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="10" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15 20c0-2.2 1.3-4 3.5-4s3.5 1.8 3.5 4"/>""",
        "chevron-right" => """<path d="M9 5l7 7-7 7"/>""",
        "plus" => """<path d="M12 5v14M5 12h14"/>""",
        "check" => """<path d="M5 13l4 4L19 7"/>""",
        "more" => """<circle cx="5" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.6" fill="currentColor" stroke="none"/>""",
        // "Hur är orken idag?" (Lite/Lagom/Mycket) - a battery outline with 1/2/3 filled bars.
        // Shared outline across all three so only the fill differs, same battery shape read at a
        // glance as "how much charge".
        "battery-low" => BatteryOutline + Bar(1),
        "battery-medium" => BatteryOutline + Bar(1) + Bar(2),
        "battery-full" => BatteryOutline + Bar(1) + Bar(2) + Bar(3),
        // Fokuskortet (Uppdrag: fokuskortet - hierarki, ikoner och en dubblerad rubrik) - a
        // filled triangle reads more clearly as "play" at 20px than a thin stroke outline would,
        // same reasoning "more"/the battery bars above already filled rather than stroked.
        "play" => """<path d="M7 4.5v15l13-7.5z" fill="currentColor" stroke="none" stroke-linejoin="round"/>""",
        "speaker" => """<path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M17 9a4 4 0 0 1 0 6M19.5 6.5a8 8 0 0 1 0 11"/>""",
        "speaker-off" => """<path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 9l6 6M22 9l-6 6"/>""",
        "arrow-right" => """<path d="M4 12h16M13 6l7 6-7 6"/>""",
        "skip" => """<path d="M5 5v14l10-7z" fill="currentColor" stroke="none" stroke-linejoin="round"/><rect x="17" y="5" width="2.4" height="14" rx="1" fill="currentColor" stroke="none"/>""",
        _ => string.Empty,
    });

    // Body 2..18 wide (16px) with a small terminal nub at the right - leaves room 20..22 for the
    // nub without touching the 24px viewBox edge.
    private const string BatteryOutline = """<rect x="2" y="7" width="16" height="10" rx="2"/><rect x="19" y="10" width="2" height="4" rx="1" fill="currentColor" stroke="none"/>""";

    // Bar 1 is leftmost (closest to the battery's negative end); three bars fill the body exactly.
    private static string Bar(int position)
    {
        var x = 4 + (position - 1) * 4;
        return $"""<rect x="{x}" y="9" width="3" height="6" rx="1" fill="currentColor" stroke="none"/>""";
    }
}
