<svg class="icon" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true">
    @GetPaths(Name)
</svg>

@code {
    /// <summary>One of: sun, grid, calendar, people, chevron-right, plus, check, more.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 24;

    private static MarkupString GetPaths(string name) => new(name switch
    {
        "sun" => """<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>""",
        "grid" => """<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/>""",
        "calendar" => """<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>""",
        "people" => """<circle cx="9" cy="8" r="3.5"/><circle cx="17" cy="10" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M15 20c0-2.2 1.3-4 3.5-4s3.5 1.8 3.5 4"/>""",
        "chevron-right" => """<path d="M9 5l7 7-7 7"/>""",
        "plus" => """<path d="M12 5v14M5 12h14"/>""",
        "check" => """<path d="M5 13l4 4L19 7"/>""",
        "more" => """<circle cx="5" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.6" fill="currentColor" stroke="none"/>""",
        _ => string.Empty,
    });
}
