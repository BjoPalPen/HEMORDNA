@page "/installningar"
@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject WebAuthnClient WebAuthn
@inject IJSRuntime JS

<PageTitle>Inställningar – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar...</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="LoadAsync" />
}
else
{
    <h1>Min visning</h1>
    <p class="muted">
        Det här är din personliga inställning och påverkar inte andra i hushållet.
    </p>

    @if (_presentation is null)
    {
        <p class="muted">Hämtar...</p>
    }
    else
    {
        <div class="card">
            <h2>Hur vill du se dina uppgifter?</h2>

            <div class="chips" aria-label="Snabbval">
                @foreach (var preset in Presets)
                {
                    <button type="button" class="chip-action @(ActivePreset == preset ? "chip-primary" : null)"
                            @onclick="() => ApplyPresetAsync(preset)">
                        @preset.Label
                    </button>
                }
            </div>

            <div class="notice">
                Detta är din personliga inställning och påverkar inte andra i hushållet.
            </div>

            @foreach (var option in PresentationOptions)
            {
                <label class="field field-check">
                    <input type="radio" name="presentation" value="@option.Value"
                           checked="@(_presentation == option.Value)"
                           @onchange="() => _presentation = option.Value" />
                    <span>@option.Label</span>
                </label>
            }

            <ul class="list" aria-label="Fler val">
                <li class="list-item">
                    <label class="field-check">
                        <input type="checkbox" checked="@_showTimeLevel"
                               @onchange="@(e => _showTimeLevel = (bool)e.Value!)" />
                        <span>Visa ungefär hur lång tid en uppgift tar</span>
                    </label>
                </li>
                <li class="list-item">
                    <label class="field-check">
                        <input type="checkbox" checked="@_calmScreen" @onchange="ToggleCalmScreenAsync" />
                        <span>Lugnare skärm – inga rörelser eller genomskinliga effekter</span>
                    </label>
                    <p class="muted small">Gäller den här enheten</p>
                </li>
            </ul>

            <h2>Motivation</h2>

            @foreach (var option in MotivationOptions)
            {
                <label class="field field-check">
                    <input type="radio" name="motivation" value="@option.Value"
                           checked="@(_motivation == option.Value)"
                           @onchange="() => _motivation = option.Value" />
                    <span>@option.Label</span>
                </label>
            }

            @if (_message is { } message)
            {
                <div class="notice notice-problem" role="alert">@message</div>
            }

            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
                @(_busy ? "Sparar..." : "Spara")
            </button>
        </div>
    }

    <div class="card">
        <h2>Utseende</h2>
        <p class="muted small">
            Det här gäller bara den här enheten, inte hushållet eller dina andra enheter.
        </p>

        @foreach (var option in ThemeOptions)
        {
            <label class="field field-check">
                <input type="radio" name="theme" value="@option.Value"
                       checked="@(_theme == option.Value)"
                       @onchange="() => SetThemeAsync(option.Value)" />
                <span>@option.Label</span>
            </label>
        }
    </div>

    <div class="card">
        <h2>Byt lösenord</h2>

        <EditForm Model="_passwordForm" OnValidSubmit="ChangePasswordAsync">
            <label class="field">
                <span>Nuvarande lösenord</span>
                <InputText @bind-Value="_passwordForm.CurrentPassword" type="password" autocomplete="current-password" />
            </label>

            <label class="field">
                <span>Nytt lösenord</span>
                <InputText @bind-Value="_passwordForm.NewPassword" type="password" autocomplete="new-password" />
            </label>

            <label class="field">
                <span>Bekräfta nytt lösenord</span>
                <InputText @bind-Value="_passwordForm.ConfirmPassword" type="password" autocomplete="new-password" />
            </label>

            @if (_passwordChanged)
            {
                <div class="notice">Lösenordet är bytt.</div>
            }

            @if (_passwordMessages.Count > 0)
            {
                <div class="notice notice-problem" role="alert">
                    <ul class="message-list">
                        @foreach (var message in _passwordMessages)
                        {
                            <li>@message</li>
                        }
                    </ul>
                </div>
            }

            <button type="submit" class="btn btn-primary" disabled="@_passwordBusy">
                @(_passwordBusy ? "Byter..." : "Byt lösenord")
            </button>
        </EditForm>
    </div>

    @if (_passkeyCheckDone)
    {
        <div class="card">
            <h2>Biometrisk inloggning</h2>

            @if (!_passkeySupported)
            {
                <p class="muted">Den här enheten eller webbläsaren stödjer inte biometrisk inloggning.</p>
            }
            else
            {
                <p class="muted">
                    Logga in med Face ID, Touch ID, Windows Hello eller fingeravtryck i stället för
                    lösenordet, på den här enheten.
                </p>

                @if (_passkeys is { Count: > 0 })
                {
                    <ul class="list" aria-label="Registrerade enheter">
                        @foreach (var passkey in _passkeys)
                        {
                            <li class="list-item">
                                <span class="list-name">@passkey.DeviceLabel</span>
                                <button type="button" class="btn btn-secondary"
                                        disabled="@(_busyPasskeyId == passkey.Id)"
                                        @onclick="() => RemovePasskeyAsync(passkey.Id)">
                                    Ta bort
                                </button>
                            </li>
                        }
                    </ul>
                }

                @if (_passkeyMessage is { } passkeyMessage)
                {
                    <div class="notice notice-problem" role="alert">@passkeyMessage</div>
                }

                <button type="button" class="btn btn-primary" disabled="@_passkeyBusy" @onclick="AddPasskeyAsync">
                    @(_passkeyBusy ? "Ett ögonblick…" : "Lägg till den här enheten")
                </button>
            }
        </div>
    }
}

@code {
    private static readonly (string Value, string Label)[] PresentationOptions =
    [
        ("Text", "Text (standard) - kompakt lista"),
        ("ImageAndText", "Bild + text - med bilder för tydlighet"),
        ("LargeText", "Stor text - större och tydligare"),
        ("ImageAndLargeText", "Bild + stor text - bilder och större text tillsammans"),
        ("OneAtATime", "En uppgift åt gången - fokusläge"),
        ("OneAtATimeImageAndLargeText", "En uppgift åt gången med bild och stor text - extra tydligt fokusläge")
    ];

    private static readonly (string Value, string Label)[] MotivationOptions =
    [
        ("None", "Ingen - bara fakta"),
        ("Calm", "Lugn - en vänlig kommentar då och då")
    ];

    /// <summary>"Beslut: Ångra och stabil lista" §B11 - one press sets everything A2/B3/B5/B8
    /// already built, but reads as an ordinary app choice: no name here says who a preset is
    /// for, only what it does. A press only fills in the radios/toggles below (nothing saved
    /// until "Spara") EXCEPT CalmScreen, which - like the rest of "Lugnare skärm" - always
    /// applies immediately, preset or not (it has no "unsaved" state to begin with; see
    /// ToggleCalmScreenAsync).</summary>
    private sealed record Preset(string Label, string Presentation, string Motivation, bool ShowTimeLevel, bool CalmScreen);

    private static readonly Preset[] Presets =
    [
        new("Kompakt", "Text", "None", ShowTimeLevel: false, CalmScreen: false),
        new("Tydlig", "ImageAndText", "None", ShowTimeLevel: true, CalmScreen: false),
        new("Steg för steg", "OneAtATime", "Calm", ShowTimeLevel: true, CalmScreen: true)
    ];

    /// <summary>Which preset (if any) the CURRENT combination happens to match - recomputed on
    /// every render rather than remembered from the last chip pressed, so changing a single
    /// radio or toggle by hand correctly drops the "active" highlight instead of leaving a
    /// stale chip lit for a combination that no longer matches it.</summary>
    private Preset? ActivePreset => Presets.FirstOrDefault(preset =>
        preset.Presentation == _presentation && preset.Motivation == _motivation
        && preset.ShowTimeLevel == _showTimeLevel && preset.CalmScreen == _calmScreen);

    private static readonly (string Value, string Label)[] ThemeOptions =
    [
        ("system", "Följ enhetens systeminställning"),
        ("light", "Ljust"),
        ("dark", "Mörkt")
    ];

    private sealed class PasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private string? _presentation;
    private string? _motivation;
    private bool _showTimeLevel;
    private string? _message;
    private bool _busy;

    private string _theme = "system";
    private bool _calmScreen;

    private readonly PasswordForm _passwordForm = new();
    private List<string> _passwordMessages = [];
    private bool _passwordBusy;
    private bool _passwordChanged;

    private bool _passkeySupported;
    private bool _passkeyCheckDone;
    private IReadOnlyList<PasskeyResponse>? _passkeys;
    private string? _passkeyMessage;
    private bool _passkeyBusy;
    private string? _busyPasskeyId;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();
        _theme = await Theme.GetAsync(JS);
        _calmScreen = await CalmScreen.GetAsync(JS);

        // Never let a failure here (a flaky network call, an unsupported browser quirk) break
        // the rest of the page - this whole block used to run unguarded and could silently take
        // the "Byt lösenord" card above down with it if ListPasskeysAsync threw.
        try
        {
            _passkeySupported = await WebAuthn.IsAvailableAsync();

            if (_passkeySupported)
            {
                _passkeys = await Api.ListPasskeysAsync();
            }
        }
        catch (HttpRequestException)
        {
            _passkeyMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _passkeyCheckDone = true;
        }
    }

    private async Task LoadAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        var preference = await Api.GetPreferenceAsync(householdId, memberId);
        _presentation = preference?.Presentation ?? "Text";
        _motivation = preference?.Motivation ?? "None";
        _showTimeLevel = preference?.ShowTimeLevel ?? false;
    }

    private async Task SetThemeAsync(string choice)
    {
        _theme = choice;
        await Theme.SetAsync(JS, choice);
    }

    private async Task ApplyPresetAsync(Preset preset)
    {
        _presentation = preset.Presentation;
        _motivation = preset.Motivation;
        _showTimeLevel = preset.ShowTimeLevel;
        _calmScreen = preset.CalmScreen;
        await CalmScreen.SetAsync(JS, preset.CalmScreen);
    }

    private async Task ToggleCalmScreenAsync(ChangeEventArgs e)
    {
        _calmScreen = (bool)e.Value!;
        await CalmScreen.SetAsync(JS, _calmScreen);
    }

    private async Task SaveAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId }
            || _presentation is null || _motivation is null)
        {
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            if (!await Api.SetPreferenceAsync(householdId, memberId, _presentation, _motivation, _showTimeLevel))
            {
                _message = "Det gick inte att spara. Försök igen.";
            }
            else
            {
                // Applies immediately in this tab, rather than only after the next reload -
                // MainLayout only re-checks the preference on sign-in, not on every save here.
                await TextSize.ApplyAsync(JS, PresentationModes.IsLargeText(_presentation));
            }
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _passwordChanged = false;
        _passwordMessages = [];

        if (_passwordForm.NewPassword != _passwordForm.ConfirmPassword)
        {
            _passwordMessages = ["De nya lösenorden stämmer inte överens."];
            return;
        }

        _passwordBusy = true;

        try
        {
            var errors = await Api.ChangePasswordAsync(_passwordForm.CurrentPassword, _passwordForm.NewPassword);

            if (errors.Count > 0)
            {
                _passwordMessages = [.. errors];
                return;
            }

            _passwordChanged = true;
            _passwordForm.CurrentPassword = string.Empty;
            _passwordForm.NewPassword = string.Empty;
            _passwordForm.ConfirmPassword = string.Empty;
        }
        catch (HttpRequestException)
        {
            _passwordMessages = ["Vi når inte servern just nu. Försök igen om en stund."];
        }
        finally
        {
            _passwordBusy = false;
        }
    }

    private async Task AddPasskeyAsync()
    {
        _passkeyBusy = true;
        _passkeyMessage = null;

        try
        {
            var optionsJson = await Api.GetPasskeyRegisterOptionsAsync();

            if (optionsJson is null)
            {
                _passkeyMessage = "Vi når inte servern just nu. Försök igen om en stund.";
                return;
            }

            var attestationJson = await WebAuthn.RegisterAsync(optionsJson);

            if (attestationJson is null)
            {
                _passkeyMessage = "Det gick inte att lägga till enheten.";
                return;
            }

            var errors = await Api.VerifyPasskeyRegisterAsync(attestationJson);

            if (errors.Count > 0)
            {
                _passkeyMessage = errors[0];
                return;
            }

            _passkeys = await Api.ListPasskeysAsync();
        }
        catch (HttpRequestException)
        {
            _passkeyMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _passkeyBusy = false;
        }
    }

    private async Task RemovePasskeyAsync(string credentialId)
    {
        _busyPasskeyId = credentialId;
        _passkeyMessage = null;

        try
        {
            if (await Api.DeletePasskeyAsync(credentialId))
            {
                _passkeys = await Api.ListPasskeysAsync();
            }
            else
            {
                _passkeyMessage = "Det gick inte att ta bort enheten. Försök igen.";
            }
        }
        catch (HttpRequestException)
        {
            _passkeyMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busyPasskeyId = null;
        }
    }
}
