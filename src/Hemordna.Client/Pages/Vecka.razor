@page "/vecka"
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject TimeProvider TimeProvider

<PageTitle>Vecka – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar...</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="LoadAsync" />
}
else if (_household is null || _member is null)
{
    <p class="muted">Hämtar veckan...</p>
}
else
{
    <h1>Vecka</h1>

    <div class="week-grid-wrap">
        <table class="week-grid">
            <thead>
                <tr>
                    <th scope="col"></th>
                    @foreach (var day in WeekDays)
                    {
                        <th scope="col" class="@(day == Today ? "week-grid-today" : null)">
                            @day.ToString("ddd", SwedishCulture)
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var member in _household.Members.Where(m => m.IsActive))
                {
                    <tr>
                        <th scope="row">@member.DisplayName</th>
                        @foreach (var day in WeekDays)
                        {
                            <td class="@(day == Today ? "week-grid-today" : null)">
                                <span class="dot @DotClass(member.Id, day)"
                                      title="@DotTitle(member.Id, day)"></span>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="vecka-section-heading">Min vecka</h2>
    <p class="muted small">Hur mycket tid du normalt brukar ha, dag för dag.</p>

    <ul class="list" aria-label="Veckans normala tid">
        @foreach (var day in Weekdays(_member))
        {
            <li class="list-item">
                <span class="list-name">@day.Label</span>
                <span class="list-meta muted small">@day.MinutesLabel</span>
            </li>
        }
    </ul>

    <details class="more-options">
        <summary>Vill du fördela om dagarna?</summary>
        <p class="muted small">
            Sprider om återkommande uppgifter över veckans (eller månadens) dagar, så inte allt
            landar samma dag - t.ex. för att flera rum sattes upp i samma veva. Uppgifter i
            samma rum hålls ihop på sin egen dag; det är bara vilken dag som ändras, redan
            schemalagda uppgifter påverkas inte.
        </p>

        @if (_rebalanceMessage is { } rebalanceMessage)
        {
            <div class="notice" role="status">@rebalanceMessage</div>
        }

        <button type="button" class="btn btn-secondary" disabled="@_rebalancing" @onclick="RebalanceScheduleAsync">
            @(_rebalancing ? "Fördelar om..." : "Fördela om dagarna")
        </button>
    </details>

    <details class="more-options" @ontoggle="OnPeekToggled">
        <summary>Se någon annans dag</summary>
        <p class="muted small">
            En titt på i morgon, eller på någon annans dag - bara för att se, inget går att
            bocka av eller skjuta upp härifrån.
        </p>

        @if (_householdMembers is { Count: > 0 })
        {
            <label class="field">
                <span>Vems dag?</span>
                <select @bind="_peekMemberId" @bind:after="LoadPeekDayAsync">
                    @foreach (var peekable in _householdMembers)
                    {
                        <option value="@peekable.Id">
                            @(peekable.Id == Session.Me!.MemberId ? "Jag" : peekable.DisplayName)
                        </option>
                    }
                </select>
            </label>

            <label class="field">
                <span>Vilken dag?</span>
                <select @bind="_peekDayOffset" @bind:after="LoadPeekDayAsync">
                    <option value="0">Idag</option>
                    <option value="1">Imorgon</option>
                </select>
            </label>

            @if (_peekBusy)
            {
                <p class="muted small">Hämtar...</p>
            }
            else if (_peekDay is { } peekDay)
            {
                @if (peekDay.Items.Count == 0 && peekDay.Completed.Count == 0)
                {
                    <div class="notice">Inget inplanerat den dagen.</div>
                }
                else
                {
                    <ul class="task-list" aria-label="Den valda dagen">
                        @foreach (var done in peekDay.Completed)
                        {
                            <li class="task task-done">
                                <span class="task-check task-check-done" aria-hidden="true">✓</span>
                                <span class="task-name">@done.Name</span>
                            </li>
                        }
                        @foreach (var item in peekDay.Items)
                        {
                            <li class="task">
                                <span class="task-check" aria-hidden="true"></span>
                                <span class="task-name">
                                    @item.Name
                                    @if (item.IsOverdue)
                                    {
                                        <span class="task-note muted small">sedan tidigare</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>

                    <p class="muted small">
                        Totalt: @(peekDay.PlannedMinutes + peekDay.CompletedMinutes) min
                    </p>
                }
            }
        }
    </details>
}

@code {
    private HouseholdResponse? _household;
    private HouseholdMemberResponse? _member;
    private readonly Dictionary<(Guid MemberId, DateOnly Date), string> _weeklyStatus = [];

    private IReadOnlyList<HouseholdMemberResponse>? _householdMembers;
    private Guid _peekMemberId;
    private int _peekDayOffset;
    private DailyPlanResponse? _peekDay;
    private bool _peekBusy;

    private string? _rebalanceMessage;
    private bool _rebalancing;

    private static readonly System.Globalization.CultureInfo SwedishCulture = new("sv-SE");

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        _household = await Api.GetHouseholdAsync(householdId);
        _member = _household?.Members.FirstOrDefault(m => m.Id == memberId);

        _weeklyStatus.Clear();
        foreach (var status in await Api.GetWeeklyStatusAsync(householdId, Today))
        {
            _weeklyStatus[(status.MemberId, status.Date)] = status.Status;
        }
    }

    private static IEnumerable<(string Label, string MinutesLabel)> Weekdays(HouseholdMemberResponse member)
    {
        var budget = member.WeeklyTimeBudgetMinutes;
        yield return ("Måndag", MinutesLabelFor(budget.Monday));
        yield return ("Tisdag", MinutesLabelFor(budget.Tuesday));
        yield return ("Onsdag", MinutesLabelFor(budget.Wednesday));
        yield return ("Torsdag", MinutesLabelFor(budget.Thursday));
        yield return ("Fredag", MinutesLabelFor(budget.Friday));
        yield return ("Lördag", MinutesLabelFor(budget.Saturday));
        yield return ("Söndag", MinutesLabelFor(budget.Sunday));
    }

    private static string MinutesLabelFor(int minutes) => minutes == 0 ? "Ingen tid" : $"{minutes} min";

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    /// <summary>Monday through Sunday of the week containing today.</summary>
    private IReadOnlyList<DateOnly> WeekDays
    {
        get
        {
            var offsetFromMonday = Today.DayOfWeek == DayOfWeek.Sunday ? 6 : (int)Today.DayOfWeek - 1;
            var monday = Today.AddDays(-offsetFromMonday);
            return [.. Enumerable.Range(0, 7).Select(monday.AddDays)];
        }
    }

    private string DotClass(Guid memberId, DateOnly date) => _weeklyStatus.GetValueOrDefault((memberId, date)) switch
    {
        "Done" => "dot-done",
        "Planned" => "dot-planned",
        _ => "dot-none"
    };

    private string DotTitle(Guid memberId, DateOnly date) => _weeklyStatus.GetValueOrDefault((memberId, date)) switch
    {
        "Done" => "Klart",
        "Planned" => "Planerat",
        _ => "Inget planerat"
    };

    private async Task RebalanceScheduleAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _rebalancing = true;
        _rebalanceMessage = null;

        try
        {
            if (await Api.RebalanceScheduleAsync(householdId) is { } result)
            {
                _rebalanceMessage = result.ChangedTaskCount switch
                {
                    0 => "Redan bra utspritt - ingenting att ändra.",
                    1 => "En uppgift flyttades till en annan dag.",
                    _ => $"{result.ChangedTaskCount} uppgifter flyttades till andra dagar."
                };
                await LoadAsync();
            }
        }
        finally
        {
            _rebalancing = false;
        }
    }

    /// <summary>
    /// Loads the household's member list the first time "Se någon annans dag" is opened,
    /// rather than on every visit to Vecka - most people will never open it.
    /// </summary>
    private async Task OnPeekToggled()
    {
        if (_householdMembers is not null || Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        _householdMembers = _household?.Members.Where(m => m.IsActive).ToList() ?? [];
        _peekMemberId = memberId;
        await LoadPeekDayAsync();
    }

    private async Task LoadPeekDayAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId } || _peekMemberId == Guid.Empty)
        {
            return;
        }

        _peekBusy = true;

        try
        {
            _peekDay = await Api.GetDailyPlanAsync(householdId, _peekMemberId, Today.AddDays(_peekDayOffset));
        }
        finally
        {
            _peekBusy = false;
        }
    }
}
