@page "/mer"
@inject HemordnaSession Session
@inject NavigationManager Navigation

<PageTitle>Mer – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar...</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else
{
    <h1>Mer</h1>

    <ul class="list" aria-label="Fler sidor">
        @foreach (var item in Items)
        {
            <li class="list-item">
                <a href="@item.Href" class="list-name">
                    <span aria-hidden="true">@item.Icon</span> @item.Label
                </a>
            </li>
        }
    </ul>

    <button type="button" class="btn btn-secondary btn-block" @onclick="SignOutAsync">
        Logga ut
    </button>
}

@code {
    private sealed record MoreItem(string Href, string Label, string Icon);

    private static readonly MoreItem[] Items =
    [
        new("hushall", "Hushåll", "⌂"),
        new("installningar", "Inställningar", "⚙")
    ];

    // Every other page calls this; Mer.razor never did, so it only ever rendered past
    // "Hämtar..." by relying on some other page having already loaded the session first in
    // the same SPA lifetime. A hard reload or a fresh navigation straight to /mer - exactly
    // what an installed PWA does on relaunch - left it stuck on "Hämtar..." forever.
    protected override async Task OnInitializedAsync() => await Session.EnsureLoadedAsync();

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("logga-in");
    }
}
