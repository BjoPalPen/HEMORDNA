@page "/planering"
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject TimeProvider TimeProvider

<PageTitle>Planering – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar...</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="LoadAsync" />
}
else if (_member is null)
{
    <p class="muted">Hämtar din vecka...</p>
}
else
{
    <h1>Min tidsbudget</h1>
    <p class="muted">Din normala tid per veckodag. Ändra den från "Min dag".</p>

    <div class="card">
        <div class="chart" role="img" aria-label="Minuter per veckodag">
            @foreach (var day in Weekdays(_member))
            {
                <div class="chart-column">
                    <div class="chart-bar" style="height: @(BarHeight(day.Minutes))px" title="@day.Minutes min"></div>
                    <span class="chart-value muted small">@day.Minutes</span>
                    <span class="chart-label muted small">@day.Label</span>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <h2>Idag</h2>

        @if (_day is not null)
        {
            <p class="muted small">
                @_day.PlannedMinutes av @_day.AvailableMinutes min planerade idag.
            </p>
        }

        @if (!_editingTime)
        {
            <button type="button" class="btn btn-secondary btn-block" @onclick="ToggleTimeEditor">
                Ändra tid idag
            </button>
        }
        else
        {
            <label class="field">
                <span>Minuter idag</span>
                <input type="number" min="0" max="600" @bind="_minutesToday" />
            </label>
            <button type="button" class="btn btn-primary btn-block" @onclick="SaveTimeAsync">
                Spara för idag
            </button>
            <p class="muted small">Din vanliga vecka påverkas inte.</p>
        }
    </div>
}

@code {
    private HouseholdMemberResponse? _member;
    private DailyPlanResponse? _day;
    private bool _editingTime;
    private int _minutesToday;

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        var household = await Api.GetHouseholdAsync(householdId);
        _member = household?.Members.FirstOrDefault(m => m.Id == memberId);
        _day = await Api.GetDailyPlanAsync(householdId, memberId, Today);
        _minutesToday = _day?.AvailableMinutes ?? 0;
    }

    private void ToggleTimeEditor() => _editingTime = !_editingTime;

    private async Task SaveTimeAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        if (await Api.SetAvailabilityAsync(householdId, memberId, Today, Math.Max(0, _minutesToday)))
        {
            _editingTime = false;
            await LoadAsync();
        }
    }

    private static IEnumerable<(string Label, int Minutes)> Weekdays(HouseholdMemberResponse member)
    {
        var budget = member.WeeklyTimeBudgetMinutes;
        yield return ("Mån", budget.Monday);
        yield return ("Tis", budget.Tuesday);
        yield return ("Ons", budget.Wednesday);
        yield return ("Tor", budget.Thursday);
        yield return ("Fre", budget.Friday);
        yield return ("Lör", budget.Saturday);
        yield return ("Sön", budget.Sunday);
    }

    private static int BarHeight(int minutes) => Math.Clamp(minutes, 0, 180) + 4;
}
