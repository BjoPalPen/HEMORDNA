@page "/omraden"
@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject TimeProvider TimeProvider

<PageTitle>Områden – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar...</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="LoadAsync" />
}
else
{
    <h1>Områden</h1>
    <p class="muted">Delar av hemmet, eller andra grupperingar hushållet väljer. En uppgift behöver inte höra till ett rum.</p>

    <div class="card">
        <h2>Lägg till en våning</h2>
        <p class="muted small">
            Namnge våningen (valfritt) och lägg till de rumstyper som finns där - varje rum får
            en färdig checklista. Ange fler än ett för att skapa flera likadana rum på en gång,
            t.ex. tre sovrum, i stället för att göra det ett i taget.
        </p>

        <EditForm Model="_floorForm" OnValidSubmit="CreateFloorAsync">
            <label class="field">
                <span>Våning (valfritt)</span>
                <InputText @bind-Value="_floorForm.FloorName" placeholder="T.ex. Våning 1" />
            </label>

            @foreach (var row in _floorForm.Rooms)
            {
                <div class="floor-room-row" @key="row">
                    <select @bind="row.TemplateKey" @bind:after="() => row.ExcludedTasks.Clear()" aria-label="Rumstyp">
                        <option value="">Välj rumstyp...</option>
                        @foreach (var template in RoomTemplates.All)
                        {
                            <option value="@template.Key">@template.Label</option>
                        }
                    </select>
                    <input type="number" min="1" max="20" @bind="row.Count" aria-label="Antal" />
                    @if (_floorForm.Rooms.Count > 1)
                    {
                        <button type="button" class="btn btn-secondary" aria-label="Ta bort rummet"
                                @onclick="() => RemoveRoomRow(row)">✕</button>
                    }
                </div>

                @if (RoomTemplates.All.FirstOrDefault(t => t.Key == row.TemplateKey) is { } chosenTemplate)
                {
                    <div class="floor-room-tasks">
                        <p class="muted small">Uppgifter i @chosenTemplate.Label - avmarkera det ni inte vill ha:</p>
                        @foreach (var task in chosenTemplate.Tasks)
                        {
                            <label class="field-check">
                                <input type="checkbox" checked="@(!row.ExcludedTasks.Contains(task.Name))"
                                       @onchange="e => ToggleTask(row, task.Name, (bool)e.Value!)" />
                                <span>@task.Name</span>
                            </label>
                        }
                    </div>
                }
            }

            <button type="button" class="btn btn-secondary" @onclick="AddRoomRow">+ Lägg till fler rum</button>

            @if (_floorMessage is { } floorMessage)
            {
                <div class="notice notice-problem" role="alert">@floorMessage</div>
            }

            <div class="floor-submit">
                <button type="submit" class="btn btn-primary" disabled="@_floorBusy">
                    @(_floorBusy ? "Skapar..." : "Skapa")
                </button>
            </div>
        </EditForm>

        @if (_createdRooms.Count > 0)
        {
            <div class="notice">
                <p><strong>Skapat, uppskattad tid per rum:</strong></p>
                <ul class="list" aria-label="Skapade rum">
                    @foreach (var created in _createdRooms)
                    {
                        <li class="list-item">
                            <span class="list-name">@created.Name</span>
                            <span class="list-meta muted small">@created.Minutes min</span>
                        </li>
                    }
                </ul>
                <p class="muted small">Totalt: @_createdRooms.Sum(r => r.Minutes) min</p>
            </div>
        }
    </div>

    <details class="more-options">
        <summary>Lägg till ett tomt område i stället</summary>

        <div class="card">
            <EditForm Model="_form" OnValidSubmit="CreateAsync">
                <label class="field">
                    <span>Nytt område</span>
                    <InputText @bind-Value="_form.Name" placeholder="T.ex. Hund, Garage" />
                </label>

                @if (_message is { } message)
                {
                    <div class="notice notice-problem" role="alert">@message</div>
                }

                <button type="submit" class="btn btn-primary" disabled="@_busy">
                    @(_busy ? "Lägger till..." : "Lägg till område")
                </button>
            </EditForm>
        </div>
    </details>

    @if (_areas is null)
    {
        <p class="muted">Hämtar områden...</p>
    }
    else if (_areas.Count == 0)
    {
        <div class="notice">Inga områden ännu.</div>
    }
    else
    {
        <ul class="list" aria-label="Områden">
            @foreach (var area in _areas)
            {
                <li class="list-item">
                    <span class="list-name">@area.Name</span>
                    <span class="list-meta muted small">@TaskCountFor(area.Id) uppgifter · @TotalMinutesFor(area.Id) min</span>
                    <button type="button" class="btn btn-secondary" aria-label="@($"Ta bort {area.Name}")"
                            disabled="@(_removingAreaId == area.Id)"
                            @onclick="() => RemoveAreaAsync(area.Id)">
                        Ta bort
                    </button>
                </li>
            }
        </ul>
    }
}

@code {
    private sealed class Form
    {
        public string Name { get; set; } = string.Empty;
    }

    private sealed class FloorRoomRow
    {
        public string TemplateKey { get; set; } = string.Empty;
        public int Count { get; set; } = 1;

        /// <summary>Template tasks left unchecked - everything else is included by default.</summary>
        public HashSet<string> ExcludedTasks { get; } = [];
    }

    private sealed class FloorForm
    {
        public string FloorName { get; set; } = string.Empty;
        public List<FloorRoomRow> Rooms { get; set; } = [new()];
    }

    private readonly Form _form = new();
    private readonly FloorForm _floorForm = new();
    private IReadOnlyList<AreaResponse>? _areas;
    private IReadOnlyList<TaskDefinitionResponse> _tasks = [];
    private string? _message;
    private bool _busy;
    private string? _floorMessage;
    private bool _floorBusy;
    private List<(string Name, int Minutes)> _createdRooms = [];
    private Guid? _removingAreaId;

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        var household = await Api.GetHouseholdAsync(householdId);
        _areas = household?.Areas.Where(area => area.IsActive).ToList() ?? [];
        _tasks = await Api.ListTasksAsync(householdId);
    }

    private int TaskCountFor(Guid areaId) => _tasks.Count(t => t.AreaId == areaId && t.IsActive);

    private int TotalMinutesFor(Guid areaId)
        => _tasks.Where(t => t.AreaId == areaId && t.IsActive).Sum(t => t.EstimatedMinutes);

    private async Task RemoveAreaAsync(Guid areaId)
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _removingAreaId = areaId;

        try
        {
            await Api.DeactivateAreaAsync(householdId, areaId);
            await LoadAsync();
        }
        finally
        {
            _removingAreaId = null;
        }
    }

    private async Task CreateAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _message = "Området behöver ett namn.";
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            if (await Api.AddAreaAsync(householdId, _form.Name) is null)
            {
                _message = "Det gick inte att lägga till området. Försök igen.";
                return;
            }

            _form.Name = string.Empty;
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddRoomRow() => _floorForm.Rooms.Add(new FloorRoomRow());

    private void RemoveRoomRow(FloorRoomRow row) => _floorForm.Rooms.Remove(row);

    private static void ToggleTask(FloorRoomRow row, string taskName, bool included)
    {
        if (included)
        {
            row.ExcludedTasks.Remove(taskName);
        }
        else
        {
            row.ExcludedTasks.Add(taskName);
        }
    }

    private async Task CreateFloorAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        var rows = _floorForm.Rooms.Where(r => !string.IsNullOrEmpty(r.TemplateKey)).ToList();

        if (rows.Count == 0)
        {
            _floorMessage = "Lägg till minst en rumstyp.";
            return;
        }

        _floorBusy = true;
        _floorMessage = null;
        var created = new List<(string Name, int Minutes)>();

        try
        {
            var floor = _floorForm.FloorName.Trim();

            foreach (var row in rows)
            {
                var template = RoomTemplates.All.First(t => t.Key == row.TemplateKey);
                var selectedTasks = template.Tasks.Where(t => !row.ExcludedTasks.Contains(t.Name)).ToList();
                var count = Math.Clamp(row.Count, 1, 20);

                for (var i = 1; i <= count; i++)
                {
                    // A single instance of a room type keeps just its type as the name; more
                    // than one gets numbered so "3 sovrum" does not collide as three "Sovrum".
                    var name = (floor.Length > 0, count > 1) switch
                    {
                        (true, true) => $"{floor} – {template.Label} {i}",
                        (true, false) => $"{floor} – {template.Label}",
                        (false, true) => $"{template.Label} {i}",
                        (false, false) => template.Label
                    };

                    var area = await Api.AddAreaAsync(householdId, name);

                    if (area is null)
                    {
                        continue;
                    }

                    foreach (var task in selectedTasks)
                    {
                        var (recurrence, staleAfterDays) = task.ToScheduling(Today);

                        await Api.CreateTaskAsync(householdId, new CreateTaskRequest(
                            task.Name,
                            task.EstimatedMinutes,
                            Description: null,
                            AreaId: area.Id,
                            Priority: "Normal",
                            DefaultResponsibleMemberId: null,
                            PreferredWeekday: null,
                            CanBeDeferred: true,
                            HasRotatingResponsibility: true,
                            RequiresMultiplePeople: false,
                            Recurrence: recurrence,
                            StaleAfterDays: staleAfterDays));
                    }

                    created.Add((name, selectedTasks.Sum(t => t.EstimatedMinutes)));
                }
            }

            _createdRooms = created;
            _floorForm.FloorName = string.Empty;
            _floorForm.Rooms = [new()];
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _floorMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _floorBusy = false;
        }
    }
}
