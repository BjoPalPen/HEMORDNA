@page "/rum"
@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject TimeProvider TimeProvider

<PageTitle>Rum – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar...</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="LoadAsync" />
}
else
{
    <h1>Rum</h1>

    @if (_areas is null)
    {
        <p class="muted">Hämtar rum...</p>
    }
    else
    {
        @if (Floors.Count > 1)
        {
            <div class="seg" role="tablist" aria-label="Våning">
                @foreach (var floor in Floors)
                {
                    <span role="tab" aria-selected="@(_selectedFloor == floor ? "true" : "false")"
                          class="@(_selectedFloor == floor ? "seg-on" : null)"
                          @onclick="() => _selectedFloor = floor">
                        @(floor ?? "Annat")
                    </span>
                }
            </div>
        }

        <div class="room-tiles">
            @foreach (var area in VisibleAreas)
            {
                <RoomTile Name="@area.Name" TaskCount="@TaskCountFor(area.Id)" WeeklyMinutes="@WeeklyMinutesFor(area.Id)"
                          TodayCount="@TodayCountFor(area.Name)" NextDayLabel="@NextDayLabelFor(area.Name)"
                          PausedUntil="@area.PausedUntil"
                          OnClick="() => OpenRoom(area.Id, area.Name)" />
            }

            @if (_selectedFloor is null)
            {
                <RoomTile Name="Övrigt" TaskCount="@TaskCountFor(null)" WeeklyMinutes="@WeeklyMinutesFor(null)"
                          TodayCount="@TodayCountFor("Övrigt")" NextDayLabel="@NextDayLabelFor("Övrigt")"
                          OnClick='() => OpenRoom(null, "Övrigt")' />
            }

            <button type="button" class="room-tile room-tile-add" @onclick="() => _showNewRoomSheet = true">
                <Icon Name="plus" Size="22" />
                Nytt rum
            </button>
        </div>

        <details class="more-options">
            <summary>Visa tid</summary>
            <p class="muted small">Totalt: @TotalTaskCount uppgifter · @TotalMinutes min</p>
            <p class="muted small">
                Ungefär @WeeklyMinutes min/vecka i praktiken, räknat efter hur ofta varje uppgift
                faktiskt återkommer - en daglig syssla väger mycket mer än en månatlig, till skillnad
                från totalen ovan.
            </p>

            @if (_members.Count > 0)
            {
                <p class="@(WeeklyMinutes > HouseholdWeeklyCapacity ? "notice notice-problem" : "notice")" role="status">
                    Ert hushålls samlade veckokapacitet är @HouseholdWeeklyCapacity min.
                    @if (WeeklyMinutes > HouseholdWeeklyCapacity)
                    {
                        <text>Det är mindre än det uppskattade behovet - en del kommer sannolikt alltid ligga och vänta.</text>
                    }
                    else
                    {
                        <text>Det räcker till det uppskattade behovet, med marginal kvar.</text>
                    }
                </p>
            }
        </details>
    }
}

@if (_openAreaLabel is not null)
{
    <RoomSheet HouseholdId="@_householdId" AreaId="_openAreaId" Label="@(_openAreaLabel ?? string.Empty)"
               AllTasks="@_tasks" Areas="@(_areas ?? [])" Members="@_members"
               IsOpen="_showRoomSheet" IsOpenChanged="isOpen => _showRoomSheet = isOpen"
               OnChanged="LoadAsync" />
}

<BottomSheet Title="Nytt rum" @bind-IsOpen="_showNewRoomSheet">
    <p class="muted small">
        Namnge våningen (valfritt) och lägg till de rumstyper som finns där - varje rum får en
        färdig checklista. Ange fler än ett för att skapa flera likadana rum på en gång, till
        exempel tre sovrum, i stället för att göra det ett i taget.
    </p>

    <EditForm Model="_floorForm" OnValidSubmit="CreateFloorAsync">
        <label class="field">
            <span>Våning (valfritt)</span>
            <InputText @bind-Value="_floorForm.FloorName" placeholder="Till exempel Våning 1" />
        </label>

        @foreach (var row in _floorForm.Rooms)
        {
            <div class="floor-room-row" @key="row">
                <select @bind="row.TemplateKey" @bind:after="() => OnTemplateChanged(row)" aria-label="Rumstyp">
                    <option value="">Välj rumstyp...</option>
                    @foreach (var template in RoomTemplates.All)
                    {
                        <option value="@template.Key">@template.Label</option>
                    }
                </select>
                <input type="number" min="1" max="20" @bind="row.Count" aria-label="Antal" />
                @if (_floorForm.Rooms.Count > 1)
                {
                    <button type="button" class="btn btn-secondary" aria-label="Ta bort rummet"
                            @onclick="() => RemoveRoomRow(row)">✕</button>
                }
            </div>

            @if (RoomTemplates.All.FirstOrDefault(t => t.Key == row.TemplateKey) is { } chosenTemplate)
            {
                <div class="floor-room-tasks">
                    <p class="muted small">Uppgifter i @chosenTemplate.Label - avmarkera det ni inte vill ha:</p>
                    @foreach (var task in chosenTemplate.Tasks)
                    {
                        <label class="field-check">
                            <input type="checkbox" @bind="row.TaskIncluded[task.Name]" />
                            <span>@task.Name</span>
                        </label>
                    }
                </div>

                @if (chosenTemplate.Key == "Bedroom")
                {
                    <BedroomOwnerPicker Count="@Math.Clamp(row.Count, 1, 20)"
                                         OwnerMemberId="row.InstanceOwnerMemberId"
                                         Members="@_members" />
                }
            }
        }

        <button type="button" class="btn btn-secondary" @onclick="AddRoomRow">+ Lägg till fler rum</button>

        @if (_floorMessage is { } floorMessage)
        {
            <div class="notice notice-problem" role="alert">@floorMessage</div>
        }

        <div class="floor-submit">
            <button type="submit" class="btn btn-primary btn-block" disabled="@_floorBusy">
                @(_floorBusy ? "Skapar..." : "Skapa")
            </button>
        </div>
    </EditForm>

    @if (_createdRooms.Count > 0)
    {
        <div class="notice">
            <p><strong>Skapat, uppskattad tid per rum:</strong></p>
            <ul class="list" aria-label="Skapade rum">
                @foreach (var created in _createdRooms)
                {
                    <li class="list-item">
                        <span class="list-name">@created.Name</span>
                        <span class="list-meta muted small">@created.Minutes min</span>
                    </li>
                }
            </ul>
            <p class="muted small">Totalt: @_createdRooms.Sum(r => r.Minutes) min</p>
        </div>
    }

    <details class="more-options">
        <summary>Lägg till ett tomt rum i stället</summary>

        <EditForm Model="_form" OnValidSubmit="CreateAsync">
            <label class="field">
                <span>Rummets namn</span>
                <InputText @bind-Value="_form.Name" placeholder="Till exempel Hund, Garage" />
            </label>

            @if (_message is { } message)
            {
                <div class="notice notice-problem" role="alert">@message</div>
            }

            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @(_busy ? "Lägger till..." : "Lägg till rum")
            </button>
        </EditForm>
    </details>
</BottomSheet>

@code {
    private sealed class Form
    {
        public string Name { get; set; } = string.Empty;
    }

    private sealed class FloorRoomRow
    {
        public string TemplateKey { get; set; } = string.Empty;
        public int Count { get; set; } = 1;

        /// <summary>Whether each template task (by name) is included - true unless unchecked.</summary>
        public Dictionary<string, bool> TaskIncluded { get; } = [];

        /// <summary>1-based bedroom instance number -> owner member id. Empty means shared/rotating.</summary>
        public Dictionary<int, string> InstanceOwnerMemberId { get; } = [];
    }

    private sealed class FloorForm
    {
        public string FloorName { get; set; } = string.Empty;
        public List<FloorRoomRow> Rooms { get; set; } = [new()];
    }

    private readonly Form _form = new();
    private readonly FloorForm _floorForm = new();

    private Guid _householdId;
    private IReadOnlyList<AreaResponse>? _areas;
    private IReadOnlyList<TaskDefinitionResponse> _tasks = [];
    private IReadOnlyList<HouseholdMemberResponse> _members = [];
    private string? _message;
    private bool _busy;
    private string? _floorMessage;
    private bool _floorBusy;
    private List<(string Name, int Minutes)> _createdRooms = [];
    private bool _showNewRoomSheet;

    private string? _selectedFloor;
    private Guid? _openAreaId;
    private string? _openAreaLabel;
    private bool _showRoomSheet;

    private Dictionary<string, int> _todayCountByArea = [];
    private Dictionary<string, string> _nextDayLabelByArea = [];

    private static readonly System.Globalization.CultureInfo SwedishCulture = new("sv-SE");

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        _householdId = householdId;
        var household = await Api.GetHouseholdAsync(householdId);
        _areas = household?.Areas.Where(area => area.IsActive).ToList() ?? [];
        _members = household?.Members.Where(member => member.IsActive).ToList() ?? [];
        _tasks = await Api.ListTasksAsync(householdId);

        _selectedFloor ??= Floors.FirstOrDefault();

        await LoadTodayAndNextAsync(householdId, memberId);
    }

    private List<string?> Floors
    {
        get
        {
            var groups = (_areas ?? []).Select(area => RoomFloors.FloorOf(area.Name)).Distinct().ToList();
            return groups.Count > 1 ? groups : [];
        }
    }

    private IEnumerable<AreaResponse> VisibleAreas
        => Floors.Count == 0 ? (_areas ?? []) : (_areas ?? []).Where(a => RoomFloors.FloorOf(a.Name) == _selectedFloor);

    private void OpenRoom(Guid? areaId, string label)
    {
        _openAreaId = areaId;
        _openAreaLabel = label;
        _showRoomSheet = true;
    }

    private int TodayCountFor(string areaLabel) => _todayCountByArea.GetValueOrDefault(areaLabel);

    private string? NextDayLabelFor(string areaLabel)
        => _todayCountByArea.GetValueOrDefault(areaLabel) > 0 ? null : _nextDayLabelByArea.GetValueOrDefault(areaLabel);

    /// <summary>
    /// "N idag" / "Nästa: ..." on each RoomTile reads the SIGNED-IN member's own plan, not the
    /// whole household's - there is no household-wide "who has what today" query, and asking
    /// per member would multiply the calls below by the member count. The lookahead is capped
    /// at 7 days and shared across every room in one pass (not one lookahead per room), the same
    /// bound and reasoning as Idag's "Nästa: veckodag" - see MinDag.razor.
    /// </summary>
    private async Task LoadTodayAndNextAsync(Guid householdId, Guid memberId)
    {
        var todayPlan = await Api.GetDailyPlanAsync(householdId, memberId, Today);
        _todayCountByArea = (todayPlan?.Items ?? [])
            .GroupBy(item => item.AreaName ?? "Övrigt")
            .ToDictionary(group => group.Key, group => group.Count());

        var roomLabels = (_areas ?? []).Select(a => a.Name).Append("Övrigt").ToList();
        var needed = roomLabels.Where(label => !_todayCountByArea.ContainsKey(label)).ToHashSet();
        _nextDayLabelByArea = [];

        for (var offset = 1; offset <= 7 && needed.Count > 0; offset++)
        {
            var date = Today.AddDays(offset);
            var plan = await Api.GetDailyPlanAsync(householdId, memberId, date);
            var labelsThatDay = (plan?.Items ?? []).Select(item => item.AreaName ?? "Övrigt").ToHashSet();

            foreach (var label in needed.ToList())
            {
                if (labelsThatDay.Contains(label))
                {
                    _nextDayLabelByArea[label] = date.ToString("dddd", SwedishCulture);
                    needed.Remove(label);
                }
            }
        }
    }

    private int TaskCountFor(Guid? areaId) => _tasks.Count(t => t.AreaId == areaId && t.IsActive);

    private int WeeklyMinutesFor(Guid? areaId)
        => TaskWorkload.TotalWeeklyMinutes(_tasks.Where(t => t.AreaId == areaId && t.IsActive));

    private int TotalTaskCount => _tasks.Count(t => t.IsActive);

    private int TotalMinutes => _tasks.Where(t => t.IsActive).Sum(t => t.EstimatedMinutes);

    private int WeeklyMinutes => TaskWorkload.TotalWeeklyMinutes(_tasks.Where(t => t.IsActive));

    private int HouseholdWeeklyCapacity => _members.Sum(member =>
        member.WeeklyTimeBudgetMinutes.Monday + member.WeeklyTimeBudgetMinutes.Tuesday
        + member.WeeklyTimeBudgetMinutes.Wednesday + member.WeeklyTimeBudgetMinutes.Thursday
        + member.WeeklyTimeBudgetMinutes.Friday + member.WeeklyTimeBudgetMinutes.Saturday
        + member.WeeklyTimeBudgetMinutes.Sunday);

    private async Task CreateAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _message = "Rummet behöver ett namn.";
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            if (await Api.AddAreaAsync(householdId, _form.Name) is null)
            {
                _message = "Det gick inte att lägga till rummet. Försök igen.";
                return;
            }

            _form.Name = string.Empty;
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddRoomRow() => _floorForm.Rooms.Add(new FloorRoomRow());

    private void RemoveRoomRow(FloorRoomRow row) => _floorForm.Rooms.Remove(row);

    private static void OnTemplateChanged(FloorRoomRow row)
    {
        row.TaskIncluded.Clear();
        row.InstanceOwnerMemberId.Clear();

        if (RoomTemplates.All.FirstOrDefault(t => t.Key == row.TemplateKey) is { } template)
        {
            foreach (var task in template.Tasks)
            {
                row.TaskIncluded[task.Name] = true;
            }
        }
    }

    private async Task CreateFloorAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        var rows = _floorForm.Rooms.Where(r => !string.IsNullOrEmpty(r.TemplateKey)).ToList();

        if (rows.Count == 0)
        {
            _floorMessage = "Lägg till minst en rumstyp.";
            return;
        }

        _floorBusy = true;
        _floorMessage = null;
        var created = new List<(string Name, int Minutes)>();

        try
        {
            var floor = _floorForm.FloorName.Trim();

            // One value per room/area instance, shared by every task created for it (not one
            // per task) - so a room's own weekly/monthly tasks land together on the same
            // occasion ("the kitchen day" stays one sitting), while different rooms still land
            // on different days from each other. See RoomTemplateTask.ToScheduling. Starting
            // from the household's current area count, not 0, so a second floor set up in its
            // own later submission keeps spreading from where the first one left off, instead
            // of both floors' first rooms colliding on the same day.
            var roomSpreadIndex = _areas?.Count ?? 0;

            foreach (var row in rows)
            {
                var template = RoomTemplates.All.First(t => t.Key == row.TemplateKey);
                var selectedTasks = template.Tasks.Where(t => row.TaskIncluded.GetValueOrDefault(t.Name, true)).ToList();
                var count = Math.Clamp(row.Count, 1, 20);
                var isBedroom = template.Key == "Bedroom";

                for (var i = 1; i <= count; i++)
                {
                    // A single instance of a room type keeps just its type as the name; more
                    // than one gets numbered so "3 sovrum" does not collide as three "Sovrum".
                    var name = (floor.Length > 0, count > 1) switch
                    {
                        (true, true) => $"{floor} – {template.Label} {i}",
                        (true, false) => $"{floor} – {template.Label}",
                        (false, true) => $"{template.Label} {i}",
                        (false, false) => template.Label
                    };

                    var area = await Api.AddAreaAsync(householdId, name);

                    if (area is null)
                    {
                        continue;
                    }

                    Guid? ownerId = isBedroom
                        && row.InstanceOwnerMemberId.TryGetValue(i, out var ownerText)
                        && !string.IsNullOrEmpty(ownerText)
                            ? Guid.Parse(ownerText)
                            : null;

                    var thisRoomsSpreadIndex = roomSpreadIndex++;

                    foreach (var task in selectedTasks)
                    {
                        var (recurrence, staleAfterDays) = task.ToScheduling(Today, thisRoomsSpreadIndex);

                        await Api.CreateTaskAsync(householdId, new CreateTaskRequest(
                            task.Name,
                            task.EstimatedMinutes,
                            Description: null,
                            AreaId: area.Id,
                            Priority: "Normal",
                            DefaultResponsibleMemberId: ownerId,
                            PreferredWeekday: null,
                            CanBeDeferred: true,
                            HasRotatingResponsibility: ownerId is null,
                            RequiresMultiplePeople: false,
                            Recurrence: recurrence,
                            StaleAfterDays: staleAfterDays,
                            RequiresAdult: task.AdultsOnly));
                    }

                    created.Add((name, selectedTasks.Sum(t => t.EstimatedMinutes)));
                }
            }

            _createdRooms = created;
            _floorForm.FloorName = string.Empty;
            _floorForm.Rooms = [new()];
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _floorMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _floorBusy = false;
        }
    }
}
