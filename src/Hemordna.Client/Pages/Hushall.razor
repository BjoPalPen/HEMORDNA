@page "/hushall"
@implements IDisposable
@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject TimeProvider TimeProvider
@inject HouseholdRealtimeClient Realtime
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Hushåll – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar...</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="LoadAsync" />
}
else if (_household is null)
{
    <p class="muted">Hämtar hushållet...</p>
}
else
{
    <!-- Sticky summary once the full header (below) has scrolled past - see
         docs/ARCHITECTURE.md "Beslut: Ny form 2026" §3. Same pattern as MinDag's own
         day-header-collapsed, just the household's name instead of a task count. -->
    <div class="household-header-collapsed" aria-hidden="true">
        <strong>@_household.Name</strong>
    </div>

    <header class="household-header">
        <h1>@_household.Name</h1>
        <p class="muted">
            @ActiveMembers.Count personer · @_household.Areas.Count(a => a.IsActive) rum
            @if (FloorCount > 0)
            {
                <text>· @FloorCount våningar</text>
            }
        </p>
    </header>

    <div class="member-row">
        @foreach (var (member, index) in ActiveMembers.Select((m, i) => (m, i)))
        {
            <button type="button" class="member-avatar-btn" @onclick="() => OpenMember(member)">
                <span class="avatar avatar-lg @(index % 2 == 0 ? "avatar-a" : "avatar-b")" aria-hidden="true">
                    @Initial(member.DisplayName)
                </span>
                <span class="member-name">@member.DisplayName</span>
                <span class="member-role muted small">@RoleLabel(member.Role)</span>
            </button>
        }

        <button type="button" class="member-avatar-btn" @onclick="() => _showInviteSheet = true">
            <span class="avatar avatar-lg avatar-add" aria-hidden="true">
                <Icon Name="plus" Size="20" />
            </span>
            <span class="member-name">Bjud in</span>
        </button>
    </div>

    <div class="card">
        <h2>Veckan</h2>

        <div class="week-grid-wrap">
            <table class="week-grid">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        @foreach (var day in WeekDays)
                        {
                            <th scope="col" class="@(day == Today ? "week-grid-today" : null)">
                                @day.ToString("ddd", SwedishCulture)
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in ActiveMembers)
                    {
                        <tr>
                            <th scope="row">@member.DisplayName</th>
                            @foreach (var day in WeekDays)
                            {
                                <td class="@(day == Today ? "week-grid-today" : null)">
                                    <span class="dot @DotClass(member.Id, day)"
                                          title="@DotTitle(member.Id, day)"></span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (TodaySummary is { } todaySummary)
    {
        <div class="card">
            <div class="ringrow">
                <svg viewBox="0 0 36 36" class="day-ring" aria-hidden="true">
                    <circle cx="18" cy="18" r="15.9155" class="day-ring-track" />
                    <circle cx="18" cy="18" r="15.9155" class="day-ring-fill"
                            stroke-dasharray="@($"{todaySummary.PercentComplete} {100 - todaySummary.PercentComplete}")" />
                </svg>
                <div>
                    <p class="ringrow-title">Idag i hushållet</p>
                    <p class="muted small">@todaySummary.CompletedCount av @todaySummary.TotalCount klara</p>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <h2>Senaste händelser</h2>

        @if (_activity.Count == 0)
        {
            <p class="muted small">Inget avklarat än.</p>
        }
        else
        {
            @foreach (var day in ActivityDays)
            {
                <div class="activity-day">
                    <div class="activity-day-header">
                        @if (day.TotalCount > 0)
                        {
                            <svg viewBox="0 0 36 36" class="day-ring" aria-hidden="true">
                                <circle cx="18" cy="18" r="15.9155" class="day-ring-track" />
                                <circle cx="18" cy="18" r="15.9155" class="day-ring-fill"
                                        stroke-dasharray="@($"{day.PercentComplete} {100 - day.PercentComplete}")" />
                            </svg>
                        }
                        <p class="activity-day-label">
                            <strong>@DayLabel(day.Date)</strong>
                            @if (day.TotalCount > 0)
                            {
                                <span class="muted small">
                                    @day.CompletedCount av @day.TotalCount uppgifter klara i hushållet
                                </span>
                            }
                        </p>
                    </div>

                    <ul class="task-list" aria-label="@($"Händelser {DayLabel(day.Date)}")">
                        @foreach (var activity in day.Activities)
                        {
                            <li class="task">
                                <span class="task-check task-check-done" aria-hidden="true">✓</span>
                                <span class="task-name">@activity.TaskName</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>

    <ul class="list" aria-label="Hushållsinställningar">
        <li class="list-item list-item-flush">
            <button type="button" class="list-row" @onclick="() => _showPauseSheet = true">
                <span>Pausa hushållet</span>
                @if (_household.PausedUntil is not null)
                {
                    <span class="list-row-value">Pausat</span>
                }
                <Icon Name="chevron-right" Size="18" />
            </button>
        </li>
        <li class="list-item list-item-flush">
            <button type="button" class="list-row" @onclick="() => _showRebalanceSheet = true">
                <span>Balansera om vem som gör vad</span>
                <Icon Name="chevron-right" Size="18" />
            </button>
        </li>
        <li class="list-item list-item-flush">
            <a href="installningar" class="list-row">
                <span>Inställningar</span>
                <Icon Name="chevron-right" Size="18" />
            </a>
        </li>
        <li class="list-item list-item-flush">
            <button type="button" class="list-row" @onclick="SignOutAsync">
                <span>Logga ut</span>
            </button>
        </li>
    </ul>
}

@if (_openMember is { } openMember)
{
    <MemberSheet HouseholdId="@_householdId" Member="openMember"
                 IsOpen="_showMemberSheet" IsOpenChanged="isOpen => _showMemberSheet = isOpen"
                 OnChanged="LoadAsync" />
}

<BottomSheet Title="Bjud in" @bind-IsOpen="_showInviteSheet">
    <p class="muted small">
        Ge den här koden till någon i hushållet. De anger den när de skapar sitt eget konto, i
        stället för att starta ett nytt hushåll.
    </p>
    <p class="invite-code" aria-label="Inbjudningskod">@_household?.InviteCode</p>

    @if (_inviteMessage is { } inviteMessage)
    {
        <div class="notice" role="status">@inviteMessage</div>
    }

    <button type="button" class="btn btn-primary btn-block" @onclick="ShareInviteAsync">
        Dela koden
    </button>
    <button type="button" class="btn btn-secondary btn-block" disabled="@_regeneratingInviteCode"
            @onclick="RegenerateInviteCodeAsync">
        @(_regeneratingInviteCode ? "Skapar ny kod..." : "Skapa ny kod")
    </button>
    <p class="muted small">
        En ny kod gör den gamla ogiltig - använd bara om den här har hamnat i fel händer. Ingen
        redan tillagd medlem påverkas.
    </p>

    <details class="more-options">
        <summary>Eller lägg till en medlem utan eget konto</summary>
        <p class="muted small">
            För någon som inte skapar ett eget konto än, t.ex. ett barn - namnet syns i
            hushållet direkt.
        </p>

        <EditForm Model="_form" OnValidSubmit="AddMemberAsync">
            <label class="field">
                <span>Namn</span>
                <InputText @bind-Value="_form.DisplayName" placeholder="T.ex. Bjorn" />
            </label>

            <div class="field">
                <span>Vilken roll har personen i hushållet?</span>
                <div class="level-picker">
                    @foreach (var preset in HouseholdRolePresets.All)
                    {
                        <button type="button"
                                class="@(_form.Role == preset.Role ? "btn btn-primary" : "btn btn-secondary")"
                                @onclick="() => SelectRole(preset.Role)">
                            @preset.Label
                        </button>
                    }
                </div>
                <p class="muted small">Vi räknar ut en rimlig tid för hushållssysslor utifrån rollen - det går att ändra senare.</p>
            </div>

            <details class="more-options">
                <summary>Fler alternativ</summary>
                <div class="field">
                    <span>Ange tid manuellt i stället för en roll</span>
                    <div class="level-picker">
                        @foreach (var level in TimeLevel.All)
                        {
                            <button type="button"
                                    class="@(_form.Role is null && _form.MinutesPerDay == level.Minutes ? "btn btn-primary" : "btn btn-secondary")"
                                    @onclick="() => SelectManualLevel(level.Minutes)">
                                @level.Label
                            </button>
                        }
                    </div>
                </div>
            </details>

            @if (_message is { } message)
            {
                <div class="notice notice-problem" role="alert">@message</div>
            }

            <button type="submit" class="btn btn-primary btn-block" disabled="@_busy">
                @(_busy ? "Lägger till..." : "Lägg till medlem")
            </button>
        </EditForm>
    </details>
</BottomSheet>

<BottomSheet Title="Pausa hushållet" @bind-IsOpen="_showPauseSheet">
    <p class="muted small">
        Ingen ny uppgift skapas åt någon medan hushållet är pausat - bra när alla är bortresta
        tillsammans. Inget hopar sig - pausade dagar hoppas bara över.
    </p>

    @if (_household?.PausedUntil is { } householdPausedUntil)
    {
        <p class="notice" role="status">Hushållet är pausat t.o.m. @householdPausedUntil.ToString("d MMMM", SwedishCulture).</p>
    }

    <label class="field">
        <span>Pausa till och med</span>
        <input type="date" @bind="_householdPauseUntilInput" />
    </label>

    @if (_householdPauseMessage is { } householdPauseMessage)
    {
        <div class="notice notice-problem" role="alert">@householdPauseMessage</div>
    }

    <button type="button" class="btn btn-primary btn-block" disabled="@_householdPauseBusy"
            @onclick="SaveHouseholdPauseAsync">
        @(_householdPauseBusy ? "Sparar..." : "Pausa hushållet")
    </button>
    @if (_household?.PausedUntil is not null)
    {
        <button type="button" class="btn btn-secondary btn-block" disabled="@_householdPauseBusy"
                @onclick="ResumeHouseholdAsync">
            Återuppta nu
        </button>
    }
</BottomSheet>

<BottomSheet Title="Balansera om vem som gör vad" @bind-IsOpen="_showRebalanceSheet">
    <p class="muted small">
        Flyttar bara redan utestående, roterande uppgifter mellan medlemmar - så mycket som
        möjligt lämnas orört - så att var och ens andel av det som återstår att göra matchar
        deras egen tid bättre. Uppgifter som bara en viss person kan eller får göra (t.ex. bara
        vuxna, eller någons eget rum) rörs aldrig.
    </p>

    @if (_rebalanceAssignmentsMessage is { } rebalanceAssignmentsMessage)
    {
        <div class="notice" role="status">@rebalanceAssignmentsMessage</div>
    }

    <button type="button" class="btn btn-primary btn-block" disabled="@_rebalancingAssignments" @onclick="RebalanceAssignmentsAsync">
        @(_rebalancingAssignments ? "Balanserar om..." : "Balansera om vem som gör vad")
    </button>
</BottomSheet>

@code {
    private sealed class Form
    {
        public string DisplayName { get; set; } = string.Empty;
        public HouseholdRole? Role { get; set; }
        public int MinutesPerDay { get; set; }
    }

    private readonly Form _form = new();
    private Guid _householdId;
    private HouseholdResponse? _household;
    private IReadOnlyList<RecentActivityResponse> _activity = [];
    private IReadOnlyList<DailyActivitySummaryResponse> _dailySummaries = [];
    private readonly Dictionary<(Guid MemberId, DateOnly Date), string> _weeklyStatus = [];
    private string? _message;
    private bool _busy;
    private string? _inviteMessage;
    private bool _regeneratingInviteCode;
    private string? _rebalanceAssignmentsMessage;
    private bool _rebalancingAssignments;

    private HouseholdMemberResponse? _openMember;
    private bool _showMemberSheet;
    private bool _showInviteSheet;
    private bool _showPauseSheet;
    private bool _showRebalanceSheet;

    private DateOnly? _householdPauseUntilInput;
    private string? _householdPauseMessage;
    private bool _householdPauseBusy;

    private static readonly System.Globalization.CultureInfo SwedishCulture = new("sv-SE");

    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    private List<HouseholdMemberResponse> ActiveMembers => _household?.Members.Where(m => m.IsActive).ToList() ?? [];

    private int FloorCount => RoomFloors.CountDistinct(_household?.Areas.Where(a => a.IsActive) ?? []);

    private sealed record TodayRing(int CompletedCount, int TotalCount)
    {
        public int PercentComplete => TotalCount > 0 ? (int)Math.Round(100.0 * CompletedCount / TotalCount) : 0;
    }

    private TodayRing? TodaySummary
    {
        get
        {
            var summary = _dailySummaries.FirstOrDefault(s => s.Date == Today);
            return summary is null ? null : new TodayRing(summary.CompletedCount, summary.TotalCount);
        }
    }

    /// <summary>
    /// One day's worth of the recent-activity log, paired with the household-wide (never
    /// per-member - PRODUCT.md §8) count of how much of that day's shared workload got done.
    /// </summary>
    private sealed record ActivityDay(
        DateOnly Date, IReadOnlyList<RecentActivityResponse> Activities, int CompletedCount, int TotalCount)
    {
        public int PercentComplete => TotalCount > 0 ? (int)Math.Round(100.0 * CompletedCount / TotalCount) : 0;
    }

    /// <summary>
    /// Groups the flat activity log by the local calendar day each completion happened on, most
    /// recent day first. A day's <see cref="DailyActivitySummaryResponse"/> (fetched separately,
    /// since it counts ALL of that day's occurrences, not just the ones that made the log's own
    /// item limit) supplies the ring's numbers - falling back to the log's own count only if no
    /// summary came back for that date.
    /// </summary>
    private List<ActivityDay> ActivityDays
        => [.. _activity
            .GroupBy(activity => DateOnly.FromDateTime(activity.CompletedAt.ToLocalTime().DateTime))
            .OrderByDescending(group => group.Key)
            .Select(group =>
            {
                var activities = (IReadOnlyList<RecentActivityResponse>)[.. group];
                var summary = _dailySummaries.FirstOrDefault(s => s.Date == group.Key);

                return new ActivityDay(
                    group.Key, activities,
                    summary?.CompletedCount ?? activities.Count,
                    summary?.TotalCount ?? activities.Count);
            })];

    private string DayLabel(DateOnly date) => date switch
    {
        _ when date == Today => "Idag",
        _ when date == Today.AddDays(-1) => "Igår",
        _ => date.ToString("d MMMM", SwedishCulture)
    };

    /// <summary>Monday through Sunday of the week containing today.</summary>
    private IReadOnlyList<DateOnly> WeekDays
    {
        get
        {
            var offsetFromMonday = Today.DayOfWeek == DayOfWeek.Sunday ? 6 : (int)Today.DayOfWeek - 1;
            var monday = Today.AddDays(-offsetFromMonday);
            return [.. Enumerable.Range(0, 7).Select(monday.AddDays)];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        await LoadAsync();

        if (Session.Me is { HouseholdId: { } householdId })
        {
            Realtime.OccurrencesChanged += OnOccurrencesChanged;
            await Realtime.ConnectAsync(householdId);
        }
    }

    private void OnOccurrencesChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Realtime.OccurrencesChanged -= OnOccurrencesChanged;

    private async Task LoadAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _householdId = householdId;
        _household = await Api.GetHouseholdAsync(householdId);
        _activity = await Api.GetRecentActivityAsync(householdId);
        _dailySummaries = await Api.GetDailyActivitySummaryAsync(householdId);

        if (_openMember is { } openMember)
        {
            _openMember = _household?.Members.FirstOrDefault(m => m.Id == openMember.Id);
        }

        _weeklyStatus.Clear();
        foreach (var status in await Api.GetWeeklyStatusAsync(householdId, Today))
        {
            _weeklyStatus[(status.MemberId, status.Date)] = status.Status;
        }
    }

    private void OpenMember(HouseholdMemberResponse member)
    {
        _openMember = member;
        _showMemberSheet = true;
    }

    private static string RoleLabel(string? role)
    {
        foreach (var preset in HouseholdRolePresets.All)
        {
            if (preset.Role.ToString() == role)
            {
                return preset.Label;
            }
        }

        return "Anpassad tid";
    }

    private async Task RegenerateInviteCodeAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _regeneratingInviteCode = true;
        _inviteMessage = null;

        try
        {
            if (await Api.RegenerateInviteCodeAsync(householdId) is { } updated)
            {
                _household = updated;
                _inviteMessage = "Ny kod skapad. Den gamla koden fungerar inte längre.";
            }
        }
        finally
        {
            _regeneratingInviteCode = false;
        }
    }

    private async Task ShareInviteAsync()
    {
        if (_household is null)
        {
            return;
        }

        var text = $"Gå med i {_household.Name} på Hemordna med koden {_household.InviteCode}";
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/share.js");
        var shared = await module.InvokeAsync<bool>("shareOrCopy", "Hemordna – inbjudan", text);
        _inviteMessage = shared ? null : "Koden är kopierad.";
    }

    private async Task SaveHouseholdPauseAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId } || _householdPauseUntilInput is not { } until)
        {
            _householdPauseMessage = "Ange ett slutdatum för pausen.";
            return;
        }

        _householdPauseBusy = true;
        _householdPauseMessage = null;

        try
        {
            if (!await Api.PauseHouseholdAsync(householdId, until))
            {
                _householdPauseMessage = "Det gick inte att spara. Försök igen.";
                return;
            }

            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _householdPauseMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _householdPauseBusy = false;
        }
    }

    private async Task ResumeHouseholdAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _householdPauseBusy = true;

        try
        {
            await Api.PauseHouseholdAsync(householdId, until: null);
            await LoadAsync();
        }
        finally
        {
            _householdPauseBusy = false;
        }
    }

    private string DotClass(Guid memberId, DateOnly date) => _weeklyStatus.GetValueOrDefault((memberId, date)) switch
    {
        "Done" => "dot-done",
        "Planned" => "dot-planned",
        _ => "dot-none"
    };

    private string DotTitle(Guid memberId, DateOnly date) => _weeklyStatus.GetValueOrDefault((memberId, date)) switch
    {
        "Done" => "Klart",
        "Planned" => "Planerat",
        _ => "Inget planerat"
    };

    private static string Initial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private void SelectRole(HouseholdRole role)
    {
        _form.Role = role;
        _form.MinutesPerDay = 0;
    }

    private void SelectManualLevel(int minutes)
    {
        _form.Role = null;
        _form.MinutesPerDay = minutes;
    }

    private async Task AddMemberAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.DisplayName))
        {
            _message = "Medlemmen behöver ett namn.";
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            var budget = _form.Role is { } role
                ? HouseholdRolePresets.BudgetFor(role)
                : _form.MinutesPerDay > 0
                    ? new WeeklyTimeBudgetContract(
                        _form.MinutesPerDay, _form.MinutesPerDay, _form.MinutesPerDay, _form.MinutesPerDay,
                        _form.MinutesPerDay, _form.MinutesPerDay, _form.MinutesPerDay)
                    : null;

            if (await Api.AddMemberAsync(householdId, _form.DisplayName.Trim(), budget, _form.Role?.ToString()) is null)
            {
                _message = "Det gick inte att lägga till medlemmen. Försök igen.";
                return;
            }

            _form.DisplayName = string.Empty;
            _form.Role = null;
            _form.MinutesPerDay = 0;
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _message = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RebalanceAssignmentsAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _rebalancingAssignments = true;
        _rebalanceAssignmentsMessage = null;

        try
        {
            // Refreshing any role-preset-derived budget first means a household that has not
            // touched a member's role since the preset numbers last changed gets the CURRENT
            // target ratio to rebalance against, not a stale one - see RefreshRolePresetBudgets.
            await Api.RefreshRoleBudgetsAsync(householdId);

            if (await Api.RebalanceAssignmentsAsync(householdId) is { } result)
            {
                _rebalanceAssignmentsMessage = result.ChangedOccurrenceCount switch
                {
                    0 => "Redan bra balanserat - ingenting att ändra.",
                    1 => "En uppgift bytte ansvarig.",
                    _ => $"{result.ChangedOccurrenceCount} uppgifter bytte ansvarig."
                };
                await LoadAsync();
            }
        }
        finally
        {
            _rebalancingAssignments = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("logga-in");
    }
}
