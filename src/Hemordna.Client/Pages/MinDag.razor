@page "/"
@implements IDisposable
@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject HouseholdRealtimeClient Realtime

<PageTitle>Idag – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar din dag…</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="ReloadAsync" />
}
else
{
    var hasDayCounts = _day is { } dayForCounts && (dayForCounts.Items.Count > 0 || dayForCounts.Completed.Count > 0);
    // A remotely-completed row stays counted in _day.Items (see ReconcileRemoteChangeAsync) so
    // it can stay in place visually - completedCount has to add it back in by hand, or "N av M
    // klara" and the progress bar would both undercount until the next full reload. totalCount
    // needs no such adjustment: the row is still counted exactly once, just via Items instead
    // of Completed.
    var completedCount = (_day?.Completed.Count ?? 0) + _remotelyCompletedIds.Count;
    var totalCount = _day is null ? 0 : _day.Items.Count + _day.Completed.Count;

    @if (hasDayCounts)
    {
        <!-- Sticky summary that fades in once the full header (below) has scrolled past - see
             docs/ARCHITECTURE.md "Beslut: Ny form 2026" §3. No minutes here or in the header
             below: DESIGN.md §6a is unconditional on Idag, so this repeats only the same
             qualitative "N av M klara" wording the full header already shows. -->
        <div class="day-header-collapsed" aria-hidden="true">
            <strong>Idag</strong>
            <span>@completedCount av @totalCount klara</span>
        </div>
    }

    <header class="day-header">
        <p class="day-date">@DateLabel</p>
        <h1>@GreetingWord, @Session.Me!.DisplayName!</h1>

        @if (hasDayCounts)
        {
            <p class="muted small day-counts">@completedCount av @totalCount klara</p>
            @if (_motivation == "Calm" && _day is not null)
            {
                <p class="day-encouragement">@EncouragementFor(_day.Items.Count, _day.Completed.Count, totalCount)</p>
            }
            <div class="progress" role="presentation">
                <i style="width:@(totalCount == 0 ? 0 : completedCount * 100 / totalCount)%"></i>
            </div>
        }
    </header>

    @if (_remoteNote is not null)
    {
        <p class="remote-note" role="status">@_remoteNote</p>
    }

    @if (!IsFocusMode && _undo is not null)
    {
        @UndoBar
    }

    @if (_day is null)
    {
        <p class="muted">Hämtar dagens uppgifter…</p>
    }
    else
    {
        @if (IsFocusMode)
        {
            @if (FocusTask is { } focusTask)
            {
                <div class="focus-card">
                    @if (ShowIcons)
                    {
                        <img class="focus-icon" src="@IconSrc(focusTask.Name, focusTask.AreaName)" alt="" width="48" height="48" />
                    }
                    <h2 class="focus-name">@focusTask.Name</h2>
                    @if (focusTask.AreaName is { } focusArea)
                    {
                        <span class="chip">@focusArea</span>
                    }
                    @if (_showTimeLevel && focusTask.EstimatedMinutes > 0)
                    {
                        <span class="chip chip-time">@TimeLevel.LabelFor(focusTask.EstimatedMinutes)</span>
                    }
                    @if (focusTask.IsOverdue)
                    {
                        <p class="muted small">sedan tidigare</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(focusTask.Description))
                    {
                        <p class="muted small focus-description">@focusTask.Description</p>
                    }

                    <div class="focus-actions">
                        <button type="button" class="btn btn-primary btn-block" disabled="@(_busyOccurrence == focusTask.OccurrenceId)"
                                @onclick="() => CompleteAsync(focusTask.OccurrenceId)">
                            Bocka av
                        </button>
                        @if (focusTask.CanBeDeferred)
                        {
                            <button type="button" class="btn btn-secondary btn-block" disabled="@(_busyOccurrence == focusTask.OccurrenceId)"
                                    @onclick="() => DeferAsync(focusTask.OccurrenceId)">
                                Skjut upp till imorgon
                            </button>
                        }
                        @if (FocusOrder.Count > 1)
                        {
                            <button type="button" class="btn btn-link" @onclick="ShowNextFocusTask">
                                Visa nästa
                            </button>
                        }
                    </div>
                </div>

                @if (_undo is not null)
                {
                    @UndoBar
                }
            }
            else
            {
                @CalmState
            }
        }
        else
        {
            @if (_day.Items.Count > 0)
            {
                @if (OverdueItems.Count > 0)
                {
                    @GroupHeading("Sedan tidigare", OutstandingCount(OverdueItems))
                    <ul class="task-list" aria-label="Sedan tidigare">
                        @{
                            var overdueIsCapped = !_showAllOverdue && OverdueItems.Count > OverdueCapThreshold;
                            var visibleOverdue = overdueIsCapped ? OverdueItems.Take(OverdueVisibleCount) : OverdueItems;
                        }
                        @foreach (var row in visibleOverdue)
                        {
                            @if (row.IsRemotelyCompleted)
                            {
                                @RemotelyCompletedRow(row.Item)
                            }
                            else
                            {
                                <TaskListItem Item="row.Item" ShowIcon="ShowIcons" ShowOverdueNote="false" ShowTimeLevel="_showTimeLevel"
                                              IsBusy="_busyOccurrence == row.Item.OccurrenceId"
                                              IsExpanded="_expandedOccurrence == row.Item.OccurrenceId"
                                              OnComplete="CompleteAsync" OnToggleExpand="ToggleExpand" OnDefer="DeferAsync" />
                            }
                        }
                        @if (overdueIsCapped)
                        {
                            <li class="task task-more">
                                … och @(OverdueItems.Count - OverdueVisibleCount) till
                                <button type="button" class="btn btn-link" @onclick="() => _showAllOverdue = true">Visa alla</button>
                                ·
                                <button type="button" class="btn btn-link" disabled="@_rebalanceBusy" @onclick="RebalanceOverdueAsync">
                                    Låt Hemordna sprida ut dem
                                </button>
                            </li>
                        }
                    </ul>
                }

                @if (_rebalanceStatus is not null)
                {
                    <p class="notice" role="status">@_rebalanceStatus</p>
                }

                @foreach (var floorGroup in FloorGroups)
                {
                    @if (floorGroup.Floor is { } floor)
                    {
                        <h2 class="floor-heading">@floor</h2>
                    }
                    @foreach (var group in floorGroup.Rooms)
                    {
                        @GroupHeading(RoomHeadingName(group), OutstandingCount(group.Items))
                        <ul class="task-list" aria-label="@RoomHeadingName(group)">
                            @foreach (var row in group.Items)
                            {
                                @if (row.IsRemotelyCompleted)
                                {
                                    @RemotelyCompletedRow(row.Item)
                                }
                                else
                                {
                                    <TaskListItem Item="row.Item" ShowIcon="ShowIcons" ShowAreaChip="false" ShowTimeLevel="_showTimeLevel"
                                                  IsBusy="_busyOccurrence == row.Item.OccurrenceId"
                                                  IsExpanded="_expandedOccurrence == row.Item.OccurrenceId"
                                                  OnComplete="CompleteAsync" OnToggleExpand="ToggleExpand" OnDefer="DeferAsync" />
                                }
                            }
                        </ul>
                    }
                }
            }
            else
            {
                @CalmState
            }
        }

        <div class="chips">
            <button type="button" class="chip-action @(_day.Unplanned.Count == 0 ? "chip-action-disabled" : null)"
                    aria-disabled="@(_day.Unplanned.Count == 0 ? "true" : "false")"
                    @onclick="OpenUnplannedSheet">
                Flytta till en annan dag
            </button>
            <button type="button" class="chip-action" @onclick="OpenExtraTaskSheetAsync">
                Extra uppgift
            </button>
        </div>

        @if (_unplannedNotice is not null)
        {
            <p class="notice" role="status">@_unplannedNotice</p>
        }

        @if (_day.Completed.Count > 0)
        {
            @GroupHeading("Klart idag", _day.Completed.Count, showKvar: false)
            <ul class="task-list task-list-done" aria-label="Klart idag">
                @foreach (var done in _day.Completed)
                {
                    <li class="task task-done">
                        <span class="task-check task-check-done" aria-hidden="true">
                            <Icon Name="check" Size="18" />
                        </span>
                        @if (ShowIcons)
                        {
                            <img class="task-icon" src="@IconSrc(done.Name, done.AreaName)" alt="" width="24" height="24" />
                        }
                        <span class="task-name">
                            @done.Name
                            @if (done.AreaName is { } doneArea)
                            {
                                <span class="chip">@doneArea</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        }

        <BottomSheet Title="Flytta till en annan dag" @bind-IsOpen="_showUnplannedSheet">
            <p class="muted small">
                Uppgifter som inte fick plats idag och väntar till en annan dag - inget kan
                bockas av eller skjutas upp härifrån.
            </p>
            <ul class="task-list">
                @foreach (var task in _day.Unplanned)
                {
                    <li class="task task-rest">
                        @if (ShowIcons)
                        {
                            <img class="task-icon" src="@IconSrc(task.Name, task.AreaName)" alt="" width="24" height="24" />
                        }
                        <span class="task-name">
                            @task.Name
                            @if (task.AreaName is { } unplannedArea)
                            {
                                <span class="chip">@unplannedArea</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </BottomSheet>

        <BottomSheet Title="Extra uppgift" @bind-IsOpen="_showExtraTaskSheet">
            <p class="muted small">
                Något du vill göra i dag utöver det som redan är inplanerat.
            </p>

            @if (_extraTaskCandidates.Count > 0)
            {
                @foreach (var floorGroup in ExtraTaskFloorGroups)
                {
                    @if (floorGroup.Floor is { } floor)
                    {
                        <h2 class="floor-heading">@floor</h2>
                    }
                    @foreach (var group in floorGroup.Rooms)
                    {
                        @GroupHeading(ExtraTaskRoomHeadingName(group), group.Items.Count, showKvar: false)
                        <ul class="list" aria-label="@ExtraTaskRoomHeadingName(group)">
                            @foreach (var candidate in group.Items)
                            {
                                <li class="list-item list-item-flush">
                                    <button type="button" class="list-row" disabled="@_extraTaskBusy"
                                            @onclick="() => AddExistingExtraTaskAsync(candidate)">
                                        <span>@candidate.Name</span>
                                        <span class="list-row-value">@TimeLabelFor(candidate.EstimatedMinutes)</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                }

                @if (_extraTaskMessage is { } pickedMessage)
                {
                    <div class="notice notice-problem" role="alert">@pickedMessage</div>
                }

                <details class="more-options">
                    <summary>Eller skriv en ny uppgift</summary>
                    @NewExtraTaskForm
                </details>
            }
            else
            {
                @NewExtraTaskForm
            }
        </BottomSheet>
    }
}

@code {
    private DailyPlanResponse? _day;
    private Guid? _busyOccurrence;
    private Guid? _expandedOccurrence;
    private string? _presentation;
    private string? _motivation;
    private bool _showTimeLevel;
    private int _focusOffset;
    private bool _showAllOverdue;
    private bool _rebalanceBusy;
    private string? _rebalanceStatus;
    private string? _unplannedNotice;
    private CancellationTokenSource? _unplannedNoticeCts;

    // "Beslut: Ångra och stabil lista" §B6 - a long "Sedan tidigare" reads as a wall of failure
    // rather than a plan; past this many, only the first few show until asked to see the rest.
    private const int OverdueCapThreshold = 5;
    private const int OverdueVisibleCount = 3;
    private bool _showUnplannedSheet;
    private bool _showExtraTaskSheet;
    private (DateOnly Date, int Count)? _nextPlanned;

    private (Guid OccurrenceId, string Name)? _undo;
    private bool _undoBusy;
    private CancellationTokenSource? _undoCts;

    // "Beslut: Ångra och stabil lista" §B2 - a remote change never redraws the list out from
    // under an interaction already in progress. See HandleRemoteChangeAsync/
    // ReconcileRemoteChangeAsync for how these are used together.
    private readonly HashSet<Guid> _remotelyCompletedIds = [];
    private DateTimeOffset? _lastInteraction;
    private string? _remoteNote;
    private CancellationTokenSource? _remoteNoteCts;
    private CancellationTokenSource? _remoteRetryCts;

    private sealed class ExtraTaskForm
    {
        public string Name { get; set; } = string.Empty;
        public int EstimatedMinutes { get; set; }

        // A <select>'s @bind does not support Guid?/Guid out of the box - kept as the raw
        // string value and parsed at submission time, same convention TaskOptionsSheet's own
        // room picker (_roomAreaId) already uses.
        public string AreaId { get; set; } = string.Empty;
    }

    private readonly ExtraTaskForm _extraForm = new();
    private string? _extraTaskMessage;
    private bool _extraTaskBusy;
    private HouseholdResponse? _household;
    private IReadOnlyList<TaskDefinitionResponse> _extraTaskCandidates = [];

    // "Bild + text" - an individual preference (PRODUCT.md §7), not a household setting.
    private bool ShowIcons => _presentation == "ImageAndText";

    private bool IsFocusMode => _presentation == "OneAtATime";

    /// <summary>One item plus whether a remote reconciliation (see ReconcileRemoteChangeAsync)
    /// marked it done without moving or removing its row - the API contract itself is never
    /// touched, this is purely a client-side rendering concern layered on top of it.</summary>
    private sealed record TaskRow(PlannedTaskResponse Item, bool IsRemotelyCompleted);

    private sealed record TaskGroup(string? AreaName, IReadOnlyList<TaskRow> Items);

    private sealed record FloorGroup(string? Floor, IReadOnlyList<TaskGroup> Rooms);

    private TaskRow ToRow(PlannedTaskResponse item) => new(item, _remotelyCompletedIds.Contains(item.OccurrenceId));

    /// <summary>
    /// Overdue items are pulled into their own leading group regardless of room, so something
    /// already late is never buried inside a room's list further down - see
    /// docs/ARCHITECTURE.md "Rumsgruppering på Min dag". Ordered oldest first
    /// (<see cref="PlannedTaskResponse.OriginalScheduledDate"/>, then name) so that when capped
    /// (§B6) the first <see cref="OverdueVisibleCount"/> really are the oldest, not just
    /// whichever the server happened to list first.
    /// </summary>
    private List<TaskRow> OverdueItems
        => (_day?.Items.Where(item => item.IsOverdue) ?? [])
            .OrderBy(item => item.OriginalScheduledDate)
            .ThenBy(item => item.Name)
            .Select(ToRow)
            .ToList();

    /// <summary>
    /// The rest of today's items (not overdue), grouped by room so the day reads as one room
    /// at a time instead of a random mix - a task with no room ("Övrigt") gets its own group.
    /// <see cref="Enumerable.GroupBy{TSource,TKey}(IEnumerable{TSource},System.Func{TSource,TKey})"/>
    /// preserves each key's first-appearance order, so the room order still reflects
    /// DailyPlanner's own prioritisation (whichever room's tasks it ranked earliest leads) -
    /// this only reorganises the DISPLAY of an already-decided list, never what is planned.
    /// </summary>
    private List<TaskGroup> RoomGroups
        => (_day?.Items.Where(item => !item.IsOverdue) ?? [])
            .Select(ToRow)
            .GroupBy(row => row.Item.AreaName)
            .Select(group => new TaskGroup(group.Key, [.. group]))
            .ToList();

    /// <summary>
    /// RoomGroups clustered by floor (see Support/RoomFloors) - product feedback that same-
    /// floor rooms should "hold together" rather than scatter through the day in whatever order
    /// DailyPlanner happened to rank their tasks. Same first-appearance-order preservation as
    /// RoomGroups itself, one level up: a floor's position reflects its earliest-ranked room,
    /// never an arbitrary (e.g. alphabetical) sort. A household with no "Våning – " naming at
    /// all collapses to one floor-less cluster, so a single-floor home sees no heading added.
    /// </summary>
    private List<FloorGroup> FloorGroups
        => RoomGroups
            .GroupBy(group => group.AreaName is { } areaName ? RoomFloors.FloorOf(areaName) : null)
            .Select(group => new FloorGroup(group.Key, [.. group]))
            .ToList();

    private static string RoomHeadingName(TaskGroup group)
        => group.AreaName is { } areaName ? RoomFloors.RoomNameOf(areaName) : "Övrigt";

    /// <summary>How many rows in a group are still genuinely outstanding - a remotely-completed
    /// row stays in the list (see ReconcileRemoteChangeAsync) but must not count toward "N
    /// kvar" any more than a row already in "Klart idag" would.</summary>
    private static int OutstandingCount(IEnumerable<TaskRow> rows) => rows.Count(row => !row.IsRemotelyCompleted);

    /// <summary>"En uppgift åt gången" (docs/PRODUCT.md §7): the same order the grouped view
    /// would show. A row a remote change just marked done is skipped - it is no longer anyone's
    /// "next" task, remotely completed or not.</summary>
    private List<PlannedTaskResponse> FocusOrder
        => OverdueItems.Concat(RoomGroups.SelectMany(group => group.Items))
            .Where(row => !row.IsRemotelyCompleted)
            .Select(row => row.Item)
            .ToList();

    /// <summary>The task the focus card shows - normally the first outstanding one, but "Visa
    /// nästa" (ShowNextFocusTask) rotates _focusOffset through FocusOrder without changing
    /// anything on the server or on Vecka: purely "let me see a different one for now", reset
    /// back to the start on the next LoadDayAsync (a fresh visit, or the member's own next
    /// action).</summary>
    private PlannedTaskResponse? FocusTask
    {
        get
        {
            var order = FocusOrder;
            return order.Count == 0 ? null : order[_focusOffset % order.Count];
        }
    }

    private void ShowNextFocusTask() => _focusOffset++;

    /// <summary>"Lugn" (Installningar.razor) - one of these four, chosen by state alone, never
    /// randomly: the same day-counts state always reads the same phrase, so it never seems to
    /// change for no reason on a later visit. See docs/DESIGN.md §5 for the "Tillåtet" list
    /// these are drawn from - no idioms, no comparisons between members, no guilt.</summary>
    private static readonly string[] EncouragementPhrases =
    [
        "Det viktigaste är gjort.",
        "En sak i taget räcker.",
        "Här är dina uppgifter för idag."
    ];

    private static string EncouragementFor(int outstanding, int completed, int total)
    {
        if (outstanding == 0 && completed > 0)
        {
            return EncouragementPhrases[0];
        }

        if (completed * 2 >= total && outstanding > 0)
        {
            return EncouragementPhrases[0];
        }

        if (outstanding > 4)
        {
            return EncouragementPhrases[1];
        }

        return EncouragementPhrases[2];
    }

    private static string IconSrc(string taskName, string? areaName) => $"icons/tasks/{TaskIcons.For(taskName, areaName)}.svg";

    /// <summary>A room/status heading with a trailing count - "N kvar" for outstanding work,
    /// just the number for "Klart idag" (nothing left to do there).</summary>
    private static RenderFragment GroupHeading(string name, int count, bool showKvar = true) => @<div class="task-group-heading">
        <span>@name</span>
        <span>@(showKvar ? $"{count} kvar" : count.ToString())</span>
    </div>;

    /// <summary>A row a remote reconciliation marked done (see ReconcileRemoteChangeAsync) -
    /// stays exactly where the outstanding row was, dimmed with a filled check like "Klart
    /// idag"'s own rows, but not a TaskListItem: it is no longer interactive (no swipe, no
    /// expand, nothing left to defer), same as any other completed row.</summary>
    private static RenderFragment RemotelyCompletedRow(PlannedTaskResponse item) => @<li class="task task-done-remote">
        <span class="task-check task-check-done" aria-hidden="true">
            <Icon Name="check" Size="18" />
        </span>
        <span class="task-name">Klar: @item.Name</span>
    </li>;

    /// <summary>Shown directly under the header (or under .focus-card in focus mode) for 8s
    /// after a completion - see ShowUndo. min-height on .undo-bar itself (not a wrapper reserved
    /// regardless of _undo) keeps the row's OWN height stable once it does appear, so it settles
    /// in one clean shift rather than the button/text loading in separately.</summary>
    private RenderFragment UndoBar => @<div class="undo-bar" role="status">
        <span>Klar: @_undo!.Value.Name</span>
        <button type="button" class="btn btn-link" disabled="@_undoBusy" @onclick="UndoAsync">Ångra</button>
    </div>;

    private RenderFragment CalmState => @<div class="calm-state">
        @if (_day is { Items.Count: 0, Completed.Count: > 0 })
        {
            <h2>Dagens uppgifter är klara.</h2>
        }
        else
        {
            <h2>Ledigt idag</h2>
            @if (_nextPlanned is { } next)
            {
                <p class="muted">Nästa: @next.Date.ToString("dddd", SwedishCulture), @next.Count uppgifter</p>
            }
        }
    </div>;

    /// <summary>The free-text path in "Extra uppgift" - a genuinely new, one-off task. Shared
    /// between the "Eller skriv en ny uppgift" disclosure (when there are existing tasks to
    /// pick from instead) and the plain top-level form (when there are none to pick from).</summary>
    private RenderFragment NewExtraTaskForm => @<EditForm Model="_extraForm" OnValidSubmit="AddExtraTaskAsync">
        <label class="field">
            <span>Namn</span>
            <InputText @bind-Value="_extraForm.Name" placeholder="T.ex. Rensa garderoben" />
        </label>

        <div class="field">
            <span>Ungefär hur mycket tid tar det?</span>
            <div class="level-picker">
                @foreach (var level in TimeLevel.All)
                {
                    <button type="button"
                            class="@(_extraForm.EstimatedMinutes == level.Minutes ? "btn btn-primary" : "btn btn-secondary")"
                            @onclick="() => _extraForm.EstimatedMinutes = level.Minutes">
                        @level.Label
                    </button>
                }
            </div>
        </div>

        @if (_household?.Areas.Where(area => area.IsActive).ToList() is { Count: > 0 } activeAreas)
        {
            <label class="field">
                <span>Vilket rum?</span>
                <select @bind="_extraForm.AreaId">
                    <option value="">Övrigt</option>
                    @foreach (var area in activeAreas)
                    {
                        <option value="@area.Id">@area.Name</option>
                    }
                </select>
            </label>
        }

        @if (_extraTaskMessage is { } extraTaskMessage)
        {
            <div class="notice notice-problem" role="alert">@extraTaskMessage</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@_extraTaskBusy">
            @(_extraTaskBusy ? "Lägger till..." : "Lägg till för i dag")
        </button>
    </EditForm>;

    // The date is resolved from an injected clock here at the edge; nothing below reads one.
    // TimeProvider rather than DateTime.Now so the page can be rendered at a fixed date.
    private DateOnly Today => DateOnly.FromDateTime(TimeProvider.GetLocalNow().DateTime);

    private string DateLabel => Today.ToString("dddd d MMMM", SwedishCulture);

    /// <summary>No emoji, time of day picks the word - see docs/DESIGN.md "Idag".</summary>
    private string GreetingWord => TimeProvider.GetLocalNow().Hour switch
    {
        >= 5 and < 10 => "God morgon",
        >= 10 and < 18 => "Hej",
        _ => "God kväll"
    };

    private static readonly System.Globalization.CultureInfo SwedishCulture = new("sv-SE");

    protected override async Task OnInitializedAsync()
    {
        // Wait for the session before the first render decides what to show, otherwise this
        // page would sit on "loading" forever for a signed-out visitor.
        await Session.EnsureLoadedAsync();

        await LoadDayAsync();

        if (Session.Me is { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            var preferenceTask = Api.GetPreferenceAsync(householdId, memberId);
            // Loaded eagerly (not just on "Extra uppgift" open, see OpenExtraTaskSheetAsync)
            // because ShowRemoteNote needs the roster to resolve a completer's display name as
            // soon as the very first realtime event arrives, not just after some other sheet
            // happened to load it first.
            var householdTask = Api.GetHouseholdAsync(householdId);
            await Task.WhenAll(preferenceTask, householdTask);

            var preference = await preferenceTask;
            _presentation = preference?.Presentation;
            _motivation = preference?.Motivation;
            _showTimeLevel = preference?.ShowTimeLevel ?? false;
            _household = await householdTask;

            Realtime.OccurrencesChanged += OnOccurrencesChanged;
            await Realtime.ConnectAsync(householdId);
        }
    }

    /// <summary>Someone else in the household changed something. Unlike every other page, Idag
    /// is a list the member is actively tapping, swiping and expanding rows on - redrawing it
    /// out from under a finger already mid-interaction is exactly the kind of surprise this
    /// revision removes (Del C: a household is normally mixed, and this can fire from any other
    /// member's own action at any moment). See HandleRemoteChangeAsync.</summary>
    private void OnOccurrencesChanged() => InvokeAsync(HandleRemoteChangeAsync);

    /// <summary>
    /// A sheet open, or an interaction within the last 2s, defers reconciliation instead of
    /// applying it: retries itself every 2s (a fresh CancellationTokenSource each time, so a
    /// second remote change arriving mid-wait does not race the first retry) until neither
    /// condition holds any more, then reconciles once against whatever the server's CURRENT
    /// state is - not against every individual change that fired while deferred.
    /// </summary>
    private async Task HandleRemoteChangeAsync()
    {
        if (IsInteractionBusy())
        {
            _remoteRetryCts?.Cancel();
            _remoteRetryCts?.Dispose();
            _remoteRetryCts = new CancellationTokenSource();
            _ = RetryRemoteChangeAfterDelayAsync(_remoteRetryCts.Token);
            return;
        }

        await ReconcileRemoteChangeAsync();
        StateHasChanged();
    }

    private bool IsInteractionBusy()
        => _showUnplannedSheet || _showExtraTaskSheet
            || (_lastInteraction is { } last && TimeProvider.GetUtcNow() - last < TimeSpan.FromSeconds(2));

    private async Task RetryRemoteChangeAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(HandleRemoteChangeAsync);
    }

    /// <summary>
    /// Applies a remote change "in place" instead of the full reload LoadDayAsync does: existing
    /// rows never change order, a row that is no longer outstanding stays exactly where it was
    /// (marked remotely completed) rather than disappearing, and a genuinely new row is appended
    /// to the end of its own room group. _day itself is only ever fully replaced again by the
    /// member's own next action (CompleteAsync/DeferAsync/... all call LoadDayAsync) or by
    /// leaving and reopening the page - see "Beslut: Ångra och stabil lista" §B2.
    /// </summary>
    private async Task ReconcileRemoteChangeAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId } || _day is not { } current)
        {
            return;
        }

        var incoming = await Api.GetDailyPlanAsync(householdId, memberId, Today);

        if (incoming is null)
        {
            return;
        }

        var stillOutstandingIds = new HashSet<Guid>(incoming.Items.Select(item => item.OccurrenceId));
        var previousIds = new HashSet<Guid>(current.Items.Select(item => item.OccurrenceId));

        var mergedItems = new List<PlannedTaskResponse>();
        var newlyCompleted = new List<(string TaskName, Guid? CompletedByMemberId)>();

        foreach (var item in current.Items)
        {
            if (stillOutstandingIds.Contains(item.OccurrenceId))
            {
                mergedItems.Add(item);
                continue;
            }

            // No longer outstanding - completed remotely, or skipped/deferred away. Only an
            // actual completion gets the "done remotely" treatment and keeps its row; anything
            // else just quietly drops out, same as an ordinary reload would already do.
            if (incoming.Completed.FirstOrDefault(done => done.OccurrenceId == item.OccurrenceId) is { } done)
            {
                _remotelyCompletedIds.Add(item.OccurrenceId);
                mergedItems.Add(item);
                newlyCompleted.Add((item.Name, done.CompletedByMemberId));
            }
        }

        // A genuinely new occurrence (scheduled by someone else, or Idag's own occurrence-
        // generation catching up) is appended last - RoomGroups/FloorGroups already group by
        // AreaName and preserve first-appearance order, so appending here is enough; nothing
        // about the grouping itself changes.
        foreach (var item in incoming.Items)
        {
            if (!previousIds.Contains(item.OccurrenceId))
            {
                mergedItems.Add(item);
            }
        }

        // A remotely-completed occurrence stays visible via mergedItems (see above) rather than
        // moving into "Klart idag" - it must not also come along in Completed, or it would be
        // rendered (and counted) twice for the same one task.
        var completedExcludingRemote = incoming.Completed
            .Where(done => !_remotelyCompletedIds.Contains(done.OccurrenceId))
            .ToList();

        _day = current with
        {
            Items = mergedItems,
            Completed = completedExcludingRemote,
            Unplanned = incoming.Unplanned,
            AvailableMinutes = incoming.AvailableMinutes,
            PlannedMinutes = incoming.PlannedMinutes,
            RemainingMinutes = incoming.RemainingMinutes,
            CompletedMinutes = incoming.CompletedMinutes
        };

        if (newlyCompleted.Count > 0)
        {
            ShowRemoteNote(newlyCompleted);
        }
    }

    /// <summary>
    /// "Helena bockade av Diska." is information, never a comparison (Del C: never a count,
    /// never an order between people - just which task, and who). The real display name is
    /// used when the completer is still an active household member; "Någon annan" otherwise
    /// (left the household, or CompletedByMemberId came back null - defensive, not expected in
    /// practice). Disappears after 6s, the same CancellationTokenSource-based pattern ShowUndo
    /// already uses.
    /// </summary>
    private void ShowRemoteNote(IReadOnlyList<(string TaskName, Guid? CompletedByMemberId)> completed)
    {
        if (completed.Count == 1)
        {
            var completerName = completed[0].CompletedByMemberId is { } completedByMemberId
                ? _household?.Members.FirstOrDefault(member => member.Id == completedByMemberId)?.DisplayName
                : null;

            _remoteNote = $"{completerName ?? "Någon annan"} bockade av {completed[0].TaskName}.";
        }
        else
        {
            _remoteNote = $"{completed.Count} uppgifter blev klara av andra.";
        }

        _remoteNoteCts?.Cancel();
        _remoteNoteCts?.Dispose();
        _remoteNoteCts = new CancellationTokenSource();

        _ = HideRemoteNoteAfterDelayAsync(_remoteNoteCts.Token);
    }

    private async Task HideRemoteNoteAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(6), cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _remoteNote = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Realtime.OccurrencesChanged -= OnOccurrencesChanged;
        _undoCts?.Cancel();
        _undoCts?.Dispose();
        _remoteNoteCts?.Cancel();
        _remoteNoteCts?.Dispose();
        _remoteRetryCts?.Cancel();
        _remoteRetryCts?.Dispose();
        _unplannedNoticeCts?.Cancel();
        _unplannedNoticeCts?.Dispose();
    }

    /// <summary>Called after creating a household, when membership has changed.</summary>
    private async Task ReloadAsync()
    {
        await Session.RefreshAsync();
        await LoadDayAsync();
    }

    private async Task LoadDayAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        _day = await Api.GetDailyPlanAsync(householdId, memberId, Today);
        _focusOffset = 0;

        // A full reload supersedes any patched-in state from ReconcileRemoteChangeAsync - it is
        // about to be rebuilt from scratch against the same server truth that state was tracking.
        _remotelyCompletedIds.Clear();
        _remoteNote = null;
        _remoteNoteCts?.Cancel();
        _remoteNoteCts?.Dispose();
        _remoteNoteCts = null;
        _remoteRetryCts?.Cancel();
        _remoteRetryCts?.Dispose();
        _remoteRetryCts = null;

        if (_day is { Items.Count: 0, Completed.Count: 0 })
        {
            _nextPlanned ??= await FindNextPlannedDayAsync(householdId, memberId);
        }
        else
        {
            _nextPlanned = null;
        }
    }

    /// <summary>
    /// No endpoint answers "when is this member's next planned day" directly, so this looks
    /// forward a bounded week at a time via the same per-day call "Idag" already makes -
    /// generating each date's occurrences along the way, exactly like tomorrow's chip in the
    /// old "Tjuvkika" peek already did. Capped at 7 days: a "Nästa: ..." hint only makes sense
    /// as a near-term, this-week thing: further out, "Ledigt idag" stands on its own.
    /// </summary>
    private async Task<(DateOnly, int)?> FindNextPlannedDayAsync(Guid householdId, Guid memberId)
    {
        for (var offset = 1; offset <= 7; offset++)
        {
            var date = Today.AddDays(offset);
            var plan = await Api.GetDailyPlanAsync(householdId, memberId, date);

            if (plan is { Items.Count: > 0 })
            {
                return (date, plan.Items.Count);
            }
        }

        return null;
    }

    private async Task CompleteAsync(Guid occurrenceId)
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _lastInteraction = TimeProvider.GetUtcNow();
        _busyOccurrence = occurrenceId;

        try
        {
            // Looked up before LoadDayAsync replaces _day - Completed items carry a name too,
            // but the occurrence has not moved there yet at this point.
            var name = _day?.Items.FirstOrDefault(item => item.OccurrenceId == occurrenceId)?.Name;

            // Safe to repeat: the server keeps the first completion.
            if (await Api.CompleteOccurrenceAsync(householdId, occurrenceId))
            {
                ShowUndo(occurrenceId, name ?? "uppgiften");
                await LoadDayAsync();
            }
        }
        finally
        {
            _busyOccurrence = null;
        }
    }

    /// <summary>Starts (or restarts, replacing whatever undo offer was already showing) the 8s
    /// window a completion can be undone in - see docs/ARCHITECTURE.md "Beslut: Ångra och
    /// stabil lista". A CancellationTokenSource rather than a raw timer: a second completion
    /// arriving before the first one's 8s are up should cancel the earlier auto-dismiss, not
    /// race it.</summary>
    private void ShowUndo(Guid occurrenceId, string name)
    {
        _undoCts?.Cancel();
        _undoCts?.Dispose();
        _undoCts = new CancellationTokenSource();
        _undo = (occurrenceId, name);

        _ = HideUndoAfterDelayAsync(_undoCts.Token);
    }

    private async Task HideUndoAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(8), cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _undo = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>"Ångra" - only the member who completed it can, and only within the same 15
    /// minutes the domain enforces server-side (TaskOccurrence.Reopen); a rejected attempt just
    /// leaves the row completed, same as if the offer had already expired.</summary>
    private async Task UndoAsync()
    {
        if (_undo is not { OccurrenceId: var occurrenceId } || Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _undoCts?.Cancel();
        _undo = null;
        _undoBusy = true;

        try
        {
            if (await Api.ReopenOccurrenceAsync(householdId, occurrenceId))
            {
                await LoadDayAsync();
            }
        }
        finally
        {
            _undoBusy = false;
        }
    }

    private void ToggleExpand(Guid occurrenceId)
    {
        _lastInteraction = TimeProvider.GetUtcNow();
        _expandedOccurrence = _expandedOccurrence == occurrenceId ? null : occurrenceId;
    }

    private async Task DeferAsync(Guid occurrenceId)
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _lastInteraction = TimeProvider.GetUtcNow();
        _busyOccurrence = occurrenceId;

        try
        {
            if (await Api.DeferOccurrenceAsync(householdId, occurrenceId, Today.AddDays(1)))
            {
                _expandedOccurrence = null;
                await LoadDayAsync();
            }
        }
        finally
        {
            _busyOccurrence = null;
        }
    }

    /// <summary>"Låt Hemordna sprida ut dem" (§B6) - re-anchors the household's recurring tasks
    /// across the week instead of leaving them clustered on whatever day they were first
    /// scheduled or deferred to (RebalanceSchedule). Set after LoadDayAsync, not before - the
    /// reload does not clear this field, so setting it first would just have it overwritten by
    /// nothing; setting it after means the confirmation survives the very reload it is
    /// reporting on, even once "Sedan tidigare" itself has shrunk or emptied.</summary>
    private async Task RebalanceOverdueAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        _rebalanceBusy = true;

        try
        {
            var result = await Api.RebalanceScheduleAsync(householdId);
            await LoadDayAsync();

            if (result is not null)
            {
                _rebalanceStatus = $"{result.ChangedTaskCount} uppgifter fördelades på andra dagar.";
            }
        }
        finally
        {
            _rebalanceBusy = false;
        }
    }

    /// <summary>Opens "Flytta till en annan dag" - a sheet, like "Extra uppgift", counts as busy
    /// for HandleRemoteChangeAsync/IsInteractionBusy so a remote change never reconciles the list
    /// out from under it while it is open.</summary>
    private void OpenUnplannedSheet()
    {
        // "Beslut: Ångra och stabil lista" §B7 - the chip is always here (a predictable layout
        // beats one that reflows depending on what happens to be true today), so tapping it with
        // nothing to move needs its own honest response instead of silently opening an empty
        // sheet or doing nothing at all.
        if (_day is not { Unplanned.Count: > 0 })
        {
            ShowUnplannedNotice();
            return;
        }

        _lastInteraction = TimeProvider.GetUtcNow();
        _showUnplannedSheet = true;
    }

    private void ShowUnplannedNotice()
    {
        _unplannedNotice = "Inget att flytta just nu.";

        _unplannedNoticeCts?.Cancel();
        _unplannedNoticeCts?.Dispose();
        _unplannedNoticeCts = new CancellationTokenSource();

        _ = HideUnplannedNoticeAfterDelayAsync(_unplannedNoticeCts.Token);
    }

    private async Task HideUnplannedNoticeAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), cancellationToken);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _unplannedNotice = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Opens "Extra uppgift" and loads what it needs to offer existing tasks to pick from, not
    /// just the free-text form - every active task the household has, minus whatever is already
    /// part of today's plan (planned, completed or unplanned - re-offering something already on
    /// the list makes no sense). Reloaded fresh on every open rather than cached, so a task
    /// added elsewhere in the meantime shows up.
    /// </summary>
    private async Task OpenExtraTaskSheetAsync()
    {
        _lastInteraction = TimeProvider.GetUtcNow();
        _showExtraTaskSheet = true;
        _extraTaskMessage = null;

        if (Session.Me is not { HouseholdId: { } householdId })
        {
            return;
        }

        var tasksTask = Api.ListTasksAsync(householdId);
        var householdTask = Api.GetHouseholdAsync(householdId);
        await Task.WhenAll(tasksTask, householdTask);

        _household = await householdTask;

        var idsAlreadyToday = new HashSet<Guid>(
            (_day?.Items ?? []).Select(item => item.TaskDefinitionId)
                .Concat((_day?.Completed ?? []).Select(item => item.TaskDefinitionId))
                .Concat((_day?.Unplanned ?? []).Select(item => item.TaskDefinitionId)));

        _extraTaskCandidates = [.. (await tasksTask).Where(task => !idsAlreadyToday.Contains(task.Id))];
    }

    private string? AreaNameFor(Guid? areaId)
        => areaId is { } id ? _household?.Areas.FirstOrDefault(area => area.Id == id)?.Name : null;

    private static string TimeLabelFor(int minutes)
        => TimeLevel.All.First(level => level.Minutes == TimeLevel.ClosestMinutes(minutes)).Label;

    private sealed record ExtraTaskGroup(string? AreaName, IReadOnlyList<TaskDefinitionResponse> Items);

    private sealed record ExtraTaskFloorGroup(string? Floor, IReadOnlyList<ExtraTaskGroup> Rooms);

    /// <summary>Same room/floor grouping as RoomGroups/FloorGroups (see those for the full
    /// reasoning) applied to the "Extra uppgift" pick list instead of today's own plan -
    /// product feedback that a flat list of every candidate task got long and hard to scan
    /// once a household had more than a handful.</summary>
    private List<ExtraTaskGroup> ExtraTaskRoomGroups
        => _extraTaskCandidates
            .GroupBy(task => AreaNameFor(task.AreaId))
            .Select(group => new ExtraTaskGroup(group.Key, [.. group]))
            .ToList();

    private List<ExtraTaskFloorGroup> ExtraTaskFloorGroups
        => ExtraTaskRoomGroups
            .GroupBy(group => group.AreaName is { } areaName ? RoomFloors.FloorOf(areaName) : null)
            .Select(group => new ExtraTaskFloorGroup(group.Key, [.. group]))
            .ToList();

    private static string ExtraTaskRoomHeadingName(ExtraTaskGroup group)
        => group.AreaName is { } areaName ? RoomFloors.RoomNameOf(areaName) : "Övrigt";

    /// <summary>Picking an existing task needs none of AddExtraTaskAsync's own creation step -
    /// just schedule the occurrence it already has everything else for.</summary>
    private async Task AddExistingExtraTaskAsync(TaskDefinitionResponse task)
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId })
        {
            return;
        }

        _extraTaskBusy = true;
        _extraTaskMessage = null;

        try
        {
            if (!await ScheduleForTodayAsync(householdId, memberId, task.Id, task.EstimatedMinutes))
            {
                _extraTaskMessage = "Det gick inte att lägga till uppgiften. Försök igen.";
                return;
            }

            _showExtraTaskSheet = false;
            await LoadDayAsync();
        }
        catch (HttpRequestException)
        {
            _extraTaskMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _extraTaskBusy = false;
        }
    }

    /// <summary>
    /// A one-off task the person wants to do today, on top of what is already planned - not
    /// tied to a room and never repeats, so it needs no recurrence: create the definition
    /// (see Components/RoomSheet.razor's "Ingen - schemaläggs för hand" for the same shape) and schedule
    /// its one and only occurrence for today in the same step, rather than making someone visit
    /// Områden and then find a separate way to put a date on it.
    /// </summary>
    private async Task AddExtraTaskAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId }
            || string.IsNullOrWhiteSpace(_extraForm.Name))
        {
            return;
        }

        _extraTaskBusy = true;
        _extraTaskMessage = null;

        try
        {
            var areaId = string.IsNullOrEmpty(_extraForm.AreaId) ? (Guid?)null : Guid.Parse(_extraForm.AreaId);

            var task = await Api.CreateTaskAsync(householdId, new CreateTaskRequest(
                Name: _extraForm.Name,
                EstimatedMinutes: _extraForm.EstimatedMinutes,
                Description: null,
                AreaId: areaId,
                Priority: "Normal",
                DefaultResponsibleMemberId: memberId,
                PreferredWeekday: null,
                CanBeDeferred: true,
                HasRotatingResponsibility: false,
                RequiresMultiplePeople: false,
                Recurrence: null));

            if (task is null
                || !await ScheduleForTodayAsync(householdId, memberId, task.Id, _extraForm.EstimatedMinutes))
            {
                _extraTaskMessage = "Det gick inte att lägga till uppgiften. Försök igen.";
                return;
            }

            _extraForm.Name = string.Empty;
            _extraForm.EstimatedMinutes = 0;
            _extraForm.AreaId = string.Empty;
            _showExtraTaskSheet = false;
            await LoadDayAsync();
        }
        catch (HttpRequestException)
        {
            _extraTaskMessage = "Vi når inte servern just nu. Försök igen om en stund.";
        }
        finally
        {
            _extraTaskBusy = false;
        }
    }

    /// <summary>Shared tail for both "Extra uppgift" paths (pick an existing task, or write a
    /// new one): schedule the occurrence for today, then widen today's own available time by
    /// exactly what it takes. The planner never invents time it was not told about (a non-
    /// deferrable task that does not fit is still reported as unplanned, not forced in - see
    /// DailyPlanner), so this is what makes an "extra" task actually land on today's list
    /// instead of silently sliding to "till en annan dag".</summary>
    private async Task<bool> ScheduleForTodayAsync(Guid householdId, Guid memberId, Guid taskId, int estimatedMinutes)
    {
        if (!await Api.ScheduleOccurrenceAsync(householdId, taskId, Today, memberId))
        {
            return false;
        }

        await Api.SetAvailabilityAsync(householdId, memberId, Today, (_day?.AvailableMinutes ?? 0) + estimatedMinutes);
        return true;
    }
}
