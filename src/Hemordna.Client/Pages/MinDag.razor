@page "/"
@implements IDisposable
@using Hemordna.Client.Support
@inject HemordnaApiClient Api
@inject HemordnaSession Session
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject HouseholdRealtimeClient Realtime
@inject IJSRuntime JS

<PageTitle>Idag – Hemordna</PageTitle>

@if (!Session.IsLoaded)
{
    <p class="muted">Hämtar din dag…</p>
}
else if (!Session.IsSignedIn)
{
    <Redirect To="logga-in" />
}
else if (Session.NeedsHousehold)
{
    <SkapaHushall OnCreated="ReloadAsync" />
}
else
{
    var hasDayCounts = _day is { } dayForCounts && (dayForCounts.Items.Count > 0 || dayForCounts.Completed.Count > 0);
    // A remotely-completed row stays counted in _day.Items (see ReconcileRemoteChangeAsync) so
    // it can stay in place visually - completedCount has to add it back in by hand, or "N av M
    // klara" and the progress bar would both undercount until the next full reload. totalCount
    // needs no such adjustment: the row is still counted exactly once, just via Items instead
    // of Completed.
    var completedCount = (_day?.Completed.Count ?? 0) + _remotelyCompletedIds.Count;
    var totalCount = _day is null ? 0 : _day.Items.Count + _day.Completed.Count;
    var encouragement = _motivation == "Calm" && _day is not null
        ? EncouragementFor(_day.Items.Count, _day.Completed.Count, totalCount, _startedOccurrenceId is not null)
        : null;

    @if (hasDayCounts)
    {
        <!-- Sticky summary that fades in once the full header (below) has scrolled past - see
             docs/ARCHITECTURE.md "Beslut: Ny form 2026" §3. No minutes here or in the header
             below: DESIGN.md §6a is unconditional on Idag, so this repeats only the same
             qualitative "N av M klara" wording the full header already shows. -->
        <div class="day-header-collapsed" aria-hidden="true">
            <strong>Idag</strong>
            <span>@completedCount av @totalCount klara</span>
        </div>
    }

    <header class="day-header">
        <p class="day-date">@DateLabel</p>
        <h1>@GreetingWord, @Session.Me!.DisplayName!</h1>

        @if (hasDayCounts)
        {
            <p class="muted small day-counts">@completedCount av @totalCount klara</p>
            @if (encouragement is not null)
            {
                <p class="day-encouragement">@encouragement</p>
            }
            <div class="progress" role="presentation">
                <i style="width:@(totalCount == 0 ? 0 : completedCount * 100 / totalCount)%"></i>
            </div>
        }
    </header>

    @if (ShowEnergyPrompt)
    {
        <div class="energy" role="group" aria-label="Hur är orken idag?">
            <span class="energy-label">Hur är orken idag?</span>
            <div class="energy-options">
                @if (_energyChoice is null || _energyExpanded)
                {
                    @foreach (var level in EnergyLevel.All)
                    {
                        <button type="button" class="chip-action @(_energyChoice == level.Label ? "chip-primary" : null)"
                                disabled="@_energyBusy"
                                @onclick="() => SetEnergyAsync(level)">
                            <Icon Name="@EnergyIconFor(level.Label)" Size="18" />
                            @level.Label
                        </button>
                    }
                }
                else
                {
                    <button type="button" class="chip-action chip-primary" @onclick="() => _energyExpanded = true">
                        <Icon Name="@EnergyIconFor(_energyChoice)" Size="18" />
                        @_energyChoice
                    </button>
                }
            </div>
        </div>
        @if (_energyMessage is not null)
        {
            <div class="notice notice-problem" role="alert">@_energyMessage</div>
        }
    }

    @if (_day is { IsDayOff: true })
    {
        <p class="notice" role="status">Du är ledig idag. Inget nytt läggs på dig.</p>
    }

    @if (_remoteNote is not null)
    {
        <p class="remote-note" role="status">@_remoteNote</p>
    }

    @if (!IsFocusMode && _undo is not null)
    {
        @UndoBar
    }

    @if (_day is null)
    {
        <p class="muted">Hämtar dagens uppgifter…</p>
    }
    else
    {
        @if (IsFocusMode)
        {
            @if (FocusTask is { } focusTask)
            {
                <div class="focus-card">
                    @if (_speechAvailable)
                    {
                        <button type="button" class="btn btn-icon focus-speak"
                                aria-label="@(_isSpeaking ? "Tyst" : "Läs upp")"
                                @onclick="() => ToggleSpeakAsync(focusTask)">
                            <Icon Name="@(_isSpeaking ? "speaker-off" : "speaker")" Size="20" />
                        </button>
                    }
                    @if (ShowIcons)
                    {
                        <img class="focus-icon" src="@IconSrc(focusTask.Name, focusTask.AreaName)" alt="" width="48" height="48" />
                    }
                    @if (_startedOccurrenceId == focusTask.OccurrenceId)
                    {
                        <span class="chip chip-primary">Pågår</span>
                    }
                    <h2 class="focus-name">@focusTask.Name</h2>
                    @if (focusTask.AreaName is { } focusArea)
                    {
                        <span class="chip">@focusArea</span>
                    }
                    @if (_showTimeLevel && focusTask.EstimatedMinutes > 0)
                    {
                        <span class="chip chip-time">@TimeLevel.MinutesLabel(focusTask.EstimatedMinutes)</span>
                    }
                    @if (focusTask.IsOverdue)
                    {
                        <p class="muted small">sedan tidigare</p>
                    }
                    @if (TaskSteps.Parse(focusTask.Description) is { } focusSteps)
                    {
                        <ol class="task-steps muted small focus-description">
                            @foreach (var step in focusSteps)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    }
                    else if (!string.IsNullOrWhiteSpace(focusTask.Description))
                    {
                        <p class="muted small focus-description">@focusTask.Description</p>
                    }

                    <div class="focus-actions">
                        <button type="button" class="btn btn-primary btn-block" disabled="@(_busyOccurrence == focusTask.OccurrenceId)"
                                @onclick="() => CompleteAsync(focusTask.OccurrenceId)">
                            <Icon Name="check" Size="20" />
                            Bocka av
                        </button>
                        <button type="button" class="btn btn-secondary btn-block" disabled="@(_busyOccurrence == focusTask.OccurrenceId)"
                                @onclick="() => ToggleStartAsync(focusTask.OccurrenceId)">
                            <Icon Name="play" Size="20" />
                            @(_startedOccurrenceId == focusTask.OccurrenceId ? "Avbryt start" : "Jag börjar nu")
                        </button>
                    </div>

                    @if (focusTask.CanBeDeferred || FocusOrder.Count > 1)
                    {
                        <div class="focus-escape">
                            @if (focusTask.CanBeDeferred)
                            {
                                <button type="button" class="btn btn-link" disabled="@(_busyOccurrence == focusTask.OccurrenceId)"
                                        @onclick="() => DeferAsync(focusTask.OccurrenceId)">
                                    <Icon Name="arrow-right" Size="16" />
                                    Skjut upp till imorgon
                                </button>
                            }
                            @if (FocusOrder.Count > 1)
                            {
                                <button type="button" class="btn btn-link" @onclick="ShowNextFocusTask">
                                    Visa nästa
                                    <Icon Name="chevron-right" Size="16" />
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (_speechAvailable && !_speechHasSwedishVoice)
                {
                    <p class="muted small">Ingen svensk röst hittades på den här enheten.</p>
                }

                @if (_undo is not null)
                {
                    @UndoBar
                }
            }
            else
            {
                @CalmState
            }
        }
        else
        {
            @if (_day.Items.Count > 0)
            {
                @if (OverdueItems.Count > 0)
                {
                    @GroupHeading("Sedan tidigare", OutstandingCount(OverdueItems))
                    <ul class="task-list" aria-label="Sedan tidigare">
                        @{
                            var overdueIsCapped = !_showAllOverdue && OverdueItems.Count > OverdueCapThreshold;
                            var orderedOverdue = WithStartedFirst(OverdueItems);
                            var visibleOverdue = overdueIsCapped ? orderedOverdue.Take(OverdueVisibleCount) : orderedOverdue;
                        }
                        @foreach (var row in visibleOverdue)
                        {
                            @if (row.IsRemotelyCompleted)
                            {
                                @RemotelyCompletedRow(row.Item)
                            }
                            else
                            {
                                <TaskListItem Item="row.Item" Today="Today" ShowIcon="ShowIcons" ShowOverdueNote="false" ShowTimeLevel="_showTimeLevel"
                                              IsBusy="_busyOccurrence == row.Item.OccurrenceId"
                                              IsExpanded="_expandedOccurrence == row.Item.OccurrenceId"
                                              IsStartHere="row.Item.OccurrenceId == StartHereOccurrenceId"
                                              IsStarted="row.Item.OccurrenceId == _startedOccurrenceId"
                                              OnComplete="CompleteAsync" OnToggleExpand="ToggleExpand" OnDefer="DeferAsync" OnToggleStart="ToggleStartAsync" />
                            }
                        }
                        @if (overdueIsCapped)
                        {
                            <li class="task task-more">
                                … och @(OverdueItems.Count - OverdueVisibleCount) till
                                <button type="button" class="btn btn-link" @onclick="() => _showAllOverdue = true">Visa alla</button>
                                ·
                                <button type="button" class="btn btn-link" disabled="@_rebalanceBusy" @onclick="RebalanceOverdueAsync">
                                    Låt Hemordna sprida ut dem
                                </button>
                            </li>
                        }
                    </ul>
                }

                @if (_rebalanceStatus is not null)
                {
                    <p class="notice" role="status">@_rebalanceStatus</p>
                }

                @foreach (var floorGroup in FloorGroups)
                {
                    @if (floorGroup.Floor is { } floor)
                    {
                        <h2 class="floor-heading">@floor</h2>
                    }
                    @foreach (var group in floorGroup.Rooms)
                    {
                        @GroupHeading(RoomHeadingName(group), OutstandingCount(group.Items))
                        <ul class="task-list" aria-label="@RoomHeadingName(group)">
                            @foreach (var row in WithStartedFirst(group.Items))
                            {
                                @if (row.IsRemotelyCompleted)
                                {
                                    @RemotelyCompletedRow(row.Item)
                                }
                                else
                                {
                                    <TaskListItem Item="row.Item" Today="Today" ShowIcon="ShowIcons" ShowAreaChip="false" ShowTimeLevel="_showTimeLevel"
                                                  IsBusy="_busyOccurrence == row.Item.OccurrenceId"
                                                  IsExpanded="_expandedOccurrence == row.Item.OccurrenceId"
                                                  IsStartHere="row.Item.OccurrenceId == StartHereOccurrenceId"
                                                  IsStarted="row.Item.OccurrenceId == _startedOccurrenceId"
                                                  OnComplete="CompleteAsync" OnToggleExpand="ToggleExpand" OnDefer="DeferAsync" OnToggleStart="ToggleStartAsync" />
                                }
                            }
                        </ul>
                    }
                }
            }
            else
            {
                @CalmState
            }
        }

        @if (_isPrinting)
        {
            <!-- "Skriv ut" (denna revision): a plain, print-only rendering of the whole day,
                 gated on _isPrinting (see its own remarks) rather than a CSS-only hide - built
                 independently of IsFocusMode so a focus-mode print still gets the full agenda
                 rather than just the one card the screen itself shows (docs/DESIGN.md §6). Plain
                 <li>s rather than TaskListItem: nothing here is interactive (no swipe, no expand,
                 no buttons), so the real component's own JS/event wiring would be unused weight.
                 A <p>, not an <h1>, for the greeting - SignUpHelper.SignUpAsync (and other tests)
                 locate the page's own greeting via "the one and only <h1> containing this name",
                 and this block existing in the DOM at all outside of _isPrinting would already
                 have broken that invariant once, before the _isPrinting gate was added. -->
            <div class="print-only">
                <p class="print-day-title">@GreetingWord, @Session.Me!.DisplayName!</p>
                <p>@DateLabel</p>

                @if (_day.IsDayOff)
                {
                    <p>Du är ledig idag. Inget nytt läggs på dig.</p>
                }
                else if (_day.Items.Count == 0 && _day.Completed.Count == 0)
                {
                    <p>Ledigt idag.</p>
                }
                else
                {
                    @if (OverdueItems.Count > 0)
                    {
                        <div class="print-room">
                            <p class="print-room-heading">Sedan tidigare</p>
                            <ul>
                                @foreach (var row in OverdueItems)
                                {
                                    @PrintTaskRow(row.Item)
                                }
                            </ul>
                        </div>
                    }

                    @foreach (var floorGroup in FloorGroups)
                    {
                        @if (floorGroup.Floor is { } floor)
                        {
                            <p class="print-floor-heading">@floor</p>
                        }
                        @foreach (var group in floorGroup.Rooms)
                        {
                            <div class="print-room">
                                <p class="print-room-heading">@RoomHeadingName(group)</p>
                                <ul>
                                    @foreach (var row in group.Items)
                                    {
                                        @PrintTaskRow(row.Item)
                                    }
                                </ul>
                            </div>
                        }
                    }

                    @if (_day.Completed.Count > 0)
                    {
                        <div class="print-room">
                            <p class="print-room-heading">Klart idag</p>
                            <ul>
                                @foreach (var done in _day.Completed)
                                {
                                    <li class="print-task print-task-done">@done.Name</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
        }

        <div class="chips">
            <button type="button" class="chip-action @(_day.Unplanned.Count == 0 ? "chip-action-disabled" : null)"
                    aria-disabled="@(_day.Unplanned.Count == 0 ? "true" : "false")"
                    @onclick="OpenUnplannedSheet">
                Flytta till en annan dag
            </button>
            <button type="button" class="chip-action" @onclick="OpenExtraTaskSheetAsync">
                Extra uppgift
            </button>
            <button type="button" class="chip-action" @onclick="() => OpenDayOffSheet(Today)">
                @(_day.IsDayOff ? "Ledig idag" : "Ta ledigt idag")
            </button>
        </div>

        @if (_unplannedNotice is not null)
        {
            <p class="notice" role="status">@_unplannedNotice</p>
        }

        @if (_day.Completed.Count > 0)
        {
            @GroupHeading("Klart idag", _day.Completed.Count, showKvar: false)
            <ul class="task-list task-list-done" aria-label="Klart idag">
                @foreach (var done in _day.Completed)
                {
                    <li class="task task-done">
                        <span class="task-check task-check-done" aria-hidden="true">
                            <Icon Name="check" Size="18" />
                        </span>
                        @if (ShowIcons)
                        {
                            <img class="task-icon" src="@IconSrc(done.Name, done.AreaName)" alt="" width="24" height="24" />
                        }
                        <span class="task-name">
                            @done.Name
                            @if (done.AreaName is { } doneArea)
                            {
                                <span class="chip">@doneArea</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        }

        <button type="button" class="btn btn-link" @onclick="PrintAsync">Skriv ut</button>

        @if (_tomorrow is not null)
        {
            <details class="more-options tomorrow-section">
                <summary>
                    Imorgon
                    @(TomorrowItems.Count > 0 ? $" · {TomorrowItems.Count} uppgifter" : null)
                </summary>

                @if (TomorrowItems.Count == 0)
                {
                    <p class="muted small">Inget planerat imorgon än.</p>
                }
                else
                {
                    <ul class="task-list">
                        @foreach (var item in TomorrowItems)
                        {
                            <li class="task task-rest">
                                @if (ShowIcons)
                                {
                                    <img class="task-icon" src="@IconSrc(item.Name, item.AreaName)" alt="" width="24" height="24" />
                                }
                                <span class="task-name">
                                    @item.Name
                                    @if (item.AreaName is { } tomorrowArea)
                                    {
                                        <span class="chip">@tomorrowArea</span>
                                    }
                                </span>
                                <button type="button" class="btn btn-link" disabled="@(_tomorrowBusyOccurrence == item.OccurrenceId)"
                                        @onclick="() => BringForwardAsync(item.OccurrenceId)">
                                    Gör idag i stället
                                </button>
                            </li>
                        }
                    </ul>
                }

                @if (_tomorrowNotice is not null)
                {
                    <p class="notice notice-problem" role="alert">@_tomorrowNotice</p>
                }

                <button type="button" class="btn btn-link" @onclick="() => OpenDayOffSheet(Today.AddDays(1))">
                    @(_tomorrow.IsDayOff ? "Ledig imorgon" : "Ta ledigt imorgon")
                </button>
            </details>
        }

        <DayOffSheet HouseholdId="HouseholdId" MemberId="MemberId" Date="_dayOffDate" Today="Today" IsCurrentlyOff="DayOffSheetIsCurrentlyOff"
                     @bind-IsOpen="_showDayOffSheet" OnChanged="LoadDayAsync" />

        <BottomSheet Title="Flytta till en annan dag" @bind-IsOpen="_showUnplannedSheet">
            <p class="muted small">
                Uppgifter som inte fick plats idag och väntar till en annan dag - inget kan
                bockas av eller skjutas upp härifrån.
            </p>
            <ul class="task-list">
                @foreach (var task in _day.Unplanned)
                {
                    <li class="task task-rest">
                        @if (ShowIcons)
                        {
                            <img class="task-icon" src="@IconSrc(task.Name, task.AreaName)" alt="" width="24" height="24" />
                        }
                        <span class="task-name">
                            @task.Name
                            @if (task.AreaName is { } unplannedArea)
                            {
                                <span class="chip">@unplannedArea</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        </BottomSheet>

        <BottomSheet Title="Extra uppgift" @bind-IsOpen="_showExtraTaskSheet">
            <p class="muted small">
                Något du vill göra i dag utöver det som redan är inplanerat.
            </p>

            @if (_extraTaskCandidates.Count > 0)
            {
                @foreach (var floorGroup in ExtraTaskFloorGroups)
                {
                    @if (floorGroup.Floor is { } floor)
                    {
                        <h2 class="floor-heading">@floor</h2>
                    }
                    @foreach (var group in floorGroup.Rooms)
                    {
                        @GroupHeading(ExtraTaskRoomHeadingName(group), group.Items.Count, showKvar: false)
                        <ul class="list" aria-label="@ExtraTaskRoomHeadingName(group)">
                            @foreach (var candidate in group.Items)
                            {
                                <li class="list-item list-item-flush">
                                    <button type="button" class="list-row" disabled="@_extraTaskBusy"
                                            @onclick="() => AddExistingExtraTaskAsync(candidate)">
                                        <span>@candidate.Name</span>
                                        <span class="list-row-value">@TimeLabelFor(candidate.EstimatedMinutes)</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                }

                @if (_extraTaskMessage is { } pickedMessage)
                {
                    <div class="notice notice-problem" role="alert">@pickedMessage</div>
                }

                <details class="more-options">
                    <summary>Eller skriv en ny uppgift</summary>
                    @NewExtraTaskForm
                </details>
            }
            else
            {
                @NewExtraTaskForm
            }
        </BottomSheet>
    }
}

@code {
    private DailyPlanResponse? _day;

    /// <summary>"Jag ser min morgondag på Idag" - tomorrow's own plan, shown read-only in its
    /// own collapsed section (see the "Imorgon" details below). Loaded alongside _day so it is
    /// never stale relative to it - see LoadDayAsync.</summary>
    private DailyPlanResponse? _tomorrow;
    private Guid? _tomorrowBusyOccurrence;
    private string? _tomorrowNotice;
    private Guid? _busyOccurrence;

    /// <summary>"Jag kan ... ta ledigt" - which date DayOffSheet is currently open for: either
    /// Today (the chip in .chips) or Today.AddDays(1) (the link inside "Imorgon"). One shared
    /// sheet instance rather than two, since only one can be open at a time anyway.</summary>
    private bool _showDayOffSheet;
    private DateOnly _dayOffDate;
    private Guid? _expandedOccurrence;
    private string? _presentation;
    private string? _motivation;
    private bool _showTimeLevel;
    private int _focusOffset;
    private bool _showAllOverdue;
    private bool _rebalanceBusy;
    private string? _rebalanceStatus;
    private string? _unplannedNotice;
    private CancellationTokenSource? _unplannedNoticeCts;

    // "Beslut: Ångra och stabil lista" §B6 - a long "Sedan tidigare" reads as a wall of failure
    // rather than a plan; past this many, only the first few show until asked to see the rest.
    private const int OverdueCapThreshold = 5;
    private const int OverdueVisibleCount = 3;
    private bool _showUnplannedSheet;
    private bool _showExtraTaskSheet;
    private (DateOnly Date, int Count)? _nextPlanned;

    private (Guid OccurrenceId, string Name)? _undo;
    private bool _undoBusy;
    private CancellationTokenSource? _undoCts;

    // "Jag börjar nu" (Sju enkla lösningar, del 2) - per-device, per-day, one at a time
    // (Support/StartedTask.cs). Reloaded from storage in LoadDayAsync rather than kept purely in
    // memory, so a fresh visit (or a day that has rolled over) always reflects it truthfully.
    private Guid? _startedOccurrenceId;

    // "Hur är orken idag?" (Sju enkla lösningar, del 1) - the label ("Lite"/"Lagom"/"Mycket"),
    // remembered per-device just so the chip reads back correctly (Support/EnergyChoice.cs); the
    // server only ever sees the minutes this produces (SetAvailabilityAsync), never the level
    // itself. _energyExpanded re-opens all three after a choice has already collapsed the row to
    // just the selected chip - purely local UI state, reset on every fresh load.
    private string? _energyChoice;
    private bool _energyExpanded;
    private bool _energyBusy;
    private string? _energyMessage;

    // "Beslut: Ångra och stabil lista" §B2 - a remote change never redraws the list out from
    // under an interaction already in progress. See HandleRemoteChangeAsync/
    // ReconcileRemoteChangeAsync for how these are used together.
    private readonly HashSet<Guid> _remotelyCompletedIds = [];
    private DateTimeOffset? _lastInteraction;
    private string? _remoteNote;
    private CancellationTokenSource? _remoteNoteCts;
    private CancellationTokenSource? _remoteRetryCts;

    private sealed class ExtraTaskForm
    {
        public string Name { get; set; } = string.Empty;
        public int EstimatedMinutes { get; set; }
        public string Description { get; set; } = string.Empty;

        // A <select>'s @bind does not support Guid?/Guid out of the box - kept as the raw
        // string value and parsed at submission time, same convention TaskOptionsSheet's own
        // room picker (_roomAreaId) already uses.
        public string AreaId { get; set; } = string.Empty;
    }

    private readonly ExtraTaskForm _extraForm = new();
    private string? _extraTaskMessage;
    private bool _extraTaskBusy;
    private HouseholdResponse? _household;
    private IReadOnlyList<TaskDefinitionResponse> _extraTaskCandidates = [];

    // "Bild + text" - an individual preference (PRODUCT.md §7), not a household setting.
    private bool ShowIcons => PresentationModes.ShowsImages(_presentation);

    private bool IsFocusMode => PresentationModes.IsFocusMode(_presentation);

    /// <summary>One item plus whether a remote reconciliation (see ReconcileRemoteChangeAsync)
    /// marked it done without moving or removing its row - the API contract itself is never
    /// touched, this is purely a client-side rendering concern layered on top of it.</summary>
    private sealed record TaskRow(PlannedTaskResponse Item, bool IsRemotelyCompleted);

    private sealed record TaskGroup(string? AreaName, IReadOnlyList<TaskRow> Items);

    private sealed record FloorGroup(string? Floor, IReadOnlyList<TaskGroup> Rooms);

    private TaskRow ToRow(PlannedTaskResponse item) => new(item, _remotelyCompletedIds.Contains(item.OccurrenceId));

    /// <summary>
    /// Overdue items are pulled into their own leading group regardless of room, so something
    /// already late is never buried inside a room's list further down - see
    /// docs/ARCHITECTURE.md "Rumsgruppering på Min dag". Ordered oldest first
    /// (<see cref="PlannedTaskResponse.OriginalScheduledDate"/>, then name) so that when capped
    /// (§B6) the first <see cref="OverdueVisibleCount"/> really are the oldest, not just
    /// whichever the server happened to list first.
    /// </summary>
    private List<TaskRow> OverdueItems
        => (_day?.Items.Where(item => item.IsOverdue) ?? [])
            .OrderBy(item => item.OriginalScheduledDate)
            .ThenBy(item => item.Name)
            .Select(ToRow)
            .ToList();

    /// <summary>
    /// The rest of today's items (not overdue), grouped by room so the day reads as one room
    /// at a time instead of a random mix - a task with no room ("Övrigt") gets its own group.
    /// <see cref="Enumerable.GroupBy{TSource,TKey}(IEnumerable{TSource},System.Func{TSource,TKey})"/>
    /// preserves each key's first-appearance order, so the room order still reflects
    /// DailyPlanner's own prioritisation (whichever room's tasks it ranked earliest leads) -
    /// this only reorganises the DISPLAY of an already-decided list, never what is planned.
    /// </summary>
    private List<TaskGroup> RoomGroups
        => (_day?.Items.Where(item => !item.IsOverdue) ?? [])
            .Select(ToRow)
            .GroupBy(row => row.Item.AreaName)
            .Select(group => new TaskGroup(group.Key, [.. group]))
            .ToList();

    /// <summary>
    /// RoomGroups clustered by floor (see Support/RoomFloors) - product feedback that same-
    /// floor rooms should "hold together" rather than scatter through the day in whatever order
    /// DailyPlanner happened to rank their tasks. Same first-appearance-order preservation as
    /// RoomGroups itself, one level up: a floor's position reflects its earliest-ranked room,
    /// never an arbitrary (e.g. alphabetical) sort. A household with no "Våning – " naming at
    /// all collapses to one floor-less cluster, so a single-floor home sees no heading added.
    /// </summary>
    private List<FloorGroup> FloorGroups
        => RoomGroups
            .GroupBy(group => group.AreaName is { } areaName ? RoomFloors.FloorOf(areaName) : null)
            .Select(group => new FloorGroup(group.Key, [.. group]))
            .ToList();

    /// <summary>
    /// Tomorrow's own new work for the "Imorgon" section - excludes anything already on today's
    /// list. DailyPlanner's own eligibility rule is "outstanding and due by this date or
    /// earlier" (see DailyPlanner.IsEligible), so without this an occurrence carried over from
    /// today (still not done) - or one just brought forward onto today via BringForwardAsync -
    /// would show up in BOTH _day and _tomorrow at once.
    /// </summary>
    private List<PlannedTaskResponse> TomorrowItems
    {
        get
        {
            if (_tomorrow is null)
            {
                return [];
            }

            var todayIds = new HashSet<Guid>((_day?.Items ?? []).Select(item => item.OccurrenceId));
            return [.. _tomorrow.Items.Where(item => !todayIds.Contains(item.OccurrenceId))];
        }
    }

    private static string RoomHeadingName(TaskGroup group)
        => group.AreaName is { } areaName ? RoomFloors.RoomNameOf(areaName) : "Övrigt";

    /// <summary>How many rows in a group are still genuinely outstanding - a remotely-completed
    /// row stays in the list (see ReconcileRemoteChangeAsync) but must not count toward "N
    /// kvar" any more than a row already in "Klart idag" would.</summary>
    private static int OutstandingCount(IEnumerable<TaskRow> rows) => rows.Count(row => !row.IsRemotelyCompleted);

    /// <summary>"En uppgift åt gången" (docs/PRODUCT.md §7): the same order the grouped view
    /// would show. A row a remote change just marked done is skipped - it is no longer anyone's
    /// "next" task, remotely completed or not.</summary>
    private List<PlannedTaskResponse> FocusOrder
        => OverdueItems.Concat(RoomGroups.SelectMany(group => group.Items))
            .Where(row => !row.IsRemotelyCompleted)
            .Select(row => row.Item)
            .ToList();

    /// <summary>The task the focus card shows - normally the first outstanding one, but "Visa
    /// nästa" (ShowNextFocusTask) rotates _focusOffset through FocusOrder without changing
    /// anything on the server or on Vecka: purely "let me see a different one for now", reset
    /// back to the start on the next LoadDayAsync (a fresh visit, or the member's own next
    /// action).</summary>
    private PlannedTaskResponse? FocusTask
    {
        get
        {
            var order = FocusOrder;
            return order.Count == 0 ? null : order[_focusOffset % order.Count];
        }
    }

    private void ShowNextFocusTask() => _focusOffset++;

    /// <summary>"Skriv ut" - the browser's own print dialog; app.css's own @@media print rules do
    /// the actual layout switch (nav/chips/etc. hidden, empty squares instead of check buttons -
    /// see docs/DESIGN.md).</summary>
    private async Task PrintAsync()
    {
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/print.js");
        await module.InvokeVoidAsync("printPage");
    }

    /// <summary>True only while the page is actually rendering under print media
    /// (window.matchMedia('print'), see js/print.js) - the print-only block below must not exist
    /// in the DOM at all outside of printing, not just be display:none. It repeats task names and
    /// room headings the live list already shows, and Playwright's text-based locators (used
    /// throughout this test suite, starting with SignUpHelper's own "the one and only &lt;h1&gt;
    /// with this name") match hidden elements exactly as readily as visible ones - a CSS-only
    /// hide would have silently turned "the only element with this text" false on every test that
    /// visits Idag, not just print-specific ones. Found and fixed via the test suite itself, not
    /// reasoned out in advance.</summary>
    private bool _isPrinting;
    private DotNetObjectReference<MinDag>? _printMediaSelfRef;
    private IJSObjectReference? _printMediaHandle;

    [JSInvokable]
    public async Task OnPrintMediaChanged(bool isPrinting)
    {
        _isPrinting = isPrinting;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>"Läs upp" (fokusläget only - it is the one place a single task is the whole
    /// screen). No autouppläsning: the button always starts and stops on a person's own press,
    /// never on its own.</summary>
    private bool _speechAvailable;
    private bool _speechHasSwedishVoice;
    private bool _isSpeaking;
    private DotNetObjectReference<MinDag>? _speechSelfRef;

    private async Task ToggleSpeakAsync(PlannedTaskResponse task)
    {
        if (_isSpeaking)
        {
            await Speech.StopAsync(JS);
            _isSpeaking = false;
            return;
        }

        _isSpeaking = true;
        await Speech.SpeakAsync(JS, _speechSelfRef!, BuildSpeechText(task));
    }

    [JSInvokable]
    public async Task OnSpeechEnded()
    {
        _isSpeaking = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>What "Läs upp" actually says: name, room, "Ungefär N minuter." (only if the
    /// member has chosen to see time at all - ShowTimeLevel), then the description - steps read
    /// as "Steg 1: ...", "Steg 2: ...", an ordinary description read as-is.</summary>
    private string BuildSpeechText(PlannedTaskResponse task)
    {
        var parts = new List<string> { task.Name };

        if (task.AreaName is { } area)
        {
            parts.Add(area);
        }

        if (_showTimeLevel && task.EstimatedMinutes > 0)
        {
            parts.Add($"Ungefär {task.EstimatedMinutes} minuter.");
        }

        if (TaskSteps.Parse(task.Description) is { } steps)
        {
            parts.AddRange(steps.Select((step, index) => $"Steg {index + 1}: {step}."));
        }
        else if (!string.IsNullOrWhiteSpace(task.Description))
        {
            parts.Add(task.Description);
        }

        return string.Join(" ", parts);
    }

    /// <summary>The signed-in member's own normal budget for today's weekday
    /// (HouseholdMember.WeeklyTimeBudget, unaffected by any earlier "Hur är orken idag?" choice -
    /// that only ever changes today's AVAILABLE minutes, never this) - null before _household has
    /// loaded or if the member is somehow missing from its own roster.</summary>
    private int? NormalMinutesToday
    {
        get
        {
            if (Session.Me?.MemberId is not { } memberId
                || _household?.Members.FirstOrDefault(m => m.Id == memberId) is not { } member)
            {
                return null;
            }

            return Today.DayOfWeek switch
            {
                DayOfWeek.Monday => member.WeeklyTimeBudgetMinutes.Monday,
                DayOfWeek.Tuesday => member.WeeklyTimeBudgetMinutes.Tuesday,
                DayOfWeek.Wednesday => member.WeeklyTimeBudgetMinutes.Wednesday,
                DayOfWeek.Thursday => member.WeeklyTimeBudgetMinutes.Thursday,
                DayOfWeek.Friday => member.WeeklyTimeBudgetMinutes.Friday,
                DayOfWeek.Saturday => member.WeeklyTimeBudgetMinutes.Saturday,
                DayOfWeek.Sunday => member.WeeklyTimeBudgetMinutes.Sunday,
                _ => 0
            };
        }
    }

    /// <summary>"Hur är orken idag?" never shows for a day the member has no normal time on -
    /// there is nothing to scale a fraction of.</summary>
    private bool ShowEnergyPrompt => NormalMinutesToday is > 0;

    /// <summary>Fixed UI chrome, not a presentation choice - shown regardless of ShowIcons
    /// (unlike a task's own illustration, this is the same three-button row's own icon
    /// regardless of which presentation mode a member has picked, the same way the nav tabs'
    /// icons are never conditional on it either).</summary>
    private static string EnergyIconFor(string label) => label switch
    {
        "Lite" => "battery-low",
        "Lagom" => "battery-medium",
        _ => "battery-full",
    };

    /// <summary>Always sets AVAILABLE minutes for today only (SetAvailabilityAsync) - never the
    /// weekly budget itself (SetWeeklyBudgetAsync is not called anywhere in this method or
    /// anything it calls) - PRODUCT.md §5: less time today must never disturb the norm. "Lagom"
    /// (multiplier 1.0) still goes through this same call, which is what lets it explicitly
    /// restore the normal value after an earlier "Lite" chosen the same day, rather than needing
    /// its own special case.</summary>
    private async Task SetEnergyAsync((string Label, double Multiplier) level)
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId }
            || NormalMinutesToday is not { } normalMinutes)
        {
            return;
        }

        _energyBusy = true;
        _energyMessage = null;

        try
        {
            var minutes = EnergyLevel.MinutesFor(normalMinutes, level.Multiplier);

            if (!await Api.SetAvailabilityAsync(householdId, memberId, Today, minutes))
            {
                _energyChoice = null;
                _energyMessage = "Kunde inte spara. Försök igen.";
                return;
            }

            await EnergyChoice.SetAsync(JS, Today, level.Label);
            _energyChoice = level.Label;
            _energyExpanded = false;
            await LoadDayAsync();
        }
        catch (HttpRequestException)
        {
            _energyChoice = null;
            _energyMessage = "Kunde inte spara. Försök igen.";
        }
        finally
        {
            _energyBusy = false;
        }
    }

    /// <summary>"Börja här" (list view only): a quiet pointer at the planner's own first task,
    /// for someone who does not know where to start - not shown when there is only one task
    /// anyway (nothing to choose between), in focus mode (the card itself already IS that
    /// pointer), or while a task is already started (see ToggleStartAsync - a second "start
    /// here" pointer next to an actual "Pågår" row would be a contradiction). Reuses FocusOrder
    /// rather than re-deriving "first in the planner's order" a second time.</summary>
    private Guid? StartHereOccurrenceId
        => !IsFocusMode && _startedOccurrenceId is null && _day is { Items.Count: > 1 }
            ? FocusOrder.FirstOrDefault()?.OccurrenceId
            : null;

    /// <summary>"Jag börjar nu" (Sju enkla lösningar, del 2) - a plain per-device toggle, no
    /// server call and nothing to fail: starting or un-starting is instant, one occurrence at a
    /// time (setting a new one silently replaces whatever was started before).</summary>
    private async Task ToggleStartAsync(Guid occurrenceId)
    {
        if (_startedOccurrenceId == occurrenceId)
        {
            await StartedTask.ClearAsync(JS);
            _startedOccurrenceId = null;
        }
        else
        {
            await StartedTask.SetAsync(JS, Today, occurrenceId);
            _startedOccurrenceId = occurrenceId;
        }
    }

    /// <summary>Display-only reordering (never touches _day, FocusOrder or the server): the
    /// started row, if it is part of this particular group, moves to the front of it - "raden
    /// flyttas överst i sitt rum" applied uniformly to "Sedan tidigare" and every room group,
    /// each its own "rum" for this purpose.</summary>
    private List<TaskRow> WithStartedFirst(IEnumerable<TaskRow> rows)
    {
        var list = rows.ToList();

        if (_startedOccurrenceId is not { } startedId)
        {
            return list;
        }

        var index = list.FindIndex(row => row.Item.OccurrenceId == startedId);
        if (index <= 0)
        {
            return list;
        }

        var started = list[index];
        list.RemoveAt(index);
        list.Insert(0, started);
        return list;
    }

    /// <summary>"Lugn" (Installningar.razor) - one of these five, chosen by state alone, never
    /// randomly: the same day-counts state always reads the same phrase, so it never seems to
    /// change for no reason on a later visit. See docs/DESIGN.md §5 for the "Tillåtet" list
    /// these are drawn from - no idioms, no comparisons between members, no guilt.
    /// EncouragementPhrases[0] is never actually rendered by EncouragementFor (see its own
    /// remarks) - kept in the array anyway so the five phrases and the five branches below stay
    /// visibly paired, one for one.</summary>
    private static readonly string[] EncouragementPhrases =
    [
        "Dagens uppgifter är klara.",
        "Det viktigaste är gjort.",
        "Vill du fortsätta där du slutade?",
        "En sak i taget räcker.",
        "Här är dina uppgifter för idag."
    ];

    /// <summary>
    /// <c>null</c> when everything is done (outstanding == 0 &amp;&amp; completed > 0) - .calm-
    /// state's own heading already says "Dagens uppgifter är klara." (EncouragementPhrases[0])
    /// for that exact state, and a phrase said twice on the same screen is worse than said once
    /// (docs/DESIGN.md §5). Every other branch returns a phrase - callers only need to check for
    /// <c>null</c>, never compare against a specific string to decide whether to render it.
    /// <paramref name="hasStarted"/> (Sju enkla lösningar, del 2 - "Jag börjar nu") reads the
    /// same "Vill du fortsätta där du slutade?" as already completing something does, since both
    /// describe the same situation - work already under way - and does so ahead of the "En sak i
    /// taget räcker."/default branches, exactly where <c>completed > 0</c> already sat.
    /// </summary>
    private static string? EncouragementFor(int outstanding, int completed, int total, bool hasStarted)
    {
        if (outstanding == 0 && completed > 0)
        {
            return null;
        }

        if (completed * 2 >= total && outstanding > 0)
        {
            return EncouragementPhrases[1];
        }

        if (completed > 0 || hasStarted)
        {
            return EncouragementPhrases[2];
        }

        if (outstanding > 4)
        {
            return EncouragementPhrases[3];
        }

        return EncouragementPhrases[4];
    }

    private static string IconSrc(string taskName, string? areaName) => $"icons/tasks/{TaskIcons.For(taskName, areaName)}.svg";

    /// <summary>A room/status heading with a trailing count - "N kvar" for outstanding work,
    /// just the number for "Klart idag" (nothing left to do there).</summary>
    private static RenderFragment GroupHeading(string name, int count, bool showKvar = true) => @<div class="task-group-heading">
        <span>@name</span>
        <span>@(showKvar ? $"{count} kvar" : count.ToString())</span>
    </div>;

    /// <summary>A row a remote reconciliation marked done (see ReconcileRemoteChangeAsync) -
    /// stays exactly where the outstanding row was, dimmed with a filled check like "Klart
    /// idag"'s own rows, but not a TaskListItem: it is no longer interactive (no swipe, no
    /// expand, nothing left to defer), same as any other completed row.</summary>
    /// <summary>One row in the print-only view (see the "Skriv ut" block above) - name plus
    /// steps/description if there is one, no chips or metadata a printed page has no use for.</summary>
    private static RenderFragment PrintTaskRow(PlannedTaskResponse item) => @<li class="print-task">
        @item.Name
        @if (TaskSteps.Parse(item.Description) is { } steps)
        {
            <ol class="task-steps">
                @foreach (var step in steps)
                {
                    <li>@step</li>
                }
            </ol>
        }
        else if (!string.IsNullOrWhiteSpace(item.Description))
        {
            <p>@item.Description</p>
        }
    </li>;

    private static RenderFragment RemotelyCompletedRow(PlannedTaskResponse item) => @<li class="task task-done-remote">
        <span class="task-check task-check-done" aria-hidden="true">
            <Icon Name="check" Size="18" />
        </span>
        <span class="task-name">Klar: @item.Name</span>
    </li>;

    /// <summary>Shown directly under the header (or under .focus-card in focus mode) for 8s
    /// after a completion - see ShowUndo. min-height on .undo-bar itself (not a wrapper reserved
    /// regardless of _undo) keeps the row's OWN height stable once it does appear, so it settles
    /// in one clean shift rather than the button/text loading in separately.</summary>
    private RenderFragment UndoBar => @<div class="undo-bar" role="status">
        <span>Klar: @_undo!.Value.Name</span>
        <button type="button" class="btn btn-link" disabled="@_undoBusy" @onclick="UndoAsync">Ångra</button>
    </div>;

    private RenderFragment CalmState => @<div class="calm-state">
        @if (_day is { Items.Count: 0, Completed.Count: > 0 })
        {
            <h2>Dagens uppgifter är klara.</h2>
        }
        else
        {
            <h2>Ledigt idag</h2>
            @if (_nextPlanned is { } next)
            {
                <p class="muted">Nästa: @next.Date.ToString("dddd", SwedishCulture), @next.Count uppgifter</p>
            }
        }
    </div>;

    /// <summary>The free-text path in "Extra uppgift" - a genuinely new, one-off task. Shared
    /// between the "Eller skriv en ny uppgift" disclosure (when there are existing tasks to
    /// pick from instead) and the plain top-level form (when there are none to pick from).</summary>
    private RenderFragment NewExtraTaskForm => @<EditForm Model="_extraForm" OnValidSubmit="AddExtraTaskAsync">
        <label class="field">
            <span>Namn</span>
            <InputText @bind-Value="_extraForm.Name" placeholder="Till exempel Rensa garderoben" />
        </label>

        <div class="field">
            <span>Ungefär hur mycket tid tar det?</span>
            <div class="level-picker">
                @foreach (var level in TimeLevel.All)
                {
                    <button type="button"
                            class="@(_extraForm.EstimatedMinutes == level.Minutes ? "btn btn-primary" : "btn btn-secondary")"
                            @onclick="() => _extraForm.EstimatedMinutes = level.Minutes">
                        <span>@level.Label</span>
                        @if (level.Minutes > 0)
                        {
                            <span class="muted small">@TimeLevel.MinutesLabel(level.Minutes)</span>
                        }
                    </button>
                }
            </div>
        </div>

        @if (_household?.Areas.Where(area => area.IsActive).ToList() is { Count: > 0 } activeAreas)
        {
            <label class="field">
                <span>Vilket rum?</span>
                <select @bind="_extraForm.AreaId">
                    <option value="">Övrigt</option>
                    @foreach (var area in activeAreas)
