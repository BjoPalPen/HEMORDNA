@inherits LayoutComponentBase
@using Hemordna.Client.Support
@using Microsoft.AspNetCore.Components.Routing
@inject HemordnaSession Session
@inject HemordnaApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <NavMenu />

    <div class="app-topfade" aria-hidden="true"></div>

    <main class="app-main">
        @Body
    </main>

    <div class="app-botfade" aria-hidden="true"></div>
</div>

@code {
    private Guid? _textSizeAppliedForMember;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Navigation.LocationChanged += OnLocationChanged;

        await Session.EnsureLoadedAsync();
        await ApplyTextSizeAsync();
    }

    /// <summary>
    /// A route change never reloads the page, so the browser never runs its own scroll reset -
    /// without this, a scrolled-down position from wherever the member was before would survive
    /// straight into the new page (see docs/ARCHITECTURE.md "Uppdrag: fokuskortet" - the
    /// duplicated-header bug this fixes).
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(ScrollState.ResetAsync);

    /// <summary>
    /// The scroll listener behind NavMenu.razor.css's compact pill and MinDag/Hushall's
    /// collapsed header row (docs/ARCHITECTURE.md "Beslut: Ny form 2026" §3) - attached once
    /// here, since MainLayout itself never re-renders across page navigations, rather than once
    /// per page that wants to react to <c>data-scrolled</c>.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollState.AttachAsync(JS);
        }
    }

    private void OnSessionChanged() => InvokeAsync(async () =>
    {
        await ApplyTextSizeAsync();
        StateHasChanged();
    });

    /// <summary>
    /// "Stor text" (docs/DESIGN.md §7) scales the whole app's base font size via a
    /// <c>data-text-size</c> attribute on <c>&lt;html&gt;</c> (see app.css), so it has to be set
    /// here in the layout every page renders inside - not per-page - and applied once per signed
    /// -in member rather than on every session change, since Session.Changed fires more often
    /// than the preference itself does.
    /// </summary>
    private async Task ApplyTextSizeAsync()
    {
        if (Session.Me is not { HouseholdId: { } householdId, MemberId: { } memberId }
            || _textSizeAppliedForMember == memberId)
        {
            return;
        }

        _textSizeAppliedForMember = memberId;

        var preference = await Api.GetPreferenceAsync(householdId, memberId);
        await TextSize.ApplyAsync(JS, PresentationModes.IsLargeText(preference?.Presentation));
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
