@inject HemordnaSession Session

<nav class="nav-shell" aria-label="Huvudmeny">
    <div class="brand">
        <img src="brand/logo.png" alt="" class="brand-mark" width="40" height="40" />
        <span class="brand-text">
            <span class="brand-name">Hemordna</span>
            <span class="brand-tagline">Ett enklare hem, en lugnare vardag</span>
        </span>
    </div>

    <ul class="nav-items">
        @foreach (var item in Items)
        {
            <li>
                <NavLink class="nav-link" href="@item.Href" Match="@item.Match">
                    <Icon Name="@item.Icon" />
                    <span class="nav-label">@item.Label</span>
                </NavLink>
            </li>
        }
    </ul>

    @if (Session.Me is { } me)
    {
        <div class="nav-user">
            <span class="avatar" aria-hidden="true">@Initial(me.DisplayName)</span>
            <span class="nav-user-text">
                <span class="nav-user-name">@me.DisplayName</span>
            </span>
        </div>
    }
</nav>

@code {
    private sealed record NavItem(string Href, string Label, string Icon, NavLinkMatch Match);

    /// <summary>Same four destinations, same order, on mobile and desktop - see docs/DESIGN.md
    /// §8. Inställningar and Logga ut live under Hushåll instead of their own tabs.</summary>
    private static readonly NavItem[] Items =
    [
        new("", "Idag", "sun", NavLinkMatch.All),
        new("rum", "Rum", "grid", NavLinkMatch.Prefix),
        new("vecka", "Vecka", "calendar", NavLinkMatch.Prefix),
        new("hushall", "Hushåll", "people", NavLinkMatch.Prefix)
    ];

    private static string Initial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();
}
